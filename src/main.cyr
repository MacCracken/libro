# libro — cryptographic audit chain
# Tamper-proof SHA-256 hash-linked event logging and verification.
# Ported from 8513 lines of Rust to Cyrius.

# ================================================================
# Standard library includes
# ================================================================
# assert.cyr brings string.cyr + fmt.cyr — do not re-include them
include "lib/assert.cyr"
include "lib/alloc.cyr"
include "lib/freelist.cyr"
include "lib/str.cyr"
include "lib/string.cyr"
include "lib/vec.cyr"
include "lib/hashmap.cyr"
include "lib/syscalls.cyr"
include "lib/io.cyr"
include "lib/fs.cyr"
include "lib/fmt.cyr"
include "lib/json.cyr"
include "lib/sakshi.cyr"
include "lib/chrono.cyr"
include "lib/bigint.cyr"
include "lib/tagged.cyr"
include "lib/process.cyr"
include "lib/ct.cyr"
include "lib/keccak.cyr"
include "lib/thread.cyr"
# thread_local.cyr (cyrius >= 6.0.52) must precede sigil — sigil 3.6.0's
# crypto_scratch banks per-thread crypto working arrays over TLS and
# calls thread_local_init/get/set. Without it sigil links but SIGILLs at
# runtime. Requires syscalls + alloc (included above).
include "lib/thread_local.cyr"
include "lib/slice.cyr"
include "lib/agnosys.cyr"
include "lib/random.cyr"

# ================================================================
# Patra — SQL-backed storage backend (persistent audit log)
# ================================================================
include "lib/patra.cyr"

# ================================================================
# Sigil — crypto primitives (SHA-256, Ed25519, HMAC, hex, ct)
# ================================================================
include "lib/sigil.cyr"

# ================================================================
# Libro modules (dependency order)
# ================================================================
include "src/error.cyr"
include "src/hasher.cyr"
include "src/entry.cyr"
include "src/verify.cyr"
include "src/query.cyr"
include "src/retention.cyr"
include "src/chain.cyr"
include "src/store.cyr"
include "src/export.cyr"
include "src/review.cyr"
include "src/merkle.cyr"
include "src/signing.cyr"
include "src/anchoring.cyr"
include "src/timestamping.cyr"
include "src/proof.cyr"
include "src/kernel_audit.cyr"
include "src/file_store.cyr"
include "src/chain_io.cyr"
include "src/patra_store.cyr"
include "src/streaming.cyr"
include "src/proof_json.cyr"

# ================================================================
# TPM-sealed anchors (2.5.0) — opt-in via -D LIBRO_TPM=1
# ================================================================
# Default builds skip this entirely. The tpm_anchor module pulls
# agnosys's tpm_seal/tpm_unseal primitives which shell out to
# tpm2-tools; consumers without a TPM (or running rootless / in
# containers) don't pay any binary-size or runtime cost when the
# define is off.
#ifdef LIBRO_TPM
include "src/tpm_anchor.cyr"
#endif

# ================================================================
# Tests
# ================================================================

fn test_sha256_empty() {
    var digest = alloc(32);
    sha256("", 0, digest);
    var hex = hex_encode_str(digest, 32);
    var expected = str_from("e3b0c44298fc1c149afbf4c8996fb92427ae41e4649b934ca495991b7852b855");
    assert(str_eq(hex, expected) == 1, "sha256 empty string");
}

fn test_sha256_abc() {
    var digest = alloc(32);
    sha256("abc", 3, digest);
    var hex = hex_encode_str(digest, 32);
    var expected = str_from("ba7816bf8f01cfea414140de5dae2223b00361a396177a9cb410ff61f20015ad");
    assert(str_eq(hex, expected) == 1, "sha256 abc");
}

fn test_sha256_448bit() {
    var msg = "abcdbcdecdefdefgefghfghighijhijkijkljklmklmnlmnomnopnopq";
    var digest = alloc(32);
    sha256(msg, 56, digest);
    var hex = hex_encode_str(digest, 32);
    var expected = str_from("248d6a61d20638b8e5c026930c3e6039a33ce45964ff2167f6ecedd419db06c1");
    assert(str_eq(hex, expected) == 1, "sha256 448-bit NIST");
}

fn test_sha256_multiblock() {
    # NIST 896-bit (112-byte) test vector, built from two halves —
    # Cyrius has no string-literal concatenation, so str_builder it is.
    var sb = str_builder_new();
    str_builder_add_cstr(sb, "abcdefghbcdefghicdefghijdefghijkefghijklfghijklmghijklmnhijklmno");
    str_builder_add_cstr(sb, "ijklmnopjklmnopqklmnopqrlmnopqrsmnopqrstnopqrstu");
    var msg = str_builder_build(sb);
    var digest = alloc(32);
    sha256(str_data(msg), 112, digest);
    var hex = hex_encode_str(digest, 32);
    var expected = str_from("cf5b16a778af8380036ce59e7b0492370b249b11e8f07a51afac45037afee9d1");
    assert(str_eq(hex, expected) == 1, "sha256 896-bit NIST");
}

fn test_sha256_incremental() {
    # Hash "abc" incrementally: "a" then "bc"
    var ctx = sha256_init();
    sha256_update(ctx, "a", 1);
    sha256_update(ctx, "bc", 2);
    var digest = alloc(32);
    sha256_finalize(ctx, digest);
    var hex = hex_encode_str(digest, 32);
    var expected = str_from("ba7816bf8f01cfea414140de5dae2223b00361a396177a9cb410ff61f20015ad");
    assert(str_eq(hex, expected) == 1, "sha256 incremental");
    fl_free(ctx);
}

fn test_hex_roundtrip() {
    var data = alloc(4);
    store8(data, 0xDE);
    store8(data + 1, 0xAD);
    store8(data + 2, 0xBE);
    store8(data + 3, 0xEF);
    var hex = hex_encode_str(data, 4);
    assert(str_eq(hex, str_from("deadbeef")) == 1, "hex encode");

    var decoded = hex_decode_str(hex);
    assert((load8(decoded) & 0xFF) == 0xDE, "hex decode byte 0");
    assert((load8(decoded + 1) & 0xFF) == 0xAD, "hex decode byte 1");
    assert((load8(decoded + 2) & 0xFF) == 0xBE, "hex decode byte 2");
    assert((load8(decoded + 3) & 0xFF) == 0xEF, "hex decode byte 3");
}

fn test_hex_encode_zeros() {
    var data = alloc(2);
    store8(data, 0x00);
    store8(data + 1, 0x0F);
    var hex = hex_encode_str(data, 2);
    assert(str_eq(hex, str_from("000f")) == 1, "hex encode zeros");
}

fn test_ct_eq() {
    assert(ct_eq_bytes_lens("abc", 3, "abc", 3) == 1, "ct_eq equal");
    assert(ct_eq_bytes_lens("abc", 3, "abd", 3) == 0, "ct_eq differ");
    assert(ct_eq_bytes_lens("abc", 3, "ab", 2) == 0, "ct_eq length mismatch");
    assert(ct_eq_bytes_lens("", 0, "", 0) == 1, "ct_eq empty");
}

fn test_constant_time_eq_str() {
    var a = str_from("hello");
    var b = str_from("hello");
    var c = str_from("world");
    assert(constant_time_eq_str(a, b) == 1, "ct_eq_str equal");
    assert(constant_time_eq_str(a, c) == 0, "ct_eq_str differ");
}

fn test_severity() {
    assert_streq(severity_as_str(SEV_DEBUG), "Debug", "severity Debug");
    assert_streq(severity_as_str(SEV_INFO), "Info", "severity Info");
    assert_streq(severity_as_str(SEV_WARNING), "Warning", "severity Warning");
    assert_streq(severity_as_str(SEV_ERROR), "Error", "severity Error");
    assert_streq(severity_as_str(SEV_CRITICAL), "Critical", "severity Critical");
    assert_streq(severity_as_str(SEV_SECURITY), "Security", "severity Security");
    assert(severity_at_or_above(SEV_ERROR, SEV_WARNING) == 1, "severity at_or_above true");
    assert(severity_at_or_above(SEV_DEBUG, SEV_INFO) == 0, "severity at_or_above false");
}

fn test_error_new() {
    var e = error_new(ERR_IO, "disk full");
    assert(error_code(e) == ERR_IO, "error code");
    assert_streq(error_msg(e), "disk full", "error msg");
    fl_free(e);
}

fn test_error_integrity() {
    var expected = str_from("aaa");
    var actual = str_from("bbb");
    var e = error_integrity(5, expected, actual);
    assert(error_code(e) == ERR_INTEGRITY, "integrity error code");
    assert(error_index(e) == 5, "integrity error index");
    fl_free(e);
}

fn test_timestamp() {
    var ts = timestamp_rfc3339(0);
    # Epoch 0 = 1970-01-01T00:00:00Z
    assert(str_eq(ts, str_from("1970-01-01T00:00:00Z")) == 1, "timestamp epoch 0");

    # 2024-01-01T00:00:00Z = 1704067200
    var ts2 = timestamp_rfc3339(1704067200);
    assert(str_eq(ts2, str_from("2024-01-01T00:00:00Z")) == 1, "timestamp 2024");
}

fn test_uuid_v4() {
    var buf = alloc(16);
    uuid_v4(buf);
    # Version nibble should be 4
    var b6 = load8(buf + 6) & 0xFF;
    assert(((b6 >> 4) & 0xF) == 4, "uuid v4 version");
    # Variant should be 10xx
    var b8 = load8(buf + 8) & 0xFF;
    assert(((b8 >> 6) & 0x3) == 2, "uuid v4 variant");
}

fn test_entry_create() {
    var src = str_from("test-source");
    var act = str_from("test-action");
    var det = str_from("{}");
    var prev = str_from("");
    var e = entry_new(SEV_INFO, src, act, det, prev);

    assert_nonnull(e, "entry created");
    assert(entry_severity(e) == SEV_INFO, "entry severity");
    assert(str_eq(entry_source(e), src) == 1, "entry source");
    assert(str_eq(entry_action(e), act) == 1, "entry action");
    assert(str_len(entry_hash(e)) == 64, "entry hash length");
    assert(str_len(entry_timestamp(e)) == 20, "entry timestamp length");
}

fn test_entry_verify() {
    var src = str_from("audit");
    var act = str_from("login");
    var det = str_from("{}");
    var prev = str_from("");
    var e = entry_new(SEV_INFO, src, act, det, prev);

    assert(entry_verify(e) == 1, "entry verify valid");
}

fn test_entry_tamper() {
    var src = str_from("audit");
    var act = str_from("login");
    var det = str_from("{}");
    var prev = str_from("");
    var e = entry_new(SEV_INFO, src, act, det, prev);

    # Tamper with severity
    store64(e + 24, SEV_CRITICAL);
    assert(entry_verify(e) == 0, "entry verify tampered");
}

fn test_entry_with_agent() {
    var src = str_from("monitor");
    var act = str_from("check");
    var det = str_from("{}");
    var prev = str_from("");
    var e = entry_new(SEV_DEBUG, src, act, det, prev);
    var hash_before = entry_hash(e);

    var agent = str_from("agent-007");
    entry_with_agent(e, agent);
    var hash_after = entry_hash(e);

    # Hash should change when agent_id is set
    assert(str_eq(hash_before, hash_after) == 0, "entry hash changes with agent");
    assert(entry_verify(e) == 1, "entry verify after agent");
}

fn test_chain_valid() {
    var entries = vec_new();
    var det = str_from("{}");

    var e1 = entry_new(SEV_INFO, str_from("src"), str_from("act1"), det, str_from(""));
    vec_push(entries, e1);

    var e2 = entry_new(SEV_WARNING, str_from("src"), str_from("act2"), det, entry_hash(e1));
    vec_push(entries, e2);

    var e3 = entry_new(SEV_ERROR, str_from("src"), str_from("act3"), det, entry_hash(e2));
    vec_push(entries, e3);

    var result = verify_chain(entries, 0);
    assert(result == 0, "chain verify valid");
}

fn test_chain_tampered_hash() {
    var entries = vec_new();
    var det = str_from("{}");

    var e1 = entry_new(SEV_INFO, str_from("src"), str_from("act1"), det, str_from(""));
    vec_push(entries, e1);

    var e2 = entry_new(SEV_INFO, str_from("src"), str_from("act2"), det, entry_hash(e1));
    vec_push(entries, e2);

    # Tamper with e1's action
    store64(e1 + 40, str_from("tampered"));
    var result = verify_chain(entries, 0);
    assert(result != 0, "chain detects tampered entry");
    assert(error_code(result) == ERR_INTEGRITY, "chain error is integrity");
}

fn test_chain_broken_link() {
    var entries = vec_new();
    var det = str_from("{}");

    var e1 = entry_new(SEV_INFO, str_from("src"), str_from("act1"), det, str_from(""));
    vec_push(entries, e1);

    # e2 points to a fake prev_hash — 64 ASCII zeros, built at runtime
    # since Cyrius can't split a literal across lines.
    var zh = str_builder_new();
    str_builder_add_cstr(zh, "00000000000000000000000000000000");
    str_builder_add_cstr(zh, "00000000000000000000000000000000");
    var fake_prev = str_builder_build(zh);
    var e2 = entry_new(SEV_INFO, str_from("src"), str_from("act2"), det, fake_prev);
    vec_push(entries, e2);

    var result = verify_chain(entries, 0);
    assert(result != 0, "chain detects broken link");
    assert(error_code(result) == ERR_INTEGRITY, "broken link error is integrity");
}

fn test_chain_empty() {
    var entries = vec_new();
    var result = verify_chain(entries, 0);
    assert(result == 0, "empty chain is valid");
}

fn test_chain_single() {
    var entries = vec_new();
    var e = entry_new(SEV_INFO, str_from("src"), str_from("act"), str_from("{}"), str_from(""));
    vec_push(entries, e);
    var result = verify_chain(entries, 0);
