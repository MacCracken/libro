fn test_signing_zeroize() {
    var sk = signing_key_generate();
    var key_ptr = signing_key_bytes(sk);
    signing_key_zeroize(sk);
    # Check first byte is zero after zeroize
    assert((load8(key_ptr) & 0xFF) == 0, "key zeroized");
}

# ================================================================
# ML-DSA-65 (NIST FIPS 204) — post-quantum signing battery.
# Mirrors the Ed25519 tests above: keygen + sign + verify roundtrip,
# tamper rejection, key_id, zeroize. Plus a few PQ-specific shape
# checks (signature byte count, algorithm-string round-trip,
# cross-algorithm vk rejection).
# ================================================================

fn test_signing_mldsa_roundtrip() {
    var sk = signing_key_generate_mldsa();
    assert(sk != 0, "mldsa signing key generated");
    assert(signing_key_algorithm(sk) == SIG_ALG_ML_DSA_65, "sk algorithm = ML-DSA-65");

    var c = chain_new();
    chain_append(c, SEV_INFO, str_from("s"), str_from("a"), str_from("{}"));
    var e = vec_get(chain_entries(c), 0);

    var sig = sign_entry(sk, e);
    assert(sig != 0, "mldsa entry signed");
    # ML-DSA-65 signature: 3309 bytes × 2 hex = 6618 chars.
    assert(str_len(entry_sig_signature(sig)) == 6618, "mldsa signature is 6618-char hex");
    # Algorithm string round-trips as sigil's canonical name.
    assert(str_eq(entry_sig_algorithm(sig), str_from("ML-DSA-65")) == 1,
      "entry_sig.algorithm carries ML-DSA-65 string");

    var vk = verifying_key_from_signing(sk);
    assert(verifying_key_algorithm(vk) == SIG_ALG_ML_DSA_65, "vk algorithm = ML-DSA-65");
    assert(verify_entry_signature(vk, e, sig) == 1, "mldsa signature verifies");
}

fn test_signing_mldsa_tamper_rejected() {
    var sk = signing_key_generate_mldsa();
    var c = chain_new();
    chain_append(c, SEV_INFO, str_from("s"), str_from("a"), str_from("{}"));
    var e = vec_get(chain_entries(c), 0);
    var sig = sign_entry(sk, e);

    # Different ML-DSA key → verify must fail.
    var sk2 = signing_key_generate_mldsa();
    var vk2 = verifying_key_from_signing(sk2);
    assert(verify_entry_signature(vk2, e, sig) == 0, "mldsa: tampered key rejected");
}

fn test_signing_mldsa_key_id() {
    var sk = signing_key_generate_mldsa();
    signing_key_set_key_id(sk, str_from("pq-key-v1"));

    var c = chain_new();
    chain_append(c, SEV_INFO, str_from("s"), str_from("a"), str_from("{}"));
    var e = vec_get(chain_entries(c), 0);

    var sig = sign_entry_with_key_id(sk, e, str_from("rotation-pq-1"));
    assert(entry_sig_key_id(sig) != 0, "mldsa sig has key_id");
}

fn test_signing_mldsa_zeroize() {
    var sk = signing_key_generate_mldsa();
    var key_ptr = signing_key_bytes(sk);
    signing_key_zeroize(sk);
    # Spot-check: first byte of the 4032-byte sk buffer is zero.
    assert((load8(key_ptr) & 0xFF) == 0, "mldsa sk first byte zeroized");
    # Also check a byte deep into the buffer (offset 2000 — well past
    # where the Ed25519-sized memset would have stopped). Pins the
    # alg-aware sk_size dispatch.
    assert((load8(key_ptr + 2000) & 0xFF) == 0, "mldsa sk byte +2000 zeroized");
}

# ================================================================
# Hybrid signing (Ed25519 + ML-DSA-65) — sigil 3.0's
# `sigil_verify_hybrid` AND-mode. The signing_key carries both
# secret-key buffers; entry_sig carries both hex signatures and
# both hex verifying keys; verify must validate under both
# primitives.
# ================================================================

fn test_signing_hybrid_roundtrip() {
    var sk = signing_key_generate_hybrid();
    assert(sk != 0, "hybrid signing key generated");
    assert(signing_key_algorithm(sk) == SIG_ALG_HYBRID, "sk algorithm = HYBRID");
    # Both slots populated.
    assert(signing_key_bytes(sk)     != 0, "hybrid sk slot-1 (Ed25519) populated");
    assert(signing_key_bytes_2(sk)   != 0, "hybrid sk slot-2 (ML-DSA-65) populated");
    assert(signing_key_pub_bytes(sk) != 0, "hybrid pk slot-1 populated");
    assert(signing_key_pub_bytes_2(sk) != 0, "hybrid pk slot-2 populated");

    var c = chain_new();
    chain_append(c, SEV_INFO, str_from("s"), str_from("a"), str_from("{}"));
    var e = vec_get(chain_entries(c), 0);

    var sig = sign_entry(sk, e);
    assert(sig != 0, "hybrid entry signed");
    # Both signature slots populated.
    assert(str_len(entry_sig_signature(sig))   == 128,  "hybrid sig slot-1 (Ed25519) is 128-char hex");
    assert(str_len(entry_sig_signature_2(sig)) == 6618, "hybrid sig slot-2 (ML-DSA-65) is 6618-char hex");
    assert(str_eq(entry_sig_algorithm(sig), str_from("Hybrid(Ed25519+ML-DSA-65)")) == 1,
      "entry_sig.algorithm carries hybrid name");

    var vk = verifying_key_from_signing(sk);
    assert(verifying_key_algorithm(vk) == SIG_ALG_HYBRID, "vk algorithm = HYBRID");
    assert(verifying_key_bytes(vk)   != 0, "hybrid vk slot-1 populated");
    assert(verifying_key_bytes_2(vk) != 0, "hybrid vk slot-2 populated");
    assert(verify_entry_signature(vk, e, sig) == 1, "hybrid signature verifies (AND mode)");
}

fn test_signing_hybrid_tamper_rejected_either_side() {
    var sk = signing_key_generate_hybrid();
    var c = chain_new();
    chain_append(c, SEV_INFO, str_from("s"), str_from("a"), str_from("{}"));
    var e = vec_get(chain_entries(c), 0);
    var sig = sign_entry(sk, e);

    # Tamper with the Ed25519 portion only — hybrid AND-verify must still fail.
    # Replace signature slot-1 with another valid Ed25519 sig over a different message
    # by signing with a fresh ed-only key (the bytes will be a syntactically valid
    # Ed25519 sig but won't validate over our hash + ed pk).
    var sk_other = signing_key_generate();
    var c2 = chain_new();
    chain_append(c2, SEV_INFO, str_from("OTHER"), str_from("a"), str_from("{}"));
    var e2 = vec_get(chain_entries(c2), 0);
    var sig_other = sign_entry(sk_other, e2);
    var sig_tampered_ed = entry_sig_new_hybrid(
      entry_sig_hash(sig),
      entry_sig_signature(sig_other),       # bad ed sig (over wrong msg)
      entry_sig_verifying_key(sig),
      entry_sig_key_id(sig),
      entry_sig_algorithm(sig),
      entry_sig_signature_2(sig),
      entry_sig_verifying_key_2(sig));
    var vk = verifying_key_from_signing(sk);
    assert(verify_entry_signature(vk, e, sig_tampered_ed) == 0, "hybrid: tampered Ed25519 portion rejected");

    # Tamper with the ML-DSA-65 portion only — hybrid AND-verify must still fail.
    # We don't have a "wrong" ML-DSA sig handy; substitute an empty Str so
    # hex_decode_str returns 0 and the verify path bails.
    var sig_tampered_pq = entry_sig_new_hybrid(
      entry_sig_hash(sig),
      entry_sig_signature(sig),
      entry_sig_verifying_key(sig),
      entry_sig_key_id(sig),
      entry_sig_algorithm(sig),
      str_from(""),                          # empty pq sig
      entry_sig_verifying_key_2(sig));
    assert(verify_entry_signature(vk, e, sig_tampered_pq) == 0, "hybrid: tampered ML-DSA portion rejected");
}

fn test_signing_hybrid_zeroize() {
    var sk = signing_key_generate_hybrid();
    var ed_key_ptr = signing_key_bytes(sk);
    var pq_key_ptr = signing_key_bytes_2(sk);
    signing_key_zeroize(sk);
    # Slot-1 (Ed25519, 64 bytes).
    assert((load8(ed_key_ptr) & 0xFF)      == 0, "hybrid sk slot-1 first byte zeroized");
    assert((load8(ed_key_ptr + 63) & 0xFF) == 0, "hybrid sk slot-1 last byte zeroized");
    # Slot-2 (ML-DSA-65, 4032 bytes).
    assert((load8(pq_key_ptr) & 0xFF)        == 0, "hybrid sk slot-2 first byte zeroized");
    assert((load8(pq_key_ptr + 2000) & 0xFF) == 0, "hybrid sk slot-2 byte +2000 zeroized");
    assert((load8(pq_key_ptr + 4031) & 0xFF) == 0, "hybrid sk slot-2 last byte zeroized");
}

fn test_signing_hybrid_tree_head_roundtrip() {
    # Hybrid sign_tree_head packs the two hex sigs as `ed_hex|pq_hex`
    # into the single Str field; verify_tree_head splits and dispatches.
    var sk = signing_key_generate_hybrid();
    var vk = verifying_key_from_signing(sk);
    var root = str_from("a3b9c5d7e8f0a1b2c3d4e5f60718293a4b5c6d7e8f9a0b1c2d3e4f5a6b7c8d9e");
    var sig_concat = sign_tree_head(sk, root);
    # Concatenated form: 128 (ed hex) + 1 (pipe) + 6618 (pq hex) = 6747 chars.
    assert(str_len(sig_concat) == 6747, "hybrid tree-head sig is 6747 chars (ed|pq)");
    assert(verify_tree_head(vk, root, sig_concat) == 1, "hybrid tree-head sig verifies");
}

fn test_signing_cross_alg_rejected() {
    # An Ed25519 signature shouldn't verify against an ML-DSA vk and
    # vice versa. The algorithm dispatch in verify_entry_signature
    # uses the vk's algorithm to pick the primitive; mismatched
    # signature bytes will fail to decode + reject cleanly.
    var sk_ed = signing_key_generate();
    var sk_pq = signing_key_generate_mldsa();
    var c = chain_new();
    chain_append(c, SEV_INFO, str_from("s"), str_from("a"), str_from("{}"));
    var e = vec_get(chain_entries(c), 0);

    var sig_ed = sign_entry(sk_ed, e);
    var sig_pq = sign_entry(sk_pq, e);

    var vk_ed = verifying_key_from_signing(sk_ed);
    var vk_pq = verifying_key_from_signing(sk_pq);

    # Sanity: matched pairs verify.
    assert(verify_entry_signature(vk_ed, e, sig_ed) == 1, "ed/ed pair verifies");
    assert(verify_entry_signature(vk_pq, e, sig_pq) == 1, "pq/pq pair verifies");

    # Cross-pairs reject. The vk dispatches to its primitive and the
    # signature bytes (different size + format) fail to validate.
    assert(verify_entry_signature(vk_pq, e, sig_ed) == 0, "ed sig rejected by pq vk");
    assert(verify_entry_signature(vk_ed, e, sig_pq) == 0, "pq sig rejected by ed vk");
}

fn test_anchor_create() {
    var c = chain_new();
    var det = str_from("{}");
    chain_append(c, SEV_INFO, str_from("s"), str_from("a"), det);
    chain_append(c, SEV_INFO, str_from("s"), str_from("a"), det);

    var tree = merkle_build(chain_entries(c));
    var a = anchor_new(tree, c);
    assert(a != 0, "anchor created");
    assert(str_len(anchor_hash(a)) == 64, "anchor hash is 64-char hex");
    assert(anchor_entry_count(a) == 2, "anchor entry count");
}

fn test_anchor_verify() {
    var c = chain_new();
    var det = str_from("{}");
    chain_append(c, SEV_INFO, str_from("s"), str_from("a"), det);

    var tree = merkle_build(chain_entries(c));
    var a = anchor_new(tree, c);

    assert(anchor_verify_integrity(a) == 1, "anchor integrity valid");
    assert(anchor_verify_against(a, tree, c) == ANCHOR_VALID, "anchor verify against");
}

fn test_anchor_chaining() {
    var c = chain_new();
    var det = str_from("{}");
    chain_append(c, SEV_INFO, str_from("s"), str_from("a1"), det);

    var tree1 = merkle_build(chain_entries(c));
    var a1 = anchor_new(tree1, c);

    chain_append(c, SEV_INFO, str_from("s"), str_from("a2"), det);
    var tree2 = merkle_build(chain_entries(c));
    var a2 = anchor_new(tree2, c);
    anchor_with_prev(a2, a1);

    assert(anchor_prev_hash(a2) != 0, "anchor has prev_hash");
    assert(anchor_verify_integrity(a2) == 1, "chained anchor integrity valid");
}

fn test_anchor_mismatch() {
    var c = chain_new();
    var det = str_from("{}");
    chain_append(c, SEV_INFO, str_from("s"), str_from("a"), det);
    chain_append(c, SEV_INFO, str_from("s"), str_from("a"), det);

    var tree = merkle_build(chain_entries(c));
    var a = anchor_new(tree, c);

    # Add another entry — tree no longer matches anchor
    chain_append(c, SEV_INFO, str_from("s"), str_from("a"), det);
    var tree2 = merkle_build(chain_entries(c));
    assert(anchor_verify_against_tree(a, tree2) != ANCHOR_VALID, "anchor detects tree change");
}

fn test_ts_request_der() {
    var hash = str_from("ba7816bf8f01cfea414140de5dae2223b00361a396177a9cb410ff61f20015ad");
    var req = ts_request_new(hash);
    var der = ts_request_to_der(req);
    assert(str_len(der) > 0, "DER encoding produces output");
    # DER should start with SEQUENCE tag (0x30)
    assert((load8(str_data(der)) & 0xFF) == 0x30, "DER starts with SEQUENCE");
}

fn test_ts_request_with_nonce() {
    var hash = str_from("ba7816bf8f01cfea414140de5dae2223b00361a396177a9cb410ff61f20015ad");
    var req = ts_request_new(hash);
