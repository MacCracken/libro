fn test_chain_retention() {
    var c = chain_new();
    var det = str_from("{}");
    var i = 0;
    while (i < 5) {
        chain_append(c, SEV_INFO, str_from("s"), str_from("a"), det);
        i = i + 1;
    }

    var policy = retention_keep_count(2);
    var arch = chain_apply_retention(c, policy);
    assert(arch != 0, "retention produced archive");
    assert(chain_len(c) == 2, "retention kept 2");
    assert(vec_len(archive_entries(arch)) == 3, "retention archived 3");
    assert(chain_prev_hash(c) != 0, "retention set prev_chain_hash");
}

