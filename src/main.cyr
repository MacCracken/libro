fn test_retention_keep_count() {
    var det = str_from("{}");
    var entries = vec_new();
    var prev = str_from("");
    var i = 0;
    while (i < 5) {
        var e = entry_new(SEV_INFO, str_from("s"), str_from("a"), det, prev);
        vec_push(entries, e);
        prev = entry_hash(e);
        i += 1;
    }

    var r = retention_keep_count(3);
    var split = retention_split_index(r, entries);
    assert(split == 2, "keep_count(3) splits at 2 for 5 entries");
}

fn test_retention_keep_count_no_split() {
    var det = str_from("{}");
    var entries = vec_new();
    var e = entry_new(SEV_INFO, str_from("s"), str_from("a"), det, str_from(""));
    vec_push(entries, e);

    var r = retention_keep_count(10);
    var split = retention_split_index(r, entries);
    assert(split == 0, "keep_count no split when under limit");
}

fn test_chain_append() {
    var c = chain_new();
    var det = str_from("{}");

    chain_append(c, SEV_INFO, str_from("src"), str_from("act1"), det);
    assert(chain_len(c) == 1, "chain append 1");

    chain_append(c, SEV_WARNING, str_from("src"), str_from("act2"), det);
    assert(chain_len(c) == 2, "chain append 2");

    # Verify chain integrity
    var err = chain_verify(c);
    assert(err == 0, "chain append verify");
}

fn test_chain_append_batch() {
    var c = chain_new();
    var det = str_from("{}");

    # Seed with one entry so the batch starts after a non-empty tail.
    chain_append(c, SEV_INFO, str_from("src"), str_from("seed"), det);

    var sevs = vec_new();
    var srcs = vec_new();
    var acts = vec_new();
    var dets = vec_new();
    var i = 0;
    while (i < 5) {
        vec_push(sevs, SEV_INFO);
        vec_push(srcs, str_from("src"));
        vec_push(acts, str_from("batched"));
        vec_push(dets, det);
        i += 1;
    }

    var out = chain_append_batch(c, sevs, srcs, acts, dets);
    assert(vec_len(out) == 5, "append_batch returned 5 entries");
    assert(chain_len(c) == 6, "chain grew by 5 (seed + batch)");

    # Linkage must be intact end-to-end.
    var err = chain_verify(c);
    assert(err == 0, "append_batch verify");

    # First batched entry must link to seed's hash.
    var seed = vec_get(chain_entries(c), 0);
    var first_batched = vec_get(out, 0);
    assert(str_eq(entry_prev_hash(first_batched), entry_hash(seed)) == 1,
        "batch first entry links to seed");
}

fn test_chain_append_with_agent() {
    var c = chain_new();
    var det = str_from("{}");

    var e = chain_append_with_agent(c, SEV_INFO, str_from("src"), str_from("act"), det, str_from("agent-1"));
    assert(chain_len(c) == 1, "chain append_with_agent len");
    assert(entry_agent_id(e) != 0, "chain append_with_agent has agent");
    assert(entry_verify(e) == 1, "chain append_with_agent verify");
}

fn test_chain_rotate() {
    var c = chain_new();
    var det = str_from("{}");

    chain_append(c, SEV_INFO, str_from("s"), str_from("a1"), det);
    chain_append(c, SEV_INFO, str_from("s"), str_from("a2"), det);
    var head_before = chain_head_hash(c);

    var arch = chain_rotate(c);
    assert(chain_len(c) == 0, "chain empty after rotate");
    assert(vec_len(archive_entries(arch)) == 2, "archive has 2 entries");
    assert(chain_prev_hash(c) != 0, "prev_chain_hash set after rotate");

    # New append should link to rotated chain
    chain_append(c, SEV_INFO, str_from("s"), str_from("a3"), det);
    var first = vec_get(chain_entries(c), 0);
    assert(str_eq(entry_prev_hash(first), head_before) == 1, "new entry links to rotated head");
}

fn test_chain_auto_rotate() {
    var c = chain_with_capacity(3);
    var det = str_from("{}");

    chain_append(c, SEV_INFO, str_from("s"), str_from("a1"), det);
    chain_append(c, SEV_INFO, str_from("s"), str_from("a2"), det);
    chain_append(c, SEV_INFO, str_from("s"), str_from("a3"), det);
    assert(chain_len(c) == 3, "chain at capacity");

    # This append should trigger auto-rotate
    chain_append(c, SEV_INFO, str_from("s"), str_from("a4"), det);
    assert(chain_len(c) == 1, "chain has 1 after auto-rotate");
    assert(vec_len(chain_overflow(c)) == 1, "overflow has 1 archive");
}

