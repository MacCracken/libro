fn test_str_cmp() {
    var a = str_from("alpha");
    var b = str_from("beta");
    assert(_str_cmp(a, b) < 0, "str_cmp alpha < beta");
    assert(_str_cmp(b, a) > 0, "str_cmp beta > alpha");
    assert(_str_cmp(a, a) == 0, "str_cmp equal");
}

