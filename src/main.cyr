fn test_query_source() {
    var det = str_from("{}");
    var e1 = entry_new(SEV_INFO, str_from("auth"), str_from("login"), det, str_from(""));
    var e2 = entry_new(SEV_INFO, str_from("audit"), str_from("read"), det, entry_hash(e1));

    var entries = vec_new();
    vec_push(entries, e1);
    vec_push(entries, e2);

    var q = query_new();
    query_source(q, str_from("auth"));
    var results = query_apply(q, entries);
    assert(vec_len(results) == 1, "query source filters");
    assert(str_eq(entry_source(vec_get(results, 0)), str_from("auth")) == 1, "query source match");
}

fn test_query_severity() {
    var det = str_from("{}");
    var e1 = entry_new(SEV_DEBUG, str_from("s"), str_from("a"), det, str_from(""));
    var e2 = entry_new(SEV_ERROR, str_from("s"), str_from("a"), det, entry_hash(e1));
    var e3 = entry_new(SEV_CRITICAL, str_from("s"), str_from("a"), det, entry_hash(e2));

    var entries = vec_new();
    vec_push(entries, e1);
    vec_push(entries, e2);
    vec_push(entries, e3);

    var q = query_new();
    query_min_severity(q, SEV_ERROR);
    var results = query_apply(q, entries);
    assert(vec_len(results) == 2, "query min_severity filters");
}

fn test_query_action() {
    var det = str_from("{}");
    var e1 = entry_new(SEV_INFO, str_from("s"), str_from("login"), det, str_from(""));
    var e2 = entry_new(SEV_INFO, str_from("s"), str_from("logout"), det, entry_hash(e1));

    var entries = vec_new();
