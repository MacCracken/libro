# 2.8.9 REGRESSION GUARD — a store read from another thread must not crash.
#
# Until 2.8.9 `patrastore_open` prepared its SELECT and COUNT statements once and
# cached them in the store; `patrastore_len` / `patrastore_load_all` reused them.
# patra's SQL parse scratch is PER-THREAD (`patra_init`: "Install this
# (main/foreign) thread's TLS block so the per-thread SQL parse scratch
# resolves"), so a statement parsed on the opening thread and executed on another
# reached into TLS that was not there — and killed the process. No diagnostic, no
# error return.
#
# Agnostic hit it as "the first HTTP request to one endpoint takes the whole
# server down while every other route keeps working", which is a very indirect
# path back to the cause.
var _ps_thread_len = 0 - 1;

fn _ps_thread_body(arg) {
    _ps_thread_len = patrastore_len(arg);
    return 0;
}

# ── Concurrent-hashing regression (2.8.12) ──
#
# hash_field, _merkle_tag and _cjh_raw_tag each stage a few bytes into a
# buffer and then have the hasher read it back. While those buffers were
# process-global `alloc()`s, two threads hashing at the same time interleaved
# one's store with the other's read — a wrong digest, silently, presenting as
# a false integrity violation with no crash to blame. 2.8.11 fixed hash_field
# and reintroduced the pattern in _merkle_tag / _cjh_raw_tag; 2.8.12 moved all
# three to stack slots. Nothing single-threaded can catch a regression here.
var _hash_thr_ok = 0;
var _hash_thr_done = 0;
var _hash_thr_expect_entry = 0;
var _hash_thr_expect_root = 0;
var _hash_thr_expect_mroot = 0;

# Four copies of the same deterministic entry — enough depth that merkle_build
# tags both leaves (0x00) and internal nodes (0x01).
fn _thr_four_entries(e) {
    var v = vec_new();
    vec_push(v, e); vec_push(v, e); vec_push(v, e); vec_push(v, e);
    return v;
}

fn _hash_thr_body(arg) {
    var ok = 1;
    var i = 0;
    while (i < 300) {
        var e = entry_new_fixed_for_thread_test();
        if (str_eq(entry_compute_hash(e), _hash_thr_expect_entry) == 0) { ok = 0; }
        # A FOUR-leaf tree, deliberately: it calls _merkle_tag with 0x00 for
        # each leaf and 0x01 for each internal node, so the two threads write
        # DIFFERENT tag bytes into the shared buffer. A one-leaf tree only ever
        # writes 0x00, and two threads writing the same byte race harmlessly —
        # which is exactly why the first version of this test passed against a
        # restored global.
        var t = merkle_build(_thr_four_entries(e));
        if (str_eq(merkle_tree_root(t), _hash_thr_expect_mroot) == 0) { ok = 0; }
        var h = hasher_new();
        canonical_json_hash_str(str_from("{\"a\":1 JUNK}"), h);
        if (str_eq(hasher_finalize_hex(h), _hash_thr_expect_root) == 0) { ok = 0; }
        i += 1;
    }
    _hash_thr_ok = ok;
    _hash_thr_done = 1;
    return 0;
}

# A deterministic entry: same uuid, timestamp and fields every call, so its
# hash is a fixed value both threads can agree on.
fn entry_new_fixed_for_thread_test() {
    var e = fl_alloc(88);
    memset(e, 0, 16);
    store8(e, 0x5A);
    entry_set_timestamp(e, str_from("2026-01-01T00:00:00Z"));
    entry_set_severity(e, SEV_INFO);
    entry_set_source(e, str_from("thr"));
    entry_set_action(e, str_from("act"));
    entry_set_details(e, str_from("{\"k\":\"v\",\"n\":12}"));
    entry_set_agent_id(e, 0);
    entry_set_prev_hash(e, str_from(""));
    entry_set_hash_algorithm(e, str_from(HASH_ALGORITHM));
    entry_set_hash(e, entry_compute_hash(e));
    return e;
}

# A targeted contention test for the one-byte staging buffers.
#
# The broad test below drives entry/merkle/canonical hashing together and
# reliably catches a shared 8-byte hash_field buffer, but NOT a shared 1-byte
# tag buffer: the window between the store and the hasher's read is a few
# instructions, and it is only observable when the two threads write DIFFERENT
# bytes. So this hammers exactly that: the worker tags 0x01 forever while the
# main thread tags 0x00 forever, both in a tight loop with no other work.
var _tagrace_bad = 0;
var _tagrace_done = 0;
var _tagrace_expect_1 = 0;
var _tagrace_expect_0 = 0;

fn _tagrace_one(tag) {
    var h = hasher_new();
    _merkle_tag(h, tag);
    hasher_update(h, "x", 1);
    return hasher_finalize_hex(h);
}

fn _tagrace_body(arg) {
    var i = 0;
    while (i < 30000) {
        if (str_eq(_tagrace_one(1), _tagrace_expect_1) == 0) { _tagrace_bad = 1; }
        i += 1;
    }
    _tagrace_done = 1;
    return 0;
}

fn test_merkle_tag_buffer_is_not_shared() {
    _tagrace_expect_0 = _tagrace_one(0);
    _tagrace_expect_1 = _tagrace_one(1);
    assert(str_eq(_tagrace_expect_0, _tagrace_expect_1) == 0,
      "tag 0x00 and 0x01 give different digests (test is not vacuous)");

    _tagrace_bad = 0;
    _tagrace_done = 0;
    thread_create(&_tagrace_body, 0);
    var i = 0;
    while (i < 30000) {
        if (str_eq(_tagrace_one(0), _tagrace_expect_0) == 0) { _tagrace_bad = 1; }
        i += 1;
    }
    var spins = 0;
    while (_tagrace_done == 0 && spins < 500) { sleep_ms(10); spins += 1; }
    assert(_tagrace_done == 1, "tag-race worker finished");
    assert(_tagrace_bad == 0,
      "the merkle tag byte is not staged in shared memory");
}

fn test_concurrent_hashing_is_consistent() {
    var ref = entry_new_fixed_for_thread_test();
    _hash_thr_expect_entry = entry_compute_hash(ref);
    var rh = hasher_new();
    canonical_json_hash_str(str_from("{\"a\":1 JUNK}"), rh);
    _hash_thr_expect_root = hasher_finalize_hex(rh);
    _hash_thr_expect_mroot = merkle_tree_root(merkle_build(_thr_four_entries(ref)));

    _hash_thr_ok = 0;
    _hash_thr_done = 0;
    thread_create(&_hash_thr_body, 0);

    # Hash the same things on THIS thread while the worker hashes on its own.
    var main_ok = 1;
    var i = 0;
    while (i < 300) {
        var e = entry_new_fixed_for_thread_test();
        if (str_eq(entry_compute_hash(e), _hash_thr_expect_entry) == 0) { main_ok = 0; }
        var t = merkle_build(_thr_four_entries(e));
        if (str_eq(merkle_tree_root(t), _hash_thr_expect_mroot) == 0) { main_ok = 0; }
        var h = hasher_new();
        canonical_json_hash_str(str_from("{\"a\":1 JUNK}"), h);
        if (str_eq(hasher_finalize_hex(h), _hash_thr_expect_root) == 0) { main_ok = 0; }
        i += 1;
    }
    assert(main_ok == 1, "main thread hashes consistently under concurrency");

    var spins = 0;
    while (_hash_thr_done == 0 && spins < 200) { sleep_ms(10); spins += 1; }
    assert(_hash_thr_done == 1, "hashing worker finished");
    assert(_hash_thr_ok == 1,
      "worker thread computes the same digests as the main thread");
}

fn test_patrastore_read_from_another_thread() {
    sys_unlink("/tmp/libro_test_ps_thr.patra");
    var ps = patrastore_open(str_from("/tmp/libro_test_ps_thr.patra"));
    assert(ps != 0, "patrastore open for the thread test");

    var e = entry_new(SEV_INFO, str_from("t"), str_from("a"), str_from("d"), str_from(""));
    patrastore_append(ps, e);
    assert(patrastore_len(ps) == 1, "main thread reads its own store");

    # The whole point: the SAME read, from a worker. Before 2.8.9 this line
    # never returned — the process died inside patra's parser.
    _ps_thread_len = 0 - 1;
    thread_create(&_ps_thread_body, ps);
    sleep_ms(400);
    assert(_ps_thread_len == 1, "a worker thread reads the store without dying");

    patrastore_close(ps);
    sys_unlink("/tmp/libro_test_ps_thr.patra");
    sys_unlink("/tmp/libro_test_ps_thr.patra.wal");
}

fn test_patrastore_rejects_overlong_field() {
    sys_unlink("/tmp/libro_test_ps_long.patra");
    sys_unlink("/tmp/libro_test_ps_long.patra.wal");
    var ps = patrastore_open(str_from("/tmp/libro_test_ps_long.patra"));

    # A 300-byte action. patra stores STR in 255 bytes + NUL and, since
    # 1.13.6, rejects rather than truncating. libro bounds the fields itself
    # so the failure is named — and REJECTS rather than shortening, because
    # entry_compute_hash covers the full value: a truncated row would not
    # match the hash stored beside it and the chain would fail verification.
    #
    # NOTE this is a CONTRACT test, not an isolation test: with patra >= 1.13.6
    # pinned it passes whether or not libro's own bound is present, since patra
    # rejects too. What libro's bound adds is that the guarantee no longer
    # DEPENDS on the patra version — built against a patra that truncates
    # (<= 1.13.5) libro would still refuse. That property cannot be exercised
    # in-tree while the pin is current, so it is asserted here as behaviour
    # rather than as a call-path.
    var big = fl_alloc(400);
    memset(big, 65, 300);
    store8(big + 300, 0);
    var longact = str_from(big);

    var det = str_from("{}");
    var e1 = entry_new(SEV_INFO, str_from("auth"),
      longact, det, str_from(""));
    var r = patrastore_append(ps, e1);
    assert(r == PATRA_ERR_ROWSZ, "over-long field rejected with ROWSZ");
    assert(patrastore_len(ps) == 0, "rejected entry was not stored");

    # A field at exactly the limit must still be accepted.
    memset(big, 66, 255);
    store8(big + 255, 0);
    var maxact = str_from(big);
    var e2 = entry_new(SEV_INFO, str_from("auth"),
      maxact, det, str_from(""));
    var r2 = patrastore_append(ps, e2);
    assert(r2 == PATRA_OK, "255-byte field accepted");
    assert(patrastore_len(ps) == 1, "accepted entry stored");

    # And the store stays usable afterwards — a rejection must not wedge it.
    var e3 = entry_new(SEV_INFO, str_from("auth"),
      str_from("normal"), det, entry_hash(e2));
    assert(patrastore_append(ps, e3) == PATRA_OK, "store usable after a rejection");
    assert(patrastore_len(ps) == 2, "subsequent append landed");

    fl_free(big);
    patrastore_close(ps);
    sys_unlink("/tmp/libro_test_ps_long.patra");
    sys_unlink("/tmp/libro_test_ps_long.patra.wal");
}

fn test_patrastore_append_load() {
    sys_unlink("/tmp/libro_test_ps2.patra");
    var ps = patrastore_open(str_from(
        "/tmp/libro_test_ps2.patra"));
    var det = str_from("{}");
    var e1 = entry_new(SEV_INFO, str_from("auth"),
      str_from("login"), det, str_from(""));
    patrastore_append(ps, e1);
    var e2 = entry_new(SEV_WARNING, str_from("audit"),
      str_from("read"), det, entry_hash(e1));
    patrastore_append(ps, e2);
    assert(patrastore_len(ps) == 2,
      "patrastore len 2");
    var loaded = patrastore_load_all(ps);
    var lcount = vec_len(loaded);
    assert(lcount == 2, "patrastore loaded 2");
    if (lcount >= 2) {
        var le1 = vec_get(loaded, 0);
        assert(str_eq(entry_hash(le1),
            entry_hash(e1)) == 1,
          "patrastore hash preserved");
    }
    patrastore_close(ps);
    sys_unlink("/tmp/libro_test_ps2.patra");
    sys_unlink("/tmp/libro_test_ps2.patra.wal");
}

