    sys_unlink("/tmp/libro_test_ps4.patra");
    sys_unlink("/tmp/libro_test_ps4.patra.wal");
}

fn test_patrastore_by_source() {
    sys_unlink("/tmp/libro_test_ps5.patra");
    var ps = patrastore_open(str_from(
    "/tmp/libro_test_ps5.patra"));
    var det = str_from("{}");
    var e1 = entry_new(SEV_INFO, str_from("auth"),
    str_from("login"), det, str_from(""));
    patrastore_append(ps, e1);
    var e2 = entry_new(SEV_INFO, str_from("audit"),
    str_from("read"), det, entry_hash(e1));
    patrastore_append(ps, e2);
    var e3 = entry_new(SEV_INFO, str_from("auth"),
    str_from("logout"), det, entry_hash(e2));
    patrastore_append(ps, e3);
    var results = patrastore_by_source(ps,
    str_from("auth"));
    assert(vec_len(results) == 2,
    "patrastore by_source 2");
    patrastore_close(ps);
    sys_unlink("/tmp/libro_test_ps5.patra");
    sys_unlink("/tmp/libro_test_ps5.patra.wal");
}

fn test_patrastore_transaction() {
    sys_unlink("/tmp/libro_test_ps6.patra");
    var ps = patrastore_open(str_from(
    "/tmp/libro_test_ps6.patra"));
    var det = str_from("{}");
    patrastore_begin(ps);
    var e = entry_new(SEV_INFO, str_from("s"),
    str_from("a"), det, str_from(""));
    patrastore_append(ps, e);
    patrastore_commit(ps);
    assert(patrastore_len(ps) == 1,
    "patrastore tx committed");
    patrastore_close(ps);
    sys_unlink("/tmp/libro_test_ps6.patra");
    sys_unlink("/tmp/libro_test_ps6.patra.wal");
}

fn test_patrastore_persistence() {
    sys_unlink("/tmp/libro_test_ps7.patra");
    var path = str_from("/tmp/libro_test_ps7.patra");
    var ps = patrastore_open(path);
    var det = str_from("{}");
    var e = entry_new(SEV_INFO, str_from("s"),
    str_from("a"), det, str_from(""));
    patrastore_append(ps, e);
    var saved_hash = entry_hash(e);
    patrastore_close(ps);
    var ps2 = patrastore_open(path);
    assert(patrastore_len(ps2) == 1,
    "patrastore persisted");
    var loaded = patrastore_load_all(ps2);
    var le = vec_get(loaded, 0);
    assert(str_eq(entry_hash(le), saved_hash) == 1,
    "patrastore hash survives reopen");
    patrastore_close(ps2);
    sys_unlink("/tmp/libro_test_ps7.patra");
    sys_unlink("/tmp/libro_test_ps7.patra.wal");
}

