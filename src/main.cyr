}

fn test_retention_keep_count() {
    var det = str_from("{}");
    var entries = vec_new();
    var prev = libro_empty_str();
    var i = 0;
    while (i < 5) {
        var e = entry_new(SEV_INFO, str_from("s"), str_from("a"), det, prev);
        vec_push(entries, e);
        prev = entry_hash(e);
        i += 1;
    }

    var r = retention_keep_count(3);
    var split = retention_split_index(r, entries);
    assert(split == 2, "keep_count(3) splits at 2 for 5 entries");
}

fn test_retention_keep_count_no_split() {
    var det = str_from("{}");
    var entries = vec_new();
    var e = entry_new(SEV_INFO, str_from("s"), str_from("a"), det, str_from(""));
    vec_push(entries, e);

    var r = retention_keep_count(10);
    var split = retention_split_index(r, entries);
    assert(split == 0, "keep_count no split when under limit");
}

fn test_chain_append() {
    var c = chain_new();
    var det = str_from("{}");

    chain_append(c, SEV_INFO, str_from("src"), str_from("act1"), det);
    assert(chain_len(c) == 1, "chain append 1");

    chain_append(c, SEV_WARNING, str_from("src"), str_from("act2"), det);
    assert(chain_len(c) == 2, "chain append 2");

    # Verify chain integrity
    var err = chain_verify(c);
    assert(err == 0, "chain append verify");
}

# ⚠ 2.9.0 — `chain_append_nokeep`, the append for a caller that does not want
# the entry. Its whole reason for existing is that `chain_append` CANNOT reuse a
# scratch struct: it hands the entry to the caller, and `test_chain_streaming`
# below holds two at once and compares their linkage. That contract is real, so
# this is an opt-in second entry point rather than a change to the first.
fn test_chain_append_nokeep() {
    var det = str_from("{}");

    # STREAMING: nothing is retained, and the head hash advances on every call.
    var st = chain_new_streaming();
    var h1 = chain_append_nokeep(st, SEV_INFO, str_from("src"), str_from("a1"), det);
    assert(h1 != 0, "nokeep: returns a head hash");
    assert(str_len(h1) > 0, "nokeep: the head hash is not empty");
    assert(str_eq(h1, chain_head_hash(st)) == 1, "nokeep: it IS the chain's head");
    assert_eq(chain_len(st), 0, "nokeep: a streaming chain still retains nothing");

    var h2 = chain_append_nokeep(st, SEV_INFO, str_from("src"), str_from("a2"), det);
    assert(str_eq(h1, h2) == 0, "nokeep: the head advances between appends");
    assert(str_eq(h2, chain_head_hash(st)) == 1, "nokeep: head tracks the last append");

    # The linkage invariant, checked the way test_chain_streaming checks it: the
    # NEXT entry must record the previous head as its predecessor. Appending one
    # entry the ordinary way after two nokeep appends proves the carry slot the
    # scratch path writes is the same one `_chain_prev_link` reads.
    var after = chain_append(st, SEV_INFO, str_from("src"), str_from("a3"), det);
    assert(str_eq(entry_prev_hash(after), h2) == 1,
      "nokeep: the next entry links to the nokeep head — same carry slot");

    # ⚠ 2.10.0 — ZERO allocation per streaming append, and the linkage still
    # holds. Those two must be asserted together: making it free is only
    # interesting if the chain is still a chain.
    #
    # ⚠ The details here MUST be well-formed JSON. An earlier version of this
    # test used "c", which is not, so it took canonical_json_hash_str's raw
    # fallback and never entered the object emitter at all — the emitter that
    # turned out to hold ~87% of the per-append cost. It measured 0 and passed
    # while the real path allocated 696 bytes a record. Build the input the way
    # the PRODUCER builds it: argonaut's details are always JSON objects.
    var zc = chain_new_streaming();
    var det0 = str_from("{}");
    var src0 = str_from("s");
    var act0 = str_from("a");
    chain_append_nokeep(zc, SEV_INFO, src0, act0, det0);   # warm the scratch
    chain_append_nokeep(zc, SEV_INFO, src0, act0, det0);
    var z0 = alloc_used();
    var zi = 0;
    while (zi < 100) { chain_append_nokeep(zc, SEV_INFO, src0, act0, det0); zi = zi + 1; }
    assert_eq((alloc_used() - z0) / 100, 0, "nokeep: a streaming append allocates NOTHING");

    # The head must still advance every time — a scratch that stopped being
    # rewritten would also allocate nothing.
    var za = chain_head_hash(zc);
    chain_append_nokeep(zc, SEV_INFO, src0, act0, str_from("{\"x\":1}"));
    assert(str_eq(za, chain_head_hash(zc)) == 0, "nokeep: the head still advances at zero cost");

    # And the carry slot still feeds the next entry: an ordinary append must
    # record the last scratch head as its predecessor. This is the assertion
    # that would catch the head buffer being overwritten before it was consumed.
    var zh = chain_head_hash(zc);
    var zafter = chain_append(zc, SEV_INFO, src0, act0, det0);
    assert(str_eq(entry_prev_hash(zafter), zh) == 1,
      "nokeep: prev-link survives the reused hash buffer");

    # ⚠ THE INLINE AND SPILL PATHS MUST PRODUCE THE SAME DIGEST.
    #
    # _cjh_emit_object collects up to CJH_INLINE_KEYS keys in stack arrays and
    # promotes to vecs beyond that. Those are two different code paths through
    # a TAMPER-EVIDENCE PREIMAGE: if they ever disagree by one byte, chains
    # written on one side of the boundary stop verifying on the other, and the
    # boundary is a key count nobody watches. Both sorts are stable under the
    # same comparator so they are permutation-identical by construction — but
    # "by construction" is exactly the kind of claim this repo has had refuted
    # before, so hash the SAME documents both ways and compare.
    #
    # Setting the global to 0 forces every object to spill, including nested
    # and empty ones. Only LOWERING it is safe (_cjh_emit_object clamps the
    # other direction, since raising it would overrun four stack buffers).
    var cj_saved = CJH_INLINE_KEYS;
    var cj_docs = vec_new();
    vec_push(cj_docs, str_from("{}"));
    vec_push(cj_docs, str_from("{\"a\":1}"));
    vec_push(cj_docs, str_from("{\"b\":2,\"a\":1}"));
    vec_push(cj_docs, str_from("{\"service\":\"sshd\",\"pid\":412}"));
    vec_push(cj_docs, str_from("{\"a\":{\"b\":{\"c\":[1,2,{\"d\":null}]}}}"));
    vec_push(cj_docs, str_from("{\"\\u0041\":1,\"A\":2}"));
    vec_push(cj_docs, _t_obj_n(17, 1));
    var cj_i = 0;
    while (cj_i < vec_len(cj_docs)) {
        var doc = vec_get(cj_docs, cj_i);
        CJH_INLINE_KEYS = 16;
        var d_inline = _t_cjh_s(doc);
        CJH_INLINE_KEYS = 0;
        var d_spill = _t_cjh_s(doc);
        CJH_INLINE_KEYS = cj_saved;
        assert(str_eq(d_inline, d_spill) == 1,
          "canonical JSON: inline and spill paths agree on the digest");
        cj_i += 1;
    }

    # ⚠ Sweep the boundary rather than spot-checking it. CJH_INLINE_KEYS is 16,
    # so 16 is the last inline count and 17 the first spilled; nothing about the
    # emission may change across that step. Walking 0..20 also covers the empty
    # object and the promotion copy carrying exactly a full buffer.
    var bn = 0;
    while (bn <= 20) {
        var bdoc = _t_obj_n(bn, 1);
        CJH_INLINE_KEYS = 16;
        var d_in = _t_cjh_s(bdoc);
        CJH_INLINE_KEYS = 0;
        var d_sp = _t_cjh_s(bdoc);
        CJH_INLINE_KEYS = cj_saved;
        assert(str_eq(d_in, d_sp) == 1,
          "canonical JSON: inline and spill agree across the capacity boundary");
        bn += 1;
    }

    # The allocation-free hash must equal the allocating one over the same
    # entry — one body, but assert it rather than trust the refactor.
    var he = entry_new(SEV_INFO, src0, act0, det0, str_from(""));
    var dbuf = alloc(32);
    var hbuf = alloc(72);
    entry_compute_hash_into(he, dbuf, hbuf);
    assert(str_eq(entry_compute_hash(he), str_new(hbuf, 64)) == 1,
      "entry_compute_hash_into produces the SAME hex as entry_compute_hash");

    # Same for the timestamp formatter.
    var tbuf = alloc(24);
    var tbox = alloc(16);
    timestamp_rfc3339_into(1756300000, tbuf, tbox);
    assert(str_eq(timestamp_rfc3339(1756300000), tbox) == 1,
      "timestamp_rfc3339_into produces the SAME text as timestamp_rfc3339");

    # RETAINING: there is nothing to reuse, so it must behave exactly like
    # chain_append and the entries must still be kept and independent.
    var rt = chain_new();
    var r1 = chain_append_nokeep(rt, SEV_INFO, str_from("src"), str_from("b1"), det);
    var r2 = chain_append_nokeep(rt, SEV_INFO, str_from("src"), str_from("b2"), det);
    assert_eq(chain_len(rt), 2, "nokeep: a retaining chain still retains");
    assert(str_eq(r1, r2) == 0, "nokeep: retaining head advances too");
    assert(str_eq(r2, chain_head_hash(rt)) == 1, "nokeep: retaining head is the last entry's");
    assert(chain_verify(rt) == 0, "nokeep: a retaining chain built this way verifies");
    return 0;
}

fn test_chain_streaming() {
    var det = str_from("{}");

    # A streaming chain links exactly like a retaining one but keeps nothing.
    # Build both from the same inputs and require the recorded prev-hash of each
    # entry to match — that is what makes the durable, on-disk chain verify
    # identically whichever mode produced it.
    var normal = chain_new();
    var stream = chain_new_streaming();
    assert(chain_streaming(stream) == 1, "streaming flag set");
    assert(chain_streaming(normal) == 0, "normal chain is not streaming");

    # Linkage must be checked WITHIN the streaming chain, not across two chains:
    # each entry carries a random UUID and its own timestamp, so two chains fed
    # the same inputs legitimately produce different hashes. The invariant that
    # actually matters is that entry N+1 records entry N's hash as its
    # predecessor — the property the durable on-disk chain is verified against.
    var s1 = chain_append(stream, SEV_INFO, str_from("src"), str_from("a1"), det);
    var s2 = chain_append(stream, SEV_INFO, str_from("src"), str_from("a2"), det);
    var s3 = chain_append(stream, SEV_INFO, str_from("src"), str_from("a3"), det);
    assert(str_eq(entry_prev_hash(s2), entry_hash(s1)) == 1, "streaming: e2 links to e1");
    assert(str_eq(entry_prev_hash(s3), entry_hash(s2)) == 1, "streaming: e3 links to e2");

    # The same three appends against a retaining chain link the same way, so the
    # mode changes retention only — never the shape of the chain it emits.
    var n1 = chain_append(normal, SEV_INFO, str_from("src"), str_from("a1"), det);
    var n2 = chain_append(normal, SEV_INFO, str_from("src"), str_from("a2"), det);
    var n3 = chain_append(normal, SEV_INFO, str_from("src"), str_from("a3"), det);
    assert(str_eq(entry_prev_hash(n2), entry_hash(n1)) == 1, "retaining: e2 links to e1");
    assert(str_eq(entry_prev_hash(n3), entry_hash(n2)) == 1, "retaining: e3 links to e2");

    # The point of the mode: the retaining chain grew, the streaming one did not.
    assert(chain_len(normal) == 3, "retaining chain holds every entry");
    assert(chain_len(stream) == 0, "streaming chain retains nothing");

    # And it stays flat no matter how many events go through it — this is the
    # unbounded growth the mode exists to remove.
    var i = 0;
    while (i < 200) {
        var e = chain_append(stream, SEV_INFO, str_from("src"), str_from("bulk"), det);
        entry_free(e);
        i = i + 1;
    }
    assert(chain_len(stream) == 0, "streaming chain is still empty after 200 appends");

    # entry_free tolerates a null and does not disturb the chain.
    entry_free(0);
    assert(chain_len(stream) == 0, "entry_free(0) is a no-op");
}

fn test_chain_append_batch() {
    var c = chain_new();
    var det = str_from("{}");

    # Seed with one entry so the batch starts after a non-empty tail.
    chain_append(c, SEV_INFO, str_from("src"), str_from("seed"), det);

    var sevs = vec_new();
    var srcs = vec_new();
    var acts = vec_new();
    var dets = vec_new();
    var i = 0;
    while (i < 5) {
        vec_push(sevs, SEV_INFO);
        vec_push(srcs, str_from("src"));
        vec_push(acts, str_from("batched"));
        vec_push(dets, det);
        i += 1;
    }

    var out = chain_append_batch(c, sevs, srcs, acts, dets);
    assert(vec_len(out) == 5, "append_batch returned 5 entries");
    assert(chain_len(c) == 6, "chain grew by 5 (seed + batch)");

    # Linkage must be intact end-to-end.
    var err = chain_verify(c);
    assert(err == 0, "append_batch verify");

    # First batched entry must link to seed's hash.
    var seed = vec_get(chain_entries(c), 0);
    var first_batched = vec_get(out, 0);
    assert(str_eq(entry_prev_hash(first_batched), entry_hash(seed)) == 1,
      "batch first entry links to seed");
}

