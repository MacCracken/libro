fn test_retention_keep_count() {
    var det = str_from("{}");
    var entries = vec_new();
    var prev = str_from("");
    var i = 0;
    while (i < 5) {
        var e = entry_new(SEV_INFO, str_from("s"), str_from("a"), det, prev);
        vec_push(entries, e);
        prev = entry_hash(e);
        i = i + 1;
    }

    var r = retention_keep_count(3);
    var split = retention_split_index(r, entries);
    assert(split == 2, "keep_count(3) splits at 2 for 5 entries");
}

fn test_retention_keep_count_no_split() {
