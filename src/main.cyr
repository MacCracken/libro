    assert(ts_status_is_granted(TS_GRANTED_WITH_MODS) == 1, "granted_with_mods is granted");
    assert(ts_status_is_granted(TS_REJECTION) == 0, "rejection is not granted");
}

fn test_kernel_classify() {
    assert(classify_kernel_result(0) == SEV_INFO, "result 0 = info");
    assert(classify_kernel_result(1) == SEV_WARNING, "result 1 = warning");
    assert(classify_kernel_result(0 - 1) == SEV_ERROR, "result -1 = error");
    assert(classify_kernel_result(0 - 13) == SEV_SECURITY, "result -13 = security");
}

