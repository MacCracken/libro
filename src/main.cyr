}

fn test_query_empty_matches_all() {
    var det = str_from("{}");
    var e1 = entry_new(SEV_INFO, str_from("s"), str_from("a"), det, str_from(""));
    var e2 = entry_new(SEV_INFO, str_from("s"), str_from("a"), det, entry_hash(e1));

    var entries = vec_new();
    vec_push(entries, e1);
    vec_push(entries, e2);

    var q = query_new();
    var results = query_apply(q, entries);
