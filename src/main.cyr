fn test_chain_page() {
    var c = chain_new();
    var det = str_from("{}");
    var i = 0;
    while (i < 10) {
        chain_append(c, SEV_INFO, str_from("s"), str_from("a"), det);
        i = i + 1;
    }

    var page = chain_page(c, 3, 4);
    assert(vec_len(page) == 4, "chain page size");

    # Past end
    var page2 = chain_page(c, 8, 5);
    assert(vec_len(page2) == 2, "chain page clamp end");
}

