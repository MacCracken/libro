}

fn test_ts_request_der() {
    var hash = str_from("ba7816bf8f01cfea414140de5dae2223b00361a396177a9cb410ff61f20015ad");
    var req = ts_request_new(hash);
    var der = ts_request_to_der(req);
    assert(str_len(der) > 0, "DER encoding produces output");
    # DER should start with SEQUENCE tag (0x30)
    assert((load8(str_data(der)) & 0xFF) == 0x30, "DER starts with SEQUENCE");
}

