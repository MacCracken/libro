    var sk = signing_key_generate();
    signing_key_set_key_id(sk, str_from("key-v2"));

    var c = chain_new();
    chain_append(c, SEV_INFO, str_from("s"), str_from("a"), str_from("{}"));
    var e = vec_get(chain_entries(c), 0);

    var sig = sign_entry_with_key_id(sk, e, str_from("rotation-1"));
    assert(entry_sig_key_id(sig) != 0, "sig has key_id");
