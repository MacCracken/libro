fn test_chain_retention() {
    var c = chain_new();
    var det = str_from("{}");
    var i = 0;
    while (i < 5) {
        chain_append(c, SEV_INFO, str_from("s"), str_from("a"), det);
        i += 1;
    }

    var policy = retention_keep_count(2);
    var arch = chain_apply_retention(c, policy);
    assert(arch != 0, "retention produced archive");
    assert(chain_len(c) == 2, "retention kept 2");
    assert(vec_len(archive_entries(arch)) == 3, "retention archived 3");
    assert(chain_prev_hash(c) != 0, "retention set prev_chain_hash");
}

fn test_memstore_basic() {
    var s = memstore_new();
    assert(memstore_is_empty(s) == 1, "memstore empty");

    var det = str_from("{}");
    var e = entry_new(SEV_INFO, str_from("s"), str_from("a"), det, str_from(""));
    memstore_append(s, e);
    assert(memstore_len(s) == 1, "memstore len 1");
    assert(memstore_is_empty(s) == 0, "memstore not empty");
}

fn test_memstore_verify() {
    var s = memstore_new();
    var det = str_from("{}");
    var prev = str_from("");
    var i = 0;
    while (i < 3) {
        var e = entry_new(SEV_INFO, str_from("s"), str_from("a"), det, prev);
        memstore_append(s, e);
        prev = entry_hash(e);
        i += 1;
    }

    var result = memstore_load_and_verify(s);
    # result is the entries vec (not an error pointer)
    assert(vec_len(result) == 3, "memstore verify returns entries");
}

fn test_memstore_streamed() {
    var s = memstore_new();
    var det = str_from("{}");
    var prev = str_from("");
    var i = 0;
    while (i < 10) {
        var e = entry_new(SEV_INFO, str_from("s"), str_from("a"), det, prev);
        memstore_append(s, e);
        prev = entry_hash(e);
        i += 1;
    }

    var count = memstore_verify_streamed(s, 3);
    assert(count == 10, "memstore streamed verified 10");
}

fn test_memstore_query() {
    var s = memstore_new();
    var det = str_from("{}");

    var e1 = entry_new(SEV_INFO, str_from("auth"), str_from("a"), det, str_from(""));
    memstore_append(s, e1);
    var e2 = entry_new(SEV_ERROR, str_from("audit"), str_from("a"), det, entry_hash(e1));
    memstore_append(s, e2);

    var q = query_new();
    query_source(q, str_from("audit"));
    var results = memstore_query(s, q);
    assert(vec_len(results) == 1, "memstore query filters");
}

fn test_memstore_page() {
    var s = memstore_new();
    var det = str_from("{}");
    var prev = str_from("");
    var i = 0;
    while (i < 5) {
        var e = entry_new(SEV_INFO, str_from("s"), str_from("a"), det, prev);
