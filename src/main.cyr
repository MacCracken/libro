    var ps = patrastore_open(path);
    var det = str_from("{}");
    var e = entry_new(SEV_INFO, str_from("s"),
      str_from("a"), det, str_from(""));
    patrastore_append(ps, e);
    var saved_hash = entry_hash(e);
    patrastore_close(ps);
    var ps2 = patrastore_open(path);
    assert(patrastore_len(ps2) == 1,
      "patrastore persisted");
    var loaded = patrastore_load_all(ps2);
    var le = vec_get(loaded, 0);
    assert(str_eq(entry_hash(le), saved_hash) == 1,
      "patrastore hash survives reopen");
    patrastore_close(ps2);
    sys_unlink("/tmp/libro_test_ps7.patra");
    sys_unlink("/tmp/libro_test_ps7.patra.wal");
}

# ================================================================
# 2.4.0 perf-tier coverage: sync mode, batch append, prepared
# statements, indexed by-source query.
# ================================================================

fn test_patrastore_sync_mode_default_full() {
    sys_unlink("/tmp/libro_test_ps_sync1.patra");
    sys_unlink("/tmp/libro_test_ps_sync1.patra.wal");
    var ps = patrastore_open(str_from("/tmp/libro_test_ps_sync1.patra"));
    assert(patrastore_get_sync_mode(ps) == PATRA_SYNC_FULL,
      "patrastore: sync defaults to FULL");
    patrastore_close(ps);
    sys_unlink("/tmp/libro_test_ps_sync1.patra");
    sys_unlink("/tmp/libro_test_ps_sync1.patra.wal");
}

fn test_patrastore_sync_mode_switch() {
    sys_unlink("/tmp/libro_test_ps_sync2.patra");
    sys_unlink("/tmp/libro_test_ps_sync2.patra.wal");
    var ps = patrastore_open(str_from("/tmp/libro_test_ps_sync2.patra"));
    patrastore_set_sync_mode(ps, PATRA_SYNC_BATCH);
    assert(patrastore_get_sync_mode(ps) == PATRA_SYNC_BATCH,
      "patrastore: switched to BATCH");
    patrastore_set_sync_mode(ps, PATRA_SYNC_FULL);
    assert(patrastore_get_sync_mode(ps) == PATRA_SYNC_FULL,
      "patrastore: switched back to FULL");
    patrastore_close(ps);
    sys_unlink("/tmp/libro_test_ps_sync2.patra");
    sys_unlink("/tmp/libro_test_ps_sync2.patra.wal");
}

fn test_patrastore_append_batch_correctness() {
    # Bulk-append via patrastore_append_batch must produce the same
    # rows as N individual patrastore_append calls. The sync mode is
    # internally toggled to BATCH for the loop; correctness comes from
    # patra's WAL contract regardless of sync mode.
    sys_unlink("/tmp/libro_test_ps_batch.patra");
    sys_unlink("/tmp/libro_test_ps_batch.patra.wal");
    var ps = patrastore_open(str_from("/tmp/libro_test_ps_batch.patra"));
    var det = str_from("{}");
    var c = chain_new();
    chain_append(c, SEV_INFO, str_from("svc-a"), str_from("act-1"), det);
    chain_append(c, SEV_WARNING, str_from("svc-b"), str_from("act-2"), det);
    chain_append(c, SEV_ERROR, str_from("svc-a"), str_from("act-3"), det);
    var entries = chain_entries(c);
    var ok = patrastore_append_batch(ps, entries);
    assert(ok == 3, "append_batch: 3 entries inserted");
    assert(patrastore_len(ps) == 3, "append_batch: row count matches");
    # Sync mode restored to caller's prior mode (FULL by default).
    assert(patrastore_get_sync_mode(ps) == PATRA_SYNC_FULL,
      "append_batch: sync mode restored to FULL");
    var loaded = patrastore_load_all(ps);
    assert(vec_len(loaded) == 3, "append_batch: load_all returns 3");
    var loaded_last = vec_get(loaded, 2);
    assert(entry_severity(loaded_last) == SEV_ERROR,
      "append_batch: last entry severity preserved");
    patrastore_close(ps);
    sys_unlink("/tmp/libro_test_ps_batch.patra");
    sys_unlink("/tmp/libro_test_ps_batch.patra.wal");
}

fn test_patrastore_append_batch_preserves_caller_batch() {
    # If the caller is already in SYNC_BATCH mode (e.g. doing a larger
    # bulk-import window), patrastore_append_batch must NOT downgrade
    # them back to FULL on return.
    sys_unlink("/tmp/libro_test_ps_batch2.patra");
    sys_unlink("/tmp/libro_test_ps_batch2.patra.wal");
    var ps = patrastore_open(str_from("/tmp/libro_test_ps_batch2.patra"));
    patrastore_set_sync_mode(ps, PATRA_SYNC_BATCH);
    var det = str_from("{}");
    var c = chain_new();
    chain_append(c, SEV_INFO, str_from("s"), str_from("a"), det);
    patrastore_append_batch(ps, chain_entries(c));
    assert(patrastore_get_sync_mode(ps) == PATRA_SYNC_BATCH,
      "append_batch: preserves caller's BATCH mode");
    patrastore_close(ps);
    sys_unlink("/tmp/libro_test_ps_batch2.patra");
    sys_unlink("/tmp/libro_test_ps_batch2.patra.wal");
}

fn test_patrastore_prepared_stmts_survive_open() {
    # ⚠ **INVERTED at 2.8.9.** This test used to assert the SELECT and COUNT
    # statements WERE prepared at open — it was regression coverage for the
    # 2.4.0 prepare-once-at-open path, and it encoded the defect.
    #
    # Caching a parsed statement in the store and executing it from another
    # thread crashes the process: patra's SQL parse scratch is per-thread. The
    # cache is gone, the slots stay 0, and both read paths parse on the calling
    # thread. `test_patrastore_read_from_another_thread` is the guard that
    # replaces this one; what remains here is that the read paths still work.
    sys_unlink("/tmp/libro_test_ps_prep.patra");
    sys_unlink("/tmp/libro_test_ps_prep.patra.wal");
    var ps = patrastore_open(str_from("/tmp/libro_test_ps_prep.patra"));
    assert(_patrastore_select_stmt(ps) == 0,
      "patrastore: no select_stmt is cached at open");
    assert(_patrastore_count_stmt(ps) == 0,
      "patrastore: no count_stmt is cached at open");
    # Fire both read paths to confirm they work unprepared.
    var det = str_from("{}");
    var e = entry_new(SEV_INFO, str_from("s"), str_from("a"), det, str_from(""));
    patrastore_append(ps, e);
    assert(patrastore_len(ps) == 1, "count returns 1 without a cached statement");
    var loaded = patrastore_load_all(ps);
    assert(vec_len(loaded) == 1, "select returns 1 row without a cached statement");
    patrastore_close(ps);
    sys_unlink("/tmp/libro_test_ps_prep.patra");
    sys_unlink("/tmp/libro_test_ps_prep.patra.wal");
}

fn test_patrastore_indexed_by_source() {
    # Coverage for the opt-in STR-keyed src_idx — patra 1.7.0 STR btree.
    # Functional check: by_source still returns the right rows after
    # the consumer creates the index (regression guard against the
    # index corrupting the query). Perf delta is captured in the benches.
    # The index is opt-in (not auto-created at open) — see the rationale
    # comment on patrastore_create_source_index.
    sys_unlink("/tmp/libro_test_ps_idx.patra");
    sys_unlink("/tmp/libro_test_ps_idx.patra.wal");
    var ps = patrastore_open(str_from("/tmp/libro_test_ps_idx.patra"));
    assert(patrastore_create_source_index(ps) == PATRA_OK,
      "src_idx created");
    # Idempotent — a second create returns PATRA_ERR_EXISTS, not an error.
    var second = patrastore_create_source_index(ps);
    assert(second == PATRA_OK || second == PATRA_ERR_EXISTS,
      "src_idx re-create is idempotent");
    var det = str_from("{}");
    var c = chain_new();
    chain_append(c, SEV_INFO, str_from("kernel"),     str_from("syscall"), det);
    chain_append(c, SEV_INFO, str_from("aegis"),      str_from("event"),   det);
    chain_append(c, SEV_INFO, str_from("kernel"),     str_from("trap"),    det);
    chain_append(c, SEV_INFO, str_from("daimon"),     str_from("audit"),   det);
    chain_append(c, SEV_INFO, str_from("kernel"),     str_from("fault"),   det);
    patrastore_append_batch(ps, chain_entries(c));
    var kernel_rows = patrastore_by_source(ps, str_from("kernel"));
    assert(vec_len(kernel_rows) == 3, "indexed by_source: 3 kernel rows");
    var aegis_rows = patrastore_by_source(ps, str_from("aegis"));
    assert(vec_len(aegis_rows) == 1, "indexed by_source: 1 aegis row");
    var none_rows = patrastore_by_source(ps, str_from("nonexistent"));
    assert(vec_len(none_rows) == 0, "indexed by_source: 0 rows for unknown source");
    patrastore_close(ps);
    sys_unlink("/tmp/libro_test_ps_idx.patra");
    sys_unlink("/tmp/libro_test_ps_idx.patra.wal");
}

# ================================================================
# TPM-sealed anchor tests (2.5.0) — opt-in via -D LIBRO_TPM
# ================================================================
# These tests cover API correctness, not environmental functionality:
# they pass on hosts without a TPM (tpm_detect == 0), hosts with a
# TPM but no tpm2-tools (seal fails), and hosts with full TPM
# infrastructure (full roundtrip). The runtime-success of seal +
# unseal depends on the host's tpm2-tools install + permissions +
# PCR policy; libro's contract is that the API surface dispatches
# correctly in every case and never crashes on partial-init paths.
#ifdef LIBRO_TPM
fn test_tpm_anchor_verify_null_returns_inner_invalid() {
    # tpm_anchor_verify(0) is the no-op consumer-side fast path —
    # if the construction failed (returned 0), verify must report
    # invalid rather than crashing on a null deref.
    assert(tpm_anchor_verify(0) == TPM_ANCHOR_INNER_INVALID,
      "tpm_anchor_verify(0) returns INNER_INVALID");
    assert(tpm_anchor_verify_strict(0) == 0,
      "tpm_anchor_verify_strict(0) returns 0");
}

fn test_tpm_anchor_default_pcr_indices() {
    # The conservative AGNOS-aligned default: PCR 0 (firmware) and
    # PCR 7 (Secure Boot config). Other PCRs are deliberately
    # excluded — see the comment in src/tpm_anchor.cyr.
    var pcrs = tpm_anchor_default_pcr_indices();
    assert(vec_len(pcrs) == 2, "default PCR set has 2 entries");
    assert(vec_get(pcrs, 0) == 0, "default PCR[0] = 0 (firmware)");
    assert(vec_get(pcrs, 1) == 7, "default PCR[1] = 7 (Secure Boot)");
}

fn test_tpm_anchor_inner_invalid_on_bad_inner() {
    # Even on a fully-equipped TPM host, if the inner anchor is
    # tampered with, verify must return INNER_INVALID — the TPM
    # seal can't rescue an anchor whose self-hash doesn't match.
    # Built via derived setters so the test stays inside the
    # raw-offset allowlist's contract.
    var c = chain_new();
    chain_append(c, SEV_INFO, str_from("s"), str_from("a"), str_from("{}"));
    var tree = merkle_build(chain_entries(c));
    var inner = anchor_new(tree, c);
    # Tamper: corrupt the anchor's stored hash via the derived setter
    # so anchor_verify_integrity fails. The integrity helper's tamper
    # detection is pinned elsewhere — this just exercises that
    # tpm_anchor_verify gates on it.
    anchor_set_hash(inner, str_from("tampered"));
    # Build a fake tpm_anchor via the derived setters so the test
    # doesn't depend on tpm_seal succeeding. The sealed_ctx is
    # irrelevant because we bail at the inner-integrity check before
    # unseal.
    var ta = fl_alloc(32);
    tpm_anchor_set_inner(ta, inner);
    tpm_anchor_set_sealed_ctx(ta, 0);
    tpm_anchor_set_pcr_indices(ta, tpm_anchor_default_pcr_indices());
    tpm_anchor_set_output_dir(ta, str_from("/tmp"));
    assert(tpm_anchor_verify(ta) == TPM_ANCHOR_INNER_INVALID,
      "tpm_anchor_verify rejects tampered inner anchor");
    assert(tpm_anchor_verify_strict(ta) == 0,
      "tpm_anchor_verify_strict rejects tampered inner anchor");
}

# Hardware-path: only attempts the full seal+verify when the host
# can actually do it (TPM device present AND seal succeeds). On
# CI/dev hosts where tpm2-tools is missing or the TPM isn't
# accessible, the test logs and skips. When the host CAN do it,
# the test pins the success-path contract.
fn test_tpm_anchor_hardware_roundtrip_best_effort() {
    if (tpm_detect() == 0) {
        sakshi_info("tpm_anchor: skipping hardware roundtrip (no TPM)", 50);
        assert(1 == 1, "tpm_anchor hardware roundtrip: no TPM, skip");
        return 0;
    }
    var c = chain_new();
    chain_append(c, SEV_INFO, str_from("s"), str_from("a"), str_from("{}"));
    var tree = merkle_build(chain_entries(c));
    var inner = anchor_new(tree, c);
    var pcrs = tpm_anchor_default_pcr_indices();
    # /tmp exists; we don't try to mkdir a custom directory because
    # the test would fail on hosts without mkdir-as-fn in the stdlib.
    var ta = tpm_anchor_new(inner, str_from("/tmp"), pcrs);
    if (ta == 0) {
        # Seal failed — most commonly tpm2-tools not installed, or
        # /dev/tpmrm0 ACL forbids the test user. Both are valid
        # runtime environments; the API surface didn't crash and
        # returned a sentinel 0 that the consumer can null-check.
        sakshi_info("tpm_anchor: skipping verify (seal failed; tpm2-tools?)", 56);
        assert(1 == 1, "tpm_anchor hardware roundtrip: seal failed, skip");
        return 0;
    }
    # Seal succeeded — verify must now return VALID, and the strict
    # bool form must return 1.
    assert(tpm_anchor_verify(ta) == TPM_ANCHOR_VALID,
      "tpm_anchor_verify on fresh seal returns VALID");
    assert(tpm_anchor_verify_strict(ta) == 1,
      "tpm_anchor_verify_strict on fresh seal returns 1");
    sys_unlink("/tmp/sealed.ctx");
    sys_unlink("/tmp/sealed.pub");
    sys_unlink("/tmp/sealed.priv");
}
#endif

