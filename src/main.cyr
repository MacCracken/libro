fn test_export_csv_escape() {
    # Test via building a chain and exporting
    var c = chain_new();
    chain_append(c, SEV_INFO, str_from("src"), str_from("act"), str_from("{}"));
    assert(chain_len(c) == 1, "export chain has entry");
    # CSV export to /dev/null just to verify no crash
    var fd = file_open("/dev/null", 1, 0);
    export_csv(chain_entries(c), fd);
    file_close(fd);
    assert(1 == 1, "csv export no crash");
}

