}

# ── 2.8.11 hardening regressions (P(-1) sweep, 2026-08-22) ──

# Canonical-JSON digest of a literal, for collision assertions.
fn _t_cjh(cstr) {
    var h = hasher_new();
    canonical_json_hash_str(str_from(cstr), h);
    return hasher_finalize_hex(h);
}

# Build an n-key object `{"a":1,"b":1,...}` for the capacity-boundary sweep.
# Generated rather than written out: the 17- and 18-key literals ran past the
# 120-column lint, and a generator lets the sweep walk every count around the
# CJH_INLINE_KEYS boundary instead of spot-checking two of them.
#
# desc = 1 emits keys in DESCENDING order, so the sort actually has to move
# them. An ascending literal is already sorted and would exercise nothing.
fn _t_obj_n(n, desc) {
    var alpha = "abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ";
    var buf = alloc(n * 8 + 4);
    var o = 0;
    store8(buf + o, 123); o += 1;
    var i = 0;
    while (i < n) {
        if (i > 0) { store8(buf + o, 44); o += 1; }
        var ki = i;
        if (desc == 1) { ki = n - 1 - i; }
        store8(buf + o, 34); o += 1;
        store8(buf + o, load8(alpha + ki) & 0xFF); o += 1;
        store8(buf + o, 34); o += 1;
        store8(buf + o, 58); o += 1;
        store8(buf + o, 49); o += 1;
        i += 1;
    }
    store8(buf + o, 125); o += 1;
    store8(buf + o, 0);
    return str_new(buf, o);
}

# Same, over an already-built Str — for the inline/spill equivalence sweep,
# which needs to hash one document twice under two different capacities.
fn _t_cjh_s(sv) {
    var h = hasher_new();
    canonical_json_hash_str(sv, h);
    return hasher_finalize_hex(h);
}

# THE COLLISION FIX. All five of these produced digest 015abd7f5cc57a2d…
# on 2.8.10, so arbitrary bytes could be injected into a stored `details`
# without moving the entry hash, the chain linkage or the Merkle root.
fn test_canonical_json_no_junk_collision() {
    var base = _t_cjh("{\"a\":1}");
    assert(str_eq(_t_cjh("{ZZZZ\"a\":1}"), base) == 0,
      "junk before key no longer collides");
    assert(str_eq(_t_cjh("{\"a\":1 JUNK}"), base) == 0,
      "junk after value no longer collides");
    assert(str_eq(_t_cjh("{\"a\" 1}"), base) == 0,
      "missing colon no longer collides");
    assert(str_eq(_t_cjh("{\"a\":1}XXXXXXX"), base) == 0,
      "trailing content no longer collides");
    # And the malformed forms must not collide with EACH OTHER either —
    # the raw fallback is length-prefixed, so it is injective.
    assert(str_eq(_t_cjh("{ZZZZ\"a\":1}"), _t_cjh("{\"a\":1 JUNK}")) == 0,
      "distinct malformed inputs stay distinct");
    assert(str_eq(_t_cjh("{\"a\" 1}"), _t_cjh("{\"a\":1}XXXXXXX")) == 0,
      "distinct malformed inputs stay distinct (2)");
}

# The other half of the contract: WELL-FORMED input must hash exactly as it
# did before, or 2.8.11 would silently invalidate every stored chain twice
# over. Whitespace-insensitive, key-order-insensitive, value-sensitive.
fn test_canonical_json_valid_unchanged() {
    assert(str_eq(_t_cjh("{\"a\":1}"), _t_cjh("{ \"a\" : 1 }")) == 1,
      "whitespace does not change the canonical digest");
    assert(str_eq(_t_cjh("{\"a\":1,\"b\":2}"),
        _t_cjh("{\"b\":2,\"a\":1}")) == 1,
      "key order does not change the canonical digest");
    assert(str_eq(_t_cjh("{\"a\":1}"), _t_cjh("{\"a\":2}")) == 0,
      "value change does change the canonical digest");
    assert(str_eq(_t_cjh("{}"), _t_cjh("[]")) == 0,
      "empty object and empty array stay distinct");
}

# Exercises the merge sort past width 1 and asserts key order still does not
# affect the digest for a large object. Also the perf regression guard: this
# object cost O(n^2) key comparisons through 2.8.10.
fn test_canonical_json_many_keys_order_independent() {
    var fwd = str_builder_new();
    var rev = str_builder_new();
    str_builder_add_cstr(fwd, "{");
    str_builder_add_cstr(rev, "{");
    var n = 64;
    var i = 0;
    while (i < n) {
        if (i > 0) { str_builder_add_cstr(fwd, ","); }
        str_builder_add_cstr(fwd, "\"k");
        str_builder_add(fwd, str_from_int(i));
        str_builder_add_cstr(fwd, "\":");
        str_builder_add(fwd, str_from_int(i));
        i += 1;
    }
    i = n - 1;
    var first = 1;
    while (i >= 0) {
        if (first == 0) { str_builder_add_cstr(rev, ","); }
        first = 0;
        str_builder_add_cstr(rev, "\"k");
        str_builder_add(rev, str_from_int(i));
        str_builder_add_cstr(rev, "\":");
        str_builder_add(rev, str_from_int(i));
        i -= 1;
    }
    str_builder_add_cstr(fwd, "}");
    str_builder_add_cstr(rev, "}");
    var sf = str_builder_build(fwd);
    var sr = str_builder_build(rev);
    assert(canonical_json_is_valid(sf) == 1, "64-key object is valid JSON");
    var hf = hasher_new();
    canonical_json_hash_str(sf, hf);
    var df = hasher_finalize_hex(hf);
    var hr = hasher_new();
    canonical_json_hash_str(sr, hr);
    var dr = hasher_finalize_hex(hr);
    assert(str_eq(df, dr) == 1,
      "64-key object hashes identically in either key order");
}

# Pins the canonical form's exact BYTES, not just its stability. The
# order-independence test above passes under a reversed comparator too, so it
# cannot detect a sort-direction change — which would silently move every
# multi-key digest. Canonical output is ascending key order, no whitespace,
# so its digest must equal plain SHA-256 of that literal byte string.
fn test_canonical_json_emits_ascending_key_order() {
    var h = hasher_new();
    canonical_json_hash_str(str_from("{\"b\":1,\"a\":2}"), h);
    var got = hasher_finalize_hex(h);
    var want = _t_untagged_hash1(str_from("{\"a\":2,\"b\":1}"));
    assert(str_eq(got, want) == 1,
      "canonical form is ascending key order, exact bytes");

    var h2 = hasher_new();
    canonical_json_hash_str(str_from("{\"z\":1,\"m\":2,\"a\":3}"), h2);
    assert(str_eq(hasher_finalize_hex(h2),
        _t_untagged_hash1(str_from("{\"a\":3,\"m\":2,\"z\":1}"))) == 1,
      "three-key canonical form is ascending, exact bytes");
}

# ── Canonical normalization (2.8.12) ──
#
# ADR 0007 has always claimed "the same logical value produces the same hash
# regardless of incidental formatting" and cited RFC 8785. Through 2.8.11 it
# did not: strings were hashed with their escapes and numbers with their
# source spelling, so one value had many digests.
fn _t_cj_same(a, b) {
    if (str_eq(_t_cjh(a), _t_cjh(b)) == 1) { return 1; }
    return 0;
}

fn test_canonical_string_escapes_normalized() {
    assert(_t_cj_same("{\"a\":\"A\"}", "{\"a\":\"\\u0041\"}") == 1,
      "a string value and its \\u escape hash the same");
    assert(_t_cj_same("{\"A\":1}", "{\"\\u0041\":1}") == 1,
      "an object KEY and its \\u escape hash the same");
    assert(_t_cj_same("{\"a\":\"x/y\"}", "{\"a\":\"x\\/y\"}") == 1,
      "the optional solidus escape is normalized away");
    assert(_t_cj_same("{\"a\":\"A\"}", "{\"a\":\"B\"}") == 0,
      "distinct string values still differ");
    # A control byte must survive normalization as an escape, not vanish.
    assert(_t_cj_same("{\"a\":\"x\\ny\"}", "{\"a\":\"x\\u000ay\"}") == 1,
      "\\n and \\u000a are the same character");
    assert(_t_cj_same("{\"a\":\"x\\ny\"}", "{\"a\":\"xy\"}") == 0,
      "a control character is not dropped");
}

fn test_canonical_numbers_normalized() {
    assert(_t_cj_same("{\"a\":1}", "{\"a\":1.0}") == 1, "1 == 1.0");
    assert(_t_cj_same("{\"a\":1}", "{\"a\":1e0}") == 1, "1 == 1e0");
    assert(_t_cj_same("{\"a\":1}", "{\"a\":1.00E+00}") == 1, "1 == 1.00E+00");
    assert(_t_cj_same("{\"a\":1}", "{\"a\":10e-1}") == 1, "1 == 10e-1");
    assert(_t_cj_same("{\"a\":0.1}", "{\"a\":1e-1}") == 1, "0.1 == 1e-1");
    assert(_t_cj_same("{\"a\":100}", "{\"a\":1e2}") == 1, "100 == 1e2");
    assert(_t_cj_same("{\"a\":0}", "{\"a\":-0}") == 1, "0 == -0");
    assert(_t_cj_same("{\"a\":0}", "{\"a\":0.0}") == 1, "0 == 0.0");
    assert(_t_cj_same("{\"a\":1.5}", "{\"a\":15e-1}") == 1, "1.5 == 15e-1");
    assert(_t_cj_same("{\"a\":-2.5}", "{\"a\":-25e-1}") == 1, "-2.5 == -25e-1");
    assert(_t_cj_same("{\"a\":1e50}",
        "{\"a\":100000000000000000000000000000000000000000000000000}") == 1,
      "1e50 == its 51-digit expansion");

    assert(_t_cj_same("{\"a\":1}", "{\"a\":2}") == 0, "1 != 2");
    assert(_t_cj_same("{\"a\":1}", "{\"a\":1.5}") == 0, "1 != 1.5");
    assert(_t_cj_same("{\"a\":1}", "{\"a\":-1}") == 0, "1 != -1");
    assert(_t_cj_same("{\"a\":0.1}", "{\"a\":0.10001}") == 0, "0.1 != 0.10001");
    # Type distinctions must survive — this was the 1.x defect ADR 0007 fixed.
    assert(_t_cj_same("{\"a\":1}", "{\"a\":\"1\"}") == 0,
      "a number and the string of it still differ");
    assert(_t_cj_same("{\"a\":1}", "{\"a\":true}") == 0, "1 != true");
}

# A number too extreme to expand exactly must be rejected by the validator and
# take the injective raw fallback, not crash and not silently truncate.
fn test_canonical_extreme_exponent_rejected() {
    assert(canonical_json_is_valid(str_from("{\"a\":1e100000}")) == 0,
      "an unexpandable exponent is rejected");
    assert(canonical_json_is_valid(str_from("{\"a\":1e50}")) == 1,
      "a large but expandable exponent is accepted");
    var h = hasher_new();
    canonical_json_hash_str(str_from("{\"a\":1e100000}"), h);
    assert(str_len(hasher_finalize_hex(h)) == 64,
      "an extreme exponent still yields a digest");
    assert(_t_cj_same("{\"a\":1e100000}", "{\"a\":1e100001}") == 0,
      "distinct extreme numbers stay distinct via the raw fallback");
}

# Non-BMP characters: an escaped surrogate PAIR and the literal UTF-8 must
# hash identically, and a LONE surrogate must be rejected by the validator —
# because json_str_decode rejects it, and a validator that accepted what the
# decoder refuses would send the document down the emitter's verbatim
# fallback. Validator/decoder disagreement is the one thing the
# validate-then-emit design exists to prevent.
fn test_canonical_surrogate_pairs() {
    # {"a":"<U+1F600>"} with the emoji as real UTF-8 bytes.
    var b = alloc(32);
    store8(b + 0, 123); store8(b + 1, 34); store8(b + 2, 97);
    store8(b + 3, 34);  store8(b + 4, 58); store8(b + 5, 34);
    store8(b + 6, 0xF0); store8(b + 7, 0x9F);
    store8(b + 8, 0x98); store8(b + 9, 0x80);
    store8(b + 10, 34); store8(b + 11, 125);
    var lit = str_new(b, 12);

    var h1 = hasher_new();
    canonical_json_hash_str(lit, h1);
    var h2 = hasher_new();
    canonical_json_hash_str(str_from("{\"a\":\"\\uD83D\\uDE00\"}"), h2);
    assert(str_eq(hasher_finalize_hex(h1), hasher_finalize_hex(h2)) == 1,
      "an escaped surrogate pair hashes as the literal UTF-8 (not CESU-8)");

    assert(canonical_json_is_valid(str_from("{\"a\":\"\\uD83D\\uDE00\"}")) == 1,
      "a well-formed surrogate pair is valid");
    assert(canonical_json_is_valid(str_from("{\"a\":\"\\uD83D\"}")) == 0,
      "a lone HIGH surrogate is rejected");
    assert(canonical_json_is_valid(str_from("{\"a\":\"\\uDE00\"}")) == 0,
      "a lone LOW surrogate is rejected");
    assert(canonical_json_is_valid(str_from("{\"a\":\"\\uD83Dx\"}")) == 0,
      "a high surrogate not followed by an escape is rejected");
}

# The canonical hasher must not allocate a hundred times its input.
#
# alloc() is the BUMP allocator — never reclaimed — and entry_compute_hash
# runs on every verify of every entry, so an amplification factor here is a
# permanent per-verify memory cost. 2.8.12's number normalizer originally
# took a fixed 1032-byte buffer per NUMBER, measured at 1.19 MB of bump for a
# 10 KB details (110x). Right-sizing it brought that to ~174 KB (16x).
fn test_canonical_hash_allocation_bounded() {
    var sb = str_builder_new();
    str_builder_add_cstr(sb, "{");
    var i = 0;
    while (i < 500) {
        if (i > 0) { str_builder_add_cstr(sb, ","); }
        str_builder_add_cstr(sb, "\"k");
        str_builder_add(sb, str_from_int(i));
        str_builder_add_cstr(sb, "\":");
        str_builder_add(sb, str_from_int(i));
        i += 1;
    }
    str_builder_add_cstr(sb, "}");
    var det = str_builder_build(sb);
    var n = str_len(det);

    var before = alloc(1);
    var h = hasher_new();
    canonical_json_hash_str(det, h);
    hasher_finalize_hex(h);
    var used = alloc(1) - before;

    # 40x the input is generous headroom over the ~16x measured, and still
    # catches a return to the 110x regime.
    assert(used < n * 40,
      "canonical hashing allocates well under 40x the details size");
    assert(used > 0, "the measurement is not vacuous");
}

fn test_canonical_json_validator() {
    assert(canonical_json_is_valid(str_from("{\"a\":1}")) == 1, "valid object");
    assert(canonical_json_is_valid(str_from("[1,2,3]")) == 1, "valid array");
    assert(canonical_json_is_valid(str_from("{}")) == 1, "empty object valid");
    assert(canonical_json_is_valid(str_from("[]")) == 1, "empty array valid");
    assert(canonical_json_is_valid(str_from("null")) == 1, "null valid");
    assert(canonical_json_is_valid(str_from("-1.5e+3")) == 1, "number valid");
    assert(canonical_json_is_valid(str_from("{\"a\" 1}")) == 0, "missing colon invalid");
    assert(canonical_json_is_valid(str_from("{ZZ\"a\":1}")) == 0, "junk in object invalid");
    assert(canonical_json_is_valid(str_from("{\"a\":1}X")) == 0, "trailing byte invalid");
    assert(canonical_json_is_valid(str_from("{\"a\":1")) == 0, "unterminated object invalid");
    assert(canonical_json_is_valid(str_from("\"unterminated")) == 0, "unterminated string invalid");
    assert(canonical_json_is_valid(str_from("01")) == 0, "leading zero invalid");
    assert(canonical_json_is_valid(str_from("tru")) == 0, "truncated literal invalid");
    assert(canonical_json_is_valid(str_from("[1,]")) == 0, "trailing comma invalid");
}

# Deep nesting must be REJECTED, not recursed into. Through 2.8.10 the
# mutually-recursive emitters had no bound and ~130 KB of "[" segfaulted the
# process on append and on every verify.
fn test_canonical_json_depth_cap() {
    var sb = str_builder_new();
    var i = 0;
    while (i < 4000) { str_builder_add_cstr(sb, "["); i += 1; }
    i = 0;
    while (i < 4000) { str_builder_add_cstr(sb, "]"); i += 1; }
    var deep = str_builder_build(sb);
    assert(canonical_json_is_valid(deep) == 0,
      "4000-deep nesting rejected by the depth cap");
    # And hashing it must return, not crash.
    var h = hasher_new();
    canonical_json_hash_str(deep, h);
    assert(str_len(hasher_finalize_hex(h)) == 64,
      "over-deep details still yields a digest without crashing");
}

# An entry whose details is malformed still verifies, and still detects a
# tamper — the fallback must be a real hash, not a constant.
fn test_entry_malformed_details_still_tamper_evident() {
    var e = entry_new(SEV_INFO, str_from("s"), str_from("a"),
      str_from("{\"a\":1 JUNK}"), str_from(""));
    assert(entry_verify(e) == 1, "malformed-details entry verifies");
    entry_set_details(e, str_from("{\"a\":1 OTHERJUNK}"));
    assert(entry_verify(e) == 0,
      "tampering malformed details breaks verification");
}

# The entry preimage must cover hash_algorithm. Through 2.8.10 field 11 sat
# OUTSIDE entry_compute_hash, so this mutation left entry_verify at 1.
fn test_entry_hash_covers_algorithm() {
    var e = entry_new(SEV_INFO, str_from("s"), str_from("a"),
      str_from("{}"), str_from(""));
    assert(entry_verify(e) == 1, "entry verifies before alg tamper");
    entry_set_hash_algorithm(e, str_from("md5-lol"));
    assert(entry_verify(e) == 0,
      "hash_algorithm tamper breaks entry_verify");
}

# RFC 9162 leaf/internal domain separation. A leaf must not be presentable
# as an internal node: the tree's leaf is HASH(0x00 || entry_hash), never
# the bare entry hash it was through 2.8.10.
# Untagged HASH(a) / HASH(a || b) — the pre-2.8.11 constructions. Used to
# assert the domain tags actually contribute; comparing merkle_leaf_hash
# against itself would move with the mutation and prove nothing.
fn _t_untagged_hash1(a) {
    var h = hasher_new();
    hasher_update(h, str_data(a), str_len(a));
    return hasher_finalize_hex(h);
}

fn _t_untagged_hash2(a, b) {
    var h = hasher_new();
    hasher_update(h, str_data(a), str_len(a));
    hasher_update(h, str_data(b), str_len(b));
    return hasher_finalize_hex(h);
}

fn test_merkle_leaf_domain_separated() {
    var c = chain_new();
    chain_append(c, SEV_INFO, str_from("s"), str_from("a"), str_from("{}"));
    var entries = chain_entries(c);
    var eh = entry_hash(vec_get(entries, 0));
    var tree = merkle_build(entries);

    assert(str_eq(merkle_tree_root(tree), eh) == 0,
      "single-leaf root is not the bare entry hash");
    assert(str_eq(merkle_tree_root(tree), merkle_leaf_hash(eh)) == 1,
      "single-leaf root is the leaf hash");
    # The 0x00 tag must CHANGE the digest, not just be documented.
    assert(str_eq(merkle_leaf_hash(eh), _t_untagged_hash1(eh)) == 0,
      "leaf hash is 0x00-tagged, not bare SHA-256");
}

# The 0x01 internal tag must likewise contribute, and a two-leaf root must
# not equal the untagged concatenation an attacker could reconstruct.
fn test_merkle_internal_domain_separated() {
    var c = chain_new();
    var det = str_from("{}");
    chain_append(c, SEV_INFO, str_from("s"), str_from("a"), det);
    chain_append(c, SEV_INFO, str_from("s"), str_from("a"), det);
    var entries = chain_entries(c);
    var l0 = merkle_leaf_hash(entry_hash(vec_get(entries, 0)));
    var l1 = merkle_leaf_hash(entry_hash(vec_get(entries, 1)));
    var tree = merkle_build(entries);
    assert(str_eq(merkle_tree_root(tree), _t_untagged_hash2(l0, l1)) == 0,
      "internal node is 0x01-tagged, not bare concat");
}

# merkle_build's level walk and merkle_canonical_root's RFC 9162 split must
# agree at EVERY size. Through 2.8.10 merkle_build duplicated an odd trailing
# node while canonical_root promoted it, so the two disagreed for every
# non-power-of-2 size and a bundle's two roots could never be bound.
fn test_merkle_root_matches_canonical() {
    var c = chain_new();
    var det = str_from("{}");
    var n = 1;
    while (n <= 9) {
        chain_append(c, SEV_INFO, str_from("s"), str_from("a"), det);
        var tree = merkle_build(chain_entries(c));
        assert(constant_time_eq_str(merkle_tree_root(tree),
            merkle_canonical_root(tree, n)) == 1,
          "merkle_tree_root == merkle_canonical_root");
        n += 1;
    }
}

# An inclusion proof must be checked against an EXTERNAL trusted root, not
# the one it carries. merkle_verify_proof answers only "is this bundle
# self-consistent" and accepts a proof for an entirely different tree.
fn test_merkle_proof_bound_to_external_root() {
    var ca = chain_new();
    var cb = chain_new();
    var det = str_from("{}");
    var i = 0;
    while (i < 4) {
        chain_append(ca, SEV_INFO, str_from("a"), str_from("a"), det);
        chain_append(cb, SEV_INFO, str_from("b"), str_from("b"), det);
        i += 1;
    }
    var ta = merkle_build(chain_entries(ca));
    var tb = merkle_build(chain_entries(cb));
    var mpb = merkle_inclusion_proof(tb, 0);

    assert(merkle_verify_proof(mpb) == 1,
      "foreign proof is self-consistent");
    assert(merkle_verify_proof_against(mpb, merkle_tree_root(tb)) == 1,
      "foreign proof verifies against its own tree root");
    assert(merkle_verify_proof_against(mpb, merkle_tree_root(ta)) == 0,
      "foreign proof rejected against another tree's root");
    assert(merkle_verify_proof_against(mpb, 0) == 0,
      "null expected root rejected");
}

# A proof bundle whose inclusion proofs belong to a different tree must not
# report inclusions_valid. This is the _proof_verify_common binding.
fn test_proof_rejects_foreign_inclusions() {
    var ca = chain_new();
    var cb = chain_new();
    var det = str_from("{}");
    var i = 0;
    while (i < 4) {
        chain_append(ca, SEV_INFO, str_from("a"), str_from("a"), det);
        chain_append(cb, SEV_INFO, str_from("b"), str_from("b"), det);
        i += 1;
    }
    var pa = proof_build_unsigned(ca);
    var pv_ok = proof_verify_unsigned(pa);
    assert(pv_inclusions_valid(pv_ok) == 1,
      "own inclusions valid");

    var tb = merkle_build(chain_entries(cb));
    var foreign = vec_new();
    vec_push(foreign, merkle_inclusion_proof(tb, 0));
    iproof_set_inclusions(pa, foreign);
    var pv_bad = proof_verify_unsigned(pa);
    assert(pv_inclusions_valid(pv_bad) == 0,
      "foreign inclusion proof rejected by bundle verify");
}

# ── FileStore round-trip regressions (2.8.11) ──

# Build a JSONL record with a short fixed id, optionally omitting the
# `timestamp` and/or `prev_hash` field. Assembled rather than written as one
# literal so the test lines stay under the 120-char lint bound.
fn _t_rec(with_ts, with_ph) {
    var sb = str_builder_new();
    str_builder_add_cstr(sb, "{\"id\":\"41414141\"");
    if (with_ts == 1) {
        str_builder_add_cstr(sb, ",\"timestamp\":\"2026-01-01T00:00:00Z\"");
    }
    str_builder_add_cstr(sb, ",\"severity\":\"Info\"");
    str_builder_add_cstr(sb, ",\"source\":\"s\",\"action\":\"a\"");
    str_builder_add_cstr(sb, ",\"details\":\"{}\",\"agent_id\":\"\"");
    if (with_ph == 1) {
        str_builder_add_cstr(sb, ",\"prev_hash\":\"\"");
    }
    str_builder_add_cstr(sb, ",\"hash\":\"ff\"");
    str_builder_add_cstr(sb, ",\"hash_algorithm\":\"sha256\"}");
    return str_builder_build(sb);
}

# Serialize an entry to a JSONL line and read it straight back.
fn _t_fs_roundtrip(e) {
    var sb = str_builder_new();
    _filestore_entry_json(sb, e);
    return _filestore_parse_entry(str_builder_build(sb));
}

# `details` of {"user":"bob"} must survive the round trip byte-for-byte.
# This broke for libro 2.8.10 as shipped — not through libro's own code, but
# through the bayan 1.4.2 its 6.5.31 pin folded, which mis-parsed \" inside a
# string value and dropped every key after it. bayan 1.5.1 fixed that and
# 6.5.34 folds 1.5.2, so the bump alone repairs it; this test pins the
# behaviour so a future fold regression is caught here rather than in a
# consumer's audit log.
fn test_filestore_roundtrip_quoted_details() {
    var det = str_from("{\"user\":\"bob\",\"n\":1}");
    var e = entry_new(SEV_INFO, str_from("svc"), str_from("act"), det,
      str_from(""));
    var back = _t_fs_roundtrip(e);
    assert(back != 0, "quoted details reparses");
    assert(str_eq(entry_details(back), det) == 1,
      "quoted details survives the round trip verbatim");
    assert(entry_verify(back) == 1,
      "quoted details entry still verifies after reload");
    # And the fields AFTER details must survive too — bayan lost them.
    assert(str_eq(entry_hash(back), entry_hash(e)) == 1,
      "hash field after details survives");
    assert(str_eq(entry_hash_algorithm(back),
        entry_hash_algorithm(e)) == 1,
      "hash_algorithm (last field) survives");
}

# source and action were written unescaped, so a quote produced an
# unparseable line and the entry vanished on reload.
fn test_filestore_roundtrip_quoted_source_action() {
    var e = entry_new(SEV_INFO, str_from("sv\"c"), str_from("a\\ct"),
      str_from("{}"), str_from(""));
    var back = _t_fs_roundtrip(e);
    assert(back != 0, "quoted source/action reparses");
    assert(str_eq(entry_source(back), str_from("sv\"c")) == 1,
      "quoted source survives");
    assert(str_eq(entry_action(back), str_from("a\\ct")) == 1,
      "backslash action survives");
    assert(entry_verify(back) == 1,
      "quoted source/action entry still verifies");
}

# Control bytes must be escaped, not emitted raw — a newline splits the
# JSONL record in two and a CR truncates it for most readers.
fn test_filestore_roundtrip_control_chars() {
    var det = str_from("{\"a\":\"x\ny\tz\"}");
    var e = entry_new(SEV_INFO, str_from("s"), str_from("a"), det,
      str_from(""));
    var sb = str_builder_new();
    _filestore_entry_json(sb, e);
    var line = str_builder_build(sb);
    var ld = str_data(line);
    var ll = str_len(line);
    var raw_nl = 0;
    var i = 0;
    while (i < ll) {
        var c = load8(ld + i) & 0xFF;
        if (c < 32) { raw_nl = 1; }
        i += 1;
    }
    assert(raw_nl == 0, "no raw control byte survives into the JSONL line");
    var back = _filestore_parse_entry(line);
    assert(back != 0, "control-char record reparses");
    assert(str_eq(entry_details(back), det) == 1,
      "control chars survive the round trip");
    assert(entry_verify(back) == 1, "control-char entry verifies");

    # A C0 byte with NO shorthand escape (0x01) must take the \u00XX path.
    # Testing only \n and \t leaves that branch unexercised.
    var raw = alloc(16);
    store8(raw + 0, 123); store8(raw + 1, 34); store8(raw + 2, 97);
    store8(raw + 3, 34);  store8(raw + 4, 58); store8(raw + 5, 34);
    store8(raw + 6, 1);   store8(raw + 7, 34); store8(raw + 8, 125);
    var det2 = str_new(raw, 9);
    var e2 = entry_new(SEV_INFO, str_from("s"), str_from("a"), det2,
      str_from(""));
    var sb2 = str_builder_new();
    _filestore_entry_json(sb2, e2);
    var line2 = str_builder_build(sb2);
    var l2d = str_data(line2);
    var l2l = str_len(line2);
    var raw_ctl = 0;
    var j = 0;
    while (j < l2l) {
        if ((load8(l2d + j) & 0xFF) < 32) { raw_ctl = 1; }
        j += 1;
    }
    assert(raw_ctl == 0, "0x01 is escaped, not emitted raw");
    var back2 = _filestore_parse_entry(line2);
    assert(back2 != 0, "0x01 record reparses");
    assert(str_eq(entry_details(back2), det2) == 1,
      "0x01 survives the round trip via \\u00XX");
    assert(entry_verify(back2) == 1, "0x01 entry verifies");
}

# Any four-character agent_id starting with n was read back as absent.
fn test_filestore_agent_id_not_swallowed() {
    var e = entry_new(SEV_INFO, str_from("s"), str_from("a"),
      str_from("{}"), str_from(""));
    entry_set_agent_id(e, str_from("node"));
    entry_set_hash(e, entry_compute_hash(e));
    var back = _t_fs_roundtrip(e);
    assert(back != 0, "agent_id record reparses");
    assert(entry_agent_id(back) != 0, "agent_id 'node' is not dropped");
    assert(str_eq(entry_agent_id(back), str_from("node")) == 1,
      "agent_id 'node' survives verbatim");
    assert(entry_verify(back) == 1, "agent_id 'node' entry verifies");
    # The genuine "null" literal is still honoured.
    var e2 = entry_new(SEV_INFO, str_from("s"), str_from("a"),
      str_from("{}"), str_from(""));
    entry_set_agent_id(e2, str_from("nine"));
    entry_set_hash(e2, entry_compute_hash(e2));
    var b2 = _t_fs_roundtrip(e2);
    assert(str_eq(entry_agent_id(b2), str_from("nine")) == 1,
      "agent_id 'nine' survives too");

    # 2.8.12 — an agent literally NAMED "null" must survive too. Only the
    # bare JSON literal means absent, and libro's own writer never emits it.
    var e3 = entry_new(SEV_INFO, str_from("s"), str_from("a"),
      str_from("{}"), str_from(""));
    entry_set_agent_id(e3, str_from("null"));
    entry_set_hash(e3, entry_compute_hash(e3));
    var b3 = _t_fs_roundtrip(e3);
    assert(b3 != 0, "agent_id \"null\" record reparses");
    assert(entry_agent_id(b3) != 0,
      "an agent NAMED null is not read as absent");
    assert(str_eq(entry_agent_id(b3), str_from("null")) == 1,
      "agent_id \"null\" survives verbatim");
    assert(entry_verify(b3) == 1, "agent_id \"null\" entry verifies");

    # A foreign producer's bare literal still means absent.
    var bsb = str_builder_new();
    str_builder_add_cstr(bsb, "{\"id\":\"41414141\"");
    str_builder_add_cstr(bsb, ",\"timestamp\":\"2026-01-01T00:00:00Z\"");
    str_builder_add_cstr(bsb, ",\"severity\":\"Info\"");
    str_builder_add_cstr(bsb, ",\"source\":\"s\",\"action\":\"a\"");
    str_builder_add_cstr(bsb, ",\"details\":\"{}\"");
    str_builder_add_cstr(bsb, ",\"agent_id\":null");
    str_builder_add_cstr(bsb, ",\"prev_hash\":\"\",\"hash\":\"ff\"");
    str_builder_add_cstr(bsb, ",\"hash_algorithm\":\"sha256\"}");
    var bare = str_builder_build(bsb);
    var bp = _filestore_parse_entry(bare);
    assert(bp != 0, "bare-null agent_id record reparses");
    assert(entry_agent_id(bp) == 0, "a bare JSON null agent_id is absent");
}

# A record missing timestamp or prev_hash stored a NULL Str and every later
# str_len() on it segfaulted the process.
fn test_filestore_rejects_null_fields() {
    var no_ts = _t_rec(0, 1);
    assert(_filestore_parse_entry(no_ts) == 0,
      "record with no timestamp is rejected, not stored as NULL");
    var no_ph = _t_rec(1, 0);
    assert(_filestore_parse_entry(no_ph) == 0,
      "record with no prev_hash is rejected");
    assert(_filestore_parse_entry(str_from("not json")) == 0,
      "non-object line is rejected");
    assert(_filestore_parse_entry(str_from("{\"a\":\"b\" \"c\":\"d\"}")) == 0,
      "missing comma is rejected");
}

# A short "id" left the 16 UUID bytes as recycled freelist memory, and those
# bytes are the first thing entry_compute_hash feeds — so the same record
# parsed twice produced two different hashes.
fn test_filestore_short_uuid_is_deterministic() {
    var line = _t_rec(1, 1);
    # Dirty the freelist between the two parses so residue would differ.
    var d1 = fl_alloc(88);
    memset(d1, 0x11, 88);
    fl_free(d1);
    var a = _filestore_parse_entry(line);
    var ha = entry_compute_hash(a);
    var d2 = fl_alloc(88);
    memset(d2, 0x77, 88);
    fl_free(d2);
    var b = _filestore_parse_entry(line);
    var hb = entry_compute_hash(b);
    assert(str_eq(ha, hb) == 1,
      "short uuid hashes deterministically, not over freelist residue");
    var idb = entry_id(b);
    var zeros = 1;
    var i = 4;
    while (i < 16) {
        if ((load8(idb + i) & 0xFF) != 0) { zeros = 0; }
        i += 1;
    }
    assert(zeros == 1, "unparsed uuid bytes are zero-filled");
}

# ── Error-signalling regressions (2.8.11) ──

# The discriminator itself: an error must be distinguishable from a value.
fn test_libro_is_error_discriminates() {
    var err = error_new(LIBRO_ERR_IO, "boom");
    assert(libro_is_error(err) == 1, "error object is recognised");
    assert(libro_is_ok(err) == 0, "error object is not ok");
    assert(libro_is_error(error_integrity(1, str_from("a"), str_from("b"))) == 1,
      "integrity error is recognised");
    assert(libro_is_error(error_field("f", 9, 4)) == 1,
      "field error is recognised");

    var e = entry_new(SEV_INFO, str_from("s"), str_from("a"),
      str_from("{}"), str_from(""));
    assert(libro_is_error(e) == 0, "an entry is not an error");
    assert(libro_is_ok(e) == 1, "an entry is ok");
    assert(libro_is_error(vec_new()) == 0, "a vec is not an error");
    assert(libro_is_error(0) == 0, "null is not an error");
    assert(libro_is_ok(0) == 0, "null is not ok either");

    # 2.8.12 — the predicate must be safe on the SMALL INTEGERS the
    # count-returning verify APIs hand back on success. Before the guard,
    # libro_is_error(5) dereferenced address 5.
    assert(libro_is_error(1) == 0, "a count of 1 is not an error");
    assert(libro_is_error(5) == 0, "a count of 5 is not an error");
    assert(libro_is_error(65535) == 0, "a near-threshold count is not an error");
    assert(libro_is_error(0 - 1) == 0, "a negative sentinel is not an error");
    assert(libro_is_error(err + 1) == 0, "a misaligned pointer is not an error");

    # And the documented usage on a real count-returning API must not crash.
    sys_unlink("/tmp/libro_cnt_2812.jsonl");
    var fsc = filestore_open(str_from("/tmp/libro_cnt_2812.jsonl"));
    var c = chain_new();
    var det2 = str_from("{}");
    var k = 0;
    while (k < 3) {
        var ce = chain_append(c, SEV_INFO, str_from("s"), str_from("a"), det2);
        filestore_append(fsc, ce);
        k += 1;
    }
    var sv = filestore_verify_streamed(fsc, 10);
    assert(libro_is_error(sv) == 0, "a successful streamed verify is not an error");
    assert(sv == 3, "streamed verify counted all three entries");
    sys_unlink("/tmp/libro_cnt_2812.jsonl");
}

# entry_new_validated returns an error struct on rejection — the same
# non-zero pointer shape as a valid entry, whose fields then read as a
# max-severity entry. It must now be detectable.
fn test_entry_new_validated_error_detectable() {
    var sb = str_builder_new();
    var i = 0;
    while (i < 2000) { str_builder_add_cstr(sb, "x"); i += 1; }
    var too_long = str_builder_build(sb);
    var r = entry_new_validated(SEV_INFO, too_long, str_from("a"),
      str_from("{}"), str_from(""));
    assert(r != 0, "over-long source still returns non-zero (the trap)");
    assert(libro_is_error(r) == 1,
      "over-long source result is detectable as an error");
    assert(error_code(r) == LIBRO_ERR_FIELD_TOO_LONG, "code is FIELD_TOO_LONG");

    var ok = entry_new_validated(SEV_INFO, str_from("s"), str_from("a"),
      str_from("{}"), str_from(""));
    assert(libro_is_ok(ok) == 1, "valid entry is ok");
}

# An unreadable log must not verify clean.
fn test_filestore_unreadable_is_not_success() {
    var s = filestore_open(str_from("/nonexistent-dir-libro/x.jsonl"));
    var r = filestore_load_all_or_err(s);
    assert(libro_is_error(r) == 1,
      "unreadable log reports an error, not an empty vec");
    assert(error_code(r) == LIBRO_ERR_IO, "code is IO");

    var v = filestore_load_and_verify(s);
    assert(libro_is_error(v) == 1,
      "load_and_verify on an unreadable log is an error, not success");

    var sv = filestore_verify_streamed(s, 10);
    assert(libro_is_error(sv) == 1,
      "verify_streamed on an unreadable log is an error, not the count 0");
}

# A genuinely empty log is still a clean success — the fix must not turn
# "empty" into "error".
fn test_filestore_empty_is_still_success() {
    sys_unlink("/tmp/libro_empty_2811.jsonl");
    var s = filestore_open(str_from("/tmp/libro_empty_2811.jsonl"));
    var r = filestore_load_all_or_err(s);
    assert(libro_is_error(r) == 0, "empty log is not an error");
    assert(vec_len(r) == 0, "empty log has no entries");
    var sv = filestore_verify_streamed(s, 10);
    assert(libro_is_error(sv) == 0, "empty log verifies clean");
    assert(sv == 0, "empty log verifies 0 entries");
    sys_unlink("/tmp/libro_empty_2811.jsonl");
}

# A streaming chain has a real head; chain_head_hash returned 0 for it, so an
# anchor built from one bound to nothing and still verified.
fn test_streaming_chain_has_head_hash() {
    var c = chain_new_streaming();
    var e = chain_append(c, SEV_INFO, str_from("s"), str_from("a"),
      str_from("{}"));
    assert(chain_len(c) == 0, "streaming chain retains nothing");
    var h = chain_head_hash(c);
    assert(h != 0, "streaming chain reports a head hash");
    assert(str_len(h) == 64, "streaming head hash is a 64-char digest");

    var c2 = chain_new();
    assert(chain_head_hash(c2) == 0, "empty retaining chain still has no head");
}

# The read path must bind its parameter, not interpolate it.
fn test_patrastore_by_source_is_bound() {
    sys_unlink("/tmp/libro_ps_inj.patra");
    var ps = patrastore_open(str_from("/tmp/libro_ps_inj.patra"));
    var det = str_from("{}");
    var prev = libro_empty_str();

    var quoted = str_from("o'brien");
    var e1 = entry_new(SEV_INFO, quoted, str_from("a"), det, prev);
    patrastore_append(ps, e1);
    prev = entry_hash(e1);
    var e2 = entry_new(SEV_INFO, str_from("other"), str_from("a"), det, prev);
    patrastore_append(ps, e2);

    # A quote in the predicate used to produce malformed SQL and zero rows.
    var got = patrastore_by_source(ps, quoted);
    assert(vec_len(got) == 1, "source containing a quote matches its own row");
    assert(str_eq(entry_source(vec_get(got, 0)), quoted) == 1,
      "matched row is the right one");

    # A classic widening payload must match NOTHING, not the whole table.
    var inj = patrastore_by_source(ps, str_from("x' OR '1'='1"));
    assert(vec_len(inj) == 0,
      "injection payload matches no rows instead of dumping the table");

    patrastore_close(ps);
    sys_unlink("/tmp/libro_ps_inj.patra");
    sys_unlink("/tmp/libro_ps_inj.patra.wal");
}

# ── Robustness regressions (2.8.11) ──

fn test_query_parse_ts_validates() {
    assert(_query_parse_ts(str_from("2026-08-22T10:00:00Z")) == 1787392800,
      "well-formed timestamp still parses");
    assert(_query_parse_ts(str_from("")) == QUERY_TS_INVALID,
      "empty timestamp rejected, not read 20 bytes past the Str");
    assert(_query_parse_ts(str_from("2026")) == QUERY_TS_INVALID,
      "short timestamp rejected");
    assert(_query_parse_ts(str_from("not-a-timestamp!!!!!")) == QUERY_TS_INVALID,
      "non-digit timestamp rejected");
    assert(_query_parse_ts(str_from("2026-08-22 10:00:00Z")) == QUERY_TS_INVALID,
      "wrong separator rejected");
    assert(_query_parse_ts(str_from("2026-13-22T10:00:00Z")) == QUERY_TS_INVALID,
      "month 13 rejected");
    assert(_query_parse_ts(str_from("2026-08-22T25:00:00Z")) == QUERY_TS_INVALID,
      "hour 25 rejected");
    assert(_query_parse_ts(0) == QUERY_TS_INVALID, "null timestamp rejected");
    # Every separator is in the right place here; only the LENGTH check can
    # reject it. Without that check the trailing byte is silently ignored and
    # a 21-byte value parses as if it were 20.
    assert(_query_parse_ts(str_from("2026-08-22T10:00:00Z9")) == QUERY_TS_INVALID,
      "over-long timestamp rejected by the length check");
}

# A record whose time cannot be established must not be reported as falling
# inside a queried window, and must not be selected for deletion.
fn test_bad_timestamp_fails_closed() {
    var e = entry_new(SEV_INFO, str_from("s"), str_from("a"),
      str_from("{}"), str_from(""));
    entry_set_timestamp(e, str_from("garbage"));
    var q = query_new();
    query_after(q, 1);
    assert(query_matches(q, e) == 0,
      "unparseable timestamp matches no after-window");
    var q2 = query_new();
    query_before(q2, 9999999999);
    assert(query_matches(q2, e) == 0,
      "unparseable timestamp matches no before-window");

    var entries = vec_new();
    vec_push(entries, e);
    assert(_retention_first_after(entries, 0) == 0,
      "unparseable timestamp is retained, never expired");
}

# A hybrid key has two public keys; the single-buffer constructor used to
# build one over a ZERO-BYTE allocation and hand it to ed25519_verify.
fn test_verifying_key_from_bytes_alg_rejects_hybrid() {
    var buf = alloc(64);
    memset(buf, 0x41, 64);
    assert(verifying_key_from_bytes_alg(buf, SIG_ALG_HYBRID) == 0,
      "hybrid rejected by the single-algorithm constructor");
    assert(verifying_key_from_bytes_alg(buf, 999) == 0,
      "unknown algorithm rejected");
    assert(verifying_key_from_bytes_alg(0, SIG_ALG_ED25519) == 0,
      "null bytes rejected");
    assert(verifying_key_from_bytes_alg(buf, SIG_ALG_ED25519) != 0,
      "ed25519 still constructs");
}

# A malformed or absent signature must be rejected before it reaches the
# crypto boundary, not decoded into an undersized buffer and read past.
fn test_signature_length_validated() {
    var sk = signing_key_generate();
    var vk = verifying_key_from_signing(sk);
    var root = str_from("aa");
    assert(verify_tree_head(vk, root, str_from("")) == 0,
      "empty signature rejected");
    assert(verify_tree_head(vk, root, str_from("ff")) == 0,
      "2-char signature rejected");
    assert(verify_tree_head(vk, root, 0) == 0, "null signature rejected");
    assert(verify_tree_head(0, root, str_from("ff")) == 0, "null key rejected");
    assert(verify_tree_head(vk, str_from(""), str_from("ff")) == 0,
      "empty root rejected");
    # And a real signature still verifies.
    var real_root = str_from("0123456789abcdef");
    var sig = sign_tree_head(sk, real_root);
    assert(verify_tree_head(vk, real_root, sig) == 1,
      "a genuine tree-head signature still verifies");
}

# Junk DER must not become a granted attestation.
fn test_ts_response_rejects_junk_der() {
    var junk = alloc(32);
    memset(junk, 0x41, 32);
    var r = ts_response_from_der(junk, 32);
    assert(ts_status_is_granted(ts_response_status(r)) == 0,
      "junk DER is not a granted response");

    # The above is rejected on LENGTH alone, so it cannot tell whether tags
    # are checked. This one is length-consistent all the way down and decodes
    # to status 0 (= TS_GRANTED); only the tag check stops it. Every tag is
    # 0x41 where DER requires 0x30 (SEQUENCE) / 0x02 (INTEGER).
    var forged = alloc(32);
    memset(forged, 0x41, 32);
    store8(forged + 0, 0x41); store8(forged + 1, 0x1E);   # "outer", len 30
    store8(forged + 2, 0x41); store8(forged + 3, 0x03);   # "statusinfo", len 3
    store8(forged + 4, 0x41); store8(forged + 5, 0x01);   # "status", len 1
    store8(forged + 6, 0x00);                             # value 0 = GRANTED
    var r2 = ts_response_from_der(forged, 32);
    assert(ts_status_is_granted(ts_response_status(r2)) == 0,
      "length-consistent junk with wrong DER tags is not granted");
    assert(ts_attestation_new(str_from("hh"), TS_MERKLE_ROOT, TS_SHA256, r2) == 0,
      "wrong-tag response yields no attestation");
    assert(ts_attestation_new(str_from("hh"), TS_MERKLE_ROOT, TS_SHA256, r) == 0,
      "junk DER yields no attestation");
    assert(ts_attestation_new(str_from("hh"), TS_MERKLE_ROOT, TS_SHA256, 0) == 0,
      "null response yields no attestation");
}

# A headerless JSONL must not import with its genesis entry silently eaten.
fn test_chain_import_requires_header() {
    var c = chain_new();
    var det = str_from("{}");
    var i = 0;
    while (i < 3) {
        chain_append(c, SEV_INFO, str_from("s"), str_from("a"), det);
        i += 1;
    }
    sys_unlink("/tmp/libro_hdr_2811.jsonl");
    chain_export(c, str_from("/tmp/libro_hdr_2811.jsonl"));
    var ok = chain_import(str_from("/tmp/libro_hdr_2811.jsonl"));
    assert(ok != 0, "exported chain re-imports");
    assert(chain_len(ok) == 3, "all three entries import");

    # Now a plain FileStore log — same entry shape, NO header line.
    sys_unlink("/tmp/libro_nohdr_2811.jsonl");
    var fs = filestore_open(str_from("/tmp/libro_nohdr_2811.jsonl"));
    var entries = chain_entries(c);
    var j = 0;
    while (j < vec_len(entries)) {
        filestore_append(fs, vec_get(entries, j));
        j += 1;
    }
    var bad = chain_import(str_from("/tmp/libro_nohdr_2811.jsonl"));
    assert(bad == 0,
      "headerless log is rejected, not imported minus its genesis entry");

    sys_unlink("/tmp/libro_hdr_2811.jsonl");
    sys_unlink("/tmp/libro_nohdr_2811.jsonl");
}

# ── Tree-head signature coverage (2.8.12) ──
#
# Through 2.8.11 sign_tree_head signed the ROOT ALONE, so tree_size,
# timestamp and algorithm rode along unauthenticated. The timestamp was the
# sharp one: no verifier ever looked at it, so a holder of a valid proof could
# restate when the log was attested and it still verified.
fn test_tree_head_signature_covers_whole_head() {
    var c = chain_new();
    var det = str_from("{}");
    var i = 0;
    while (i < 4) {
        chain_append(c, SEV_INFO, str_from("s"), str_from("a"), det);
        i += 1;
    }
    var sk = signing_key_generate();
    var vk = verifying_key_from_signing(sk);
    var ip = proof_build_signed(c, sk);
    var sth = iproof_tree_head(ip);

    assert(pv_tree_head_valid(proof_verify_signed(ip, vk)) == 1,
      "an untampered signed head verifies");

    # Tamper the TIMESTAMP only. Root, size and signature untouched.
    var real_ts = sth_timestamp(sth);
    sth_set_timestamp(sth, str_from("1999-01-01T00:00:00Z"));
    assert(pv_tree_head_valid(proof_verify_signed(ip, vk)) == 0,
      "restating the tree-head timestamp breaks the signature");
    sth_set_timestamp(sth, real_ts);
    assert(pv_tree_head_valid(proof_verify_signed(ip, vk)) == 1,
      "restoring the timestamp restores validity");

    # Tamper the TREE SIZE only.
    var real_size = sth_tree_size(sth);
    sth_set_tree_size(sth, real_size + 1);
    assert(pv_tree_head_valid(proof_verify_signed(ip, vk)) == 0,
      "restating the tree size breaks the signature");
    sth_set_tree_size(sth, real_size);

    # Tamper the ALGORITHM name only.
    var real_alg = sth_algorithm(sth);
    sth_set_algorithm(sth, str_from("ML-DSA-65"));
    assert(pv_tree_head_valid(proof_verify_signed(ip, vk)) == 0,
      "restating the algorithm breaks the signature");
    sth_set_algorithm(sth, real_alg);

    # And the root, which was already covered.
    var real_root = sth_root(sth);
    sth_set_root(sth, str_from("00"));
    assert(pv_tree_head_valid(proof_verify_signed(ip, vk)) == 0,
      "restating the root breaks the signature");
    sth_set_root(sth, real_root);
    assert(pv_tree_head_valid(proof_verify_signed(ip, vk)) == 1,
      "head is intact again");
}

# tree_head_digest must be injective over its four fields — a length prefix on
# each is what stops (root="ab", ts="c") colliding with (root="a", ts="bc").
fn test_tree_head_digest_is_unambiguous() {
    # The boundary that can actually shift is between the two ADJACENT
    # variable-length fields, timestamp and algorithm. Root is separated from
    # timestamp by the fixed-width 8-byte size, so a shift there cannot
    # collide and testing it proves nothing about the length prefixes.
    var a = tree_head_digest(str_from("r"), 1, str_from("ab"), str_from("X"));
    var b = tree_head_digest(str_from("r"), 1, str_from("a"), str_from("bX"));
    assert(str_eq(a, b) == 0,
      "timestamp/algorithm boundary is unambiguous (length-prefixed)");
    var a2 = tree_head_digest(str_from("ab"), 1, str_from("c"), str_from("X"));
    var b2 = tree_head_digest(str_from("a"), 1, str_from("bc"), str_from("X"));
    assert(str_eq(a2, b2) == 0, "root/timestamp boundary is unambiguous");
    var c1 = tree_head_digest(str_from("r"), 1, str_from("t"), str_from("X"));
    var c2 = tree_head_digest(str_from("r"), 2, str_from("t"), str_from("X"));
    assert(str_eq(c1, c2) == 0, "tree size changes the digest");
    var c3 = tree_head_digest(str_from("r"), 1, str_from("t"), 0);
    assert(str_eq(c1, c3) == 0, "absent algorithm differs from a present one");
}

# A signed proof must survive JSON round-trip with its signature intact —
# which only works if the parser rebuilds the head with the SIGNED timestamp.
fn test_signed_proof_json_roundtrip_verifies() {
    var c = chain_new();
    var det = str_from("{}");
    var i = 0;
    while (i < 3) {
        chain_append(c, SEV_INFO, str_from("s"), str_from("a"), det);
        i += 1;
    }
    var sk = signing_key_generate();
    var vk = verifying_key_from_signing(sk);
    var ip = proof_build_signed(c, sk);
    var j = proof_to_json(ip);
    var ip2 = proof_from_json(j);
    assert(ip2 != 0, "signed proof reparses");
    var sth2 = iproof_tree_head(ip2);
    assert(str_eq(sth_timestamp(sth2), sth_timestamp(iproof_tree_head(ip))) == 1,
      "timestamp survives the round trip");
    assert(pv_tree_head_valid(proof_verify_signed(ip2, vk)) == 1,
      "a signed head still verifies after a JSON round trip");
    # And re-emitting it does not crash (the 2.8.11 algorithm-slot defect).
    assert(str_len(proof_to_json(ip2)) > 0, "signed proof re-emits");
}

# ── Crash-class regressions (2.8.12) ──
#
# hex_decode returns 0 for a non-hex character, so the 2.8.11 guard — which
# checked only the LENGTH — let a correct-length non-hex signature decode to a
# null pointer that went straight to ed25519_verify / mldsa65_verify.
fn _t_hexish(n, c) {
    var sb = str_builder_new();
    var i = 0;
    while (i < n) { str_builder_add_cstr(sb, c); i += 1; }
    return str_builder_build(sb);
}

fn test_non_hex_signature_rejected() {
    var sk = signing_key_generate();
    var vk = verifying_key_from_signing(sk);
    var root = str_from("0123456789abcdef");
    # 128 hex chars is the correct Ed25519 signature length; 'z' is not hex.
    assert(verify_tree_head(vk, root, _t_hexish(128, "z")) == 0,
      "correct-length non-hex tree-head signature rejected, not dereferenced");
    assert(verify_tree_head(vk, root, _t_hexish(127, "a")) == 0,
      "odd-length signature rejected");
    assert(verify_tree_head(vk, root, _t_hexish(128, "a")) == 0,
      "well-formed but wrong signature rejected");
    var good = sign_tree_head(sk, root);
    assert(verify_tree_head(vk, root, good) == 1, "a real signature still verifies");

    # ML-DSA too — a different sigil entry point, same null-pointer hazard.
    var sk2 = signing_key_generate_mldsa();
    var vk2 = verifying_key_from_signing(sk2);
    assert(verify_tree_head(vk2, root, _t_hexish(6544, "z")) == 0,
      "correct-length non-hex ML-DSA signature rejected, not dereferenced");
}

# Every JSONL field must survive a quote, not just the four 2.8.11 escaped.
fn test_filestore_all_fields_escaped() {
    var e = entry_new(SEV_INFO, str_from("s"), str_from("a"),
      str_from("{}"), str_from(""));
    entry_set_timestamp(e, str_from("ts\"x"));
    entry_set_prev_hash(e, str_from("pv\"x"));
    entry_set_hash_algorithm(e, str_from("alg\"x"));
    entry_set_hash(e, entry_compute_hash(e));
    # A quote in the hash itself, set after the fact, must still round-trip.
    var back = _t_fs_roundtrip(e);
    assert(back != 0, "record with quotes in timestamp/prev_hash/alg reparses");
    assert(str_eq(entry_timestamp(back), str_from("ts\"x")) == 1,
      "quoted timestamp survives");
    assert(str_eq(entry_prev_hash(back), str_from("pv\"x")) == 1,
      "quoted prev_hash survives");
    assert(str_eq(entry_hash_algorithm(back), str_from("alg\"x")) == 1,
      "quoted hash_algorithm survives");
    assert(entry_verify(back) == 1, "the reloaded entry still verifies");

    var e2 = entry_new(SEV_INFO, str_from("s"), str_from("a"),
      str_from("{}"), str_from(""));
    entry_set_hash(e2, str_from("hh\"x"));
    var b2 = _t_fs_roundtrip(e2);
    assert(b2 != 0, "record with a quoted hash reparses");
    assert(str_eq(entry_hash(b2), str_from("hh\"x")) == 1,
      "quoted hash survives verbatim");
}

fn test_non_hex_entry_signature_rejected() {
    var e = entry_new(SEV_INFO, str_from("s"), str_from("a"),
      str_from("{}"), str_from(""));
    var sk = signing_key_generate();
    var vk = verifying_key_from_signing(sk);
    var es = sign_entry(sk, e);
    assert(verify_entry_signature(vk, e, es) == 1, "a real entry signature verifies");
    entry_sig_set_signature(es, _t_hexish(128, "z"));
    assert(verify_entry_signature(vk, e, es) == 0,
      "correct-length non-hex entry signature rejected, not dereferenced");
    entry_sig_set_signature(es, str_from(""));
    assert(verify_entry_signature(vk, e, es) == 0, "empty entry signature rejected");
}

# The HYBRID arm skipped the 2.8.11 length guard entirely.
fn test_hybrid_signature_validated() {
    var sk = signing_key_generate_hybrid();
    var vk = verifying_key_from_signing(sk);
    var root = str_from("0123456789abcdef");
    var good = sign_tree_head(sk, root);
    assert(verify_tree_head(vk, root, good) == 1, "a real hybrid signature verifies");
    assert(verify_tree_head(vk, root, str_from("zz|zz")) == 0,
      "short non-hex hybrid halves rejected");
    assert(verify_tree_head(vk, root, str_from("nopipehere")) == 0,
      "hybrid signature with no delimiter rejected");
    var sb = str_builder_new();
    str_builder_add(sb, _t_hexish(128, "z"));
    str_builder_add_cstr(sb, "|");
    str_builder_add(sb, _t_hexish(6544, "z"));
    assert(verify_tree_head(vk, root, str_builder_build(sb)) == 0,
      "correct-length non-hex hybrid halves rejected");
}

# Front-truncation: deleting entries from the START of a stored log left a vec
# where every entry self-hashed and every surviving link matched, so it
# verified completely clean.
fn test_front_truncation_detected() {
    var c = chain_new();
    var det = str_from("{}");
    var i = 0;
    while (i < 5) {
        chain_append(c, SEV_INFO, str_from("s"), str_from("a"), det);
        i += 1;
    }
    var full = chain_entries(c);
    assert(verify_chain(full, 0) == 0, "the intact chain verifies");

    # Drop the first two entries, exactly as an attacker trimming a log would.
    var trimmed = vec_new();
    var j = 2;
    while (j < vec_len(full)) { vec_push(trimmed, vec_get(full, j)); j += 1; }
    assert(libro_is_error(verify_chain(trimmed, 0)) == 1,
      "a front-truncated chain is rejected");

    # A genuine mid-chain segment is still verifiable when the caller says so.
    var first_kept = vec_get(trimmed, 0);
    assert(verify_chain_from(trimmed, 2, entry_prev_hash(first_kept)) == 0,
      "an explicit mid-chain segment still verifies");
}

fn test_merkle_consistency() {
    var c = chain_new();
    var det = str_from("{}");
    var i = 0;
    while (i < 4) {
        chain_append(c, SEV_INFO, str_from("s"), str_from("a"), det);
        i += 1;
    }
    var tree4 = merkle_build(chain_entries(c));

    # Add more entries
    while (i < 8) {
        chain_append(c, SEV_INFO, str_from("s"), str_from("a"), det);
        i += 1;
    }
    var tree8 = merkle_build(chain_entries(c));

    var cp = merkle_consistency_proof(tree8, 4);
    assert(cp != 0, "consistency proof exists");
    assert(merkle_verify_consistency(cp) == 1, "consistency proof verifies");
}

