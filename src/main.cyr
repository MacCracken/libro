# ================================================================
# Streaming tests
# ================================================================

fn test_stream_publish_subscribe() {
    var s = stream_new();
    var rx = stream_subscribe(s, "libro/#");

    # Create an entry and publish
    var e = entry_new(SEV_INFO, str_from("daimon"), str_from("agent.start"), str_from("{}"), str_from(""));
    stream_publish(s, e);

    assert_eq(stream_published(s), 1, "stream 1 published");
    assert_eq(stream_pending(rx), 1, "stream 1 pending");
    var got = stream_recv(rx);
    assert_eq(got, e, "stream recv matches");
    assert_eq(stream_pending(rx), 0, "stream 0 after recv");
    return 0;
}

fn test_stream_filtered_by_source() {
    var s = stream_new();
    var rx_daimon = stream_subscribe(s, "libro/daimon/#");
    var rx_aegis = stream_subscribe(s, "libro/aegis/#");

    var e1 = entry_new(SEV_INFO, str_from("daimon"), str_from("start"), str_from("{}"), str_from(""));
    var e2 = entry_new(SEV_SECURITY, str_from("aegis"), str_from("alert"), str_from("{}"), str_from(""));
    stream_publish(s, e1);
    stream_publish(s, e2);

    assert_eq(stream_pending(rx_daimon), 1, "daimon got 1");
    assert_eq(stream_pending(rx_aegis), 1, "aegis got 1");
    var d = stream_recv(rx_daimon);
    assert_eq(d, e1, "daimon entry");
    var a = stream_recv(rx_aegis);
    assert_eq(a, e2, "aegis entry");
    return 0;
}

fn test_stream_action_wildcard() {
    var s = stream_new();
    var rx = stream_subscribe(s, "libro/*/alert");

    var e1 = entry_new(SEV_INFO, str_from("daimon"), str_from("start"), str_from("{}"), str_from(""));
    var e2 = entry_new(SEV_SECURITY, str_from("aegis"), str_from("alert"), str_from("{}"), str_from(""));
    stream_publish(s, e1);
    stream_publish(s, e2);

    # Only the alert should be delivered
    assert_eq(stream_pending(rx), 1, "wildcard got 1");
    var got = stream_recv(rx);
    assert_eq(got, e2, "wildcard is alert");
    return 0;
}

fn test_stream_no_match() {
    var s = stream_new();
    var rx = stream_subscribe(s, "libro/aegis/#");

    var e = entry_new(SEV_INFO, str_from("daimon"), str_from("start"), str_from("{}"), str_from(""));
    stream_publish(s, e);

    assert_eq(stream_pending(rx), 0, "no match 0 pending");
    return 0;
}

fn test_stream_custom_prefix() {
    var s = stream_with_prefix("audit/prod");
    var rx = stream_subscribe(s, "audit/prod/#");

    var e = entry_new(SEV_INFO, str_from("daimon"), str_from("start"), str_from("{}"), str_from(""));
    stream_publish(s, e);

    assert_eq(stream_pending(rx), 1, "custom prefix delivered");
    return 0;
}

fn test_stream_multiple_entries() {
    var s = stream_new();
    var rx = stream_subscribe(s, "libro/#");

    var i = 0;
    while (i < 5) {
        var e = entry_new(SEV_INFO, str_from("src"), str_from("evt"), str_from("{}"), str_from(""));
        stream_publish(s, e);
        i = i + 1;
    }

    assert_eq(stream_published(s), 5, "5 published");
    assert_eq(stream_pending(rx), 5, "5 pending");
    return 0;
}

# ================================================================
# FileStore tests
# ================================================================

fn test_filestore_append_load() {
    var path = str_from("/tmp/libro_test_fs.jsonl");
    # Clean up from prior runs
    sys_unlink("/tmp/libro_test_fs.jsonl");

    var fs = filestore_open(path);
    assert(fs != 0, "filestore open");

    # Append entries
    var det = str_from("{}");
    var e1 = entry_new(SEV_INFO, str_from("src"), str_from("act1"), det, str_from(""));
    filestore_append(fs, e1);
    var e2 = entry_new(SEV_WARNING, str_from("src"), str_from("act2"), det, entry_hash(e1));
    filestore_append(fs, e2);

    # Check file len before loading
    var flen = filestore_len(fs);
    assert(flen == 2, "filestore has 2 lines");

    # Load and check count
    var loaded = filestore_load_all(fs);
    var lcount = vec_len(loaded);
    assert(lcount == 2, "filestore loaded 2 entries");

    if (lcount >= 2) {
        # Verify hashes match
        var le1 = vec_get(loaded, 0);
        var le2 = vec_get(loaded, 1);
        assert(str_eq(entry_hash(le1), entry_hash(e1)) == 1, "filestore hash preserved");
        assert(entry_severity(le2) == SEV_WARNING, "filestore severity preserved");
    }

    sys_unlink("/tmp/libro_test_fs.jsonl");
}

fn test_filestore_verify() {
    var path = str_from("/tmp/libro_test_fsv.jsonl");
    sys_unlink("/tmp/libro_test_fsv.jsonl");

    var fs = filestore_open(path);
    var det = str_from("{}");
    var prev = str_from("");
    var i = 0;
    while (i < 3) {
        var e = entry_new(SEV_INFO, str_from("s"), str_from("a"), det, prev);
        filestore_append(fs, e);
        prev = entry_hash(e);
        i = i + 1;
    }

    var result = filestore_load_and_verify(fs);
    assert(vec_len(result) == 3, "filestore verify returns 3 entries");

    sys_unlink("/tmp/libro_test_fsv.jsonl");
}

fn test_filestore_query() {
    var path = str_from("/tmp/libro_test_fsq.jsonl");
    sys_unlink("/tmp/libro_test_fsq.jsonl");

    var fs = filestore_open(path);
    var det = str_from("{}");
    var e1 = entry_new(SEV_INFO, str_from("auth"), str_from("login"), det, str_from(""));
    filestore_append(fs, e1);
    var e2 = entry_new(SEV_ERROR, str_from("audit"), str_from("fail"), det, entry_hash(e1));
    filestore_append(fs, e2);

    var q = query_new();
    query_source(q, str_from("audit"));
    var results = filestore_query(fs, q);
    assert(vec_len(results) == 1, "filestore query filters");

    sys_unlink("/tmp/libro_test_fsq.jsonl");
}

fn test_filestore_empty() {
    var path = str_from("/tmp/libro_test_fse.jsonl");
    sys_unlink("/tmp/libro_test_fse.jsonl");

    var fs = filestore_open(path);
    assert(filestore_is_empty(fs) == 1, "filestore empty");
    assert(filestore_len(fs) == 0, "filestore len 0");

    sys_unlink("/tmp/libro_test_fse.jsonl");
}

# ================================================================
# Gap coverage tests
# ================================================================

fn test_retention_keep_duration() {
    var det = str_from("{}");
    var entries = vec_new();
    var prev = str_from("");
    var i = 0;
    while (i < 5) {
        var e = entry_new(SEV_INFO, str_from("s"),
        str_from("a"), det, prev);
        vec_push(entries, e);
        prev = entry_hash(e);
        i = i + 1;
    }
    var r = retention_keep_duration(0);
    var split = retention_split_index(r, entries);
    assert(split == 5, "keep_duration(0) archives all");
}

fn test_retention_keep_after() {
    var det = str_from("{}");
    var entries = vec_new();
    var prev = str_from("");
    var i = 0;
    while (i < 3) {
        var e = entry_new(SEV_INFO, str_from("s"),
        str_from("a"), det, prev);
        vec_push(entries, e);
        prev = entry_hash(e);
        i = i + 1;
    }
    var r = retention_keep_after(0);
    var split = retention_split_index(r, entries);
    assert(split == 0, "keep_after(0) keeps all");
}

fn test_retention_keep_duration_future() {
    var det = str_from("{}");
    var entries = vec_new();
    var prev = str_from("");
    var i = 0;
    while (i < 3) {
        var e = entry_new(SEV_INFO, str_from("s"),
        str_from("a"), det, prev);
        vec_push(entries, e);
        prev = entry_hash(e);
        i = i + 1;
    }
    var r = retention_keep_duration(365 * 86400);
    var split = retention_split_index(r, entries);
    assert(split == 0, "keep_duration(1yr) keeps all");
}

fn test_query_time_range() {
    var det = str_from("{}");
    var e1 = entry_new(SEV_INFO, str_from("s"),
    str_from("a"), det, str_from(""));
    var e2 = entry_new(SEV_INFO, str_from("s"),
    str_from("a"), det, entry_hash(e1));
    var entries = vec_new();
    vec_push(entries, e1);
    vec_push(entries, e2);
    var q = query_new();
    query_after(q, 0);
    var results = query_apply(q, entries);
    assert(vec_len(results) == 2, "query after epoch 0");
    var q2 = query_new();
    query_after(q2, 9999999999);
    var r2 = query_apply(q2, entries);
    assert(vec_len(r2) == 0, "query after future");
    var q3 = query_new();
    query_before(q3, 9999999999);
    var r3 = query_apply(q3, entries);
    assert(vec_len(r3) == 2, "query before future");
}

fn test_query_agent_id() {
    var det = str_from("{}");
    var e1 = entry_new(SEV_INFO, str_from("s"),
    str_from("a"), det, str_from(""));
    entry_with_agent(e1, str_from("bot-1"));
    var e2 = entry_new(SEV_INFO, str_from("s"),
    str_from("a"), det, entry_hash(e1));
    var entries = vec_new();
    vec_push(entries, e1);
    vec_push(entries, e2);
    var q = query_new();
    query_agent_id(q, str_from("bot-1"));
    var results = query_apply(q, entries);
    assert(vec_len(results) == 1, "query agent_id");
}

fn test_export_csv_special_chars() {
    var c = chain_new();
    chain_append(c, SEV_INFO,
    str_from("src,commas"),
    str_from("act"), str_from("{}"));
    var fd = file_open("/dev/null", 1, 0);
    export_csv(chain_entries(c), fd);
    file_close(fd);
    assert(1 == 1, "csv special chars no crash");
}

fn test_entry_validated_too_long() {
    var long_src = alloc(2048);
    memset(long_src, 65, 2048);
    store8(long_src + 2048, 0);
    var s = str_new(long_src, 2048);
    var result = entry_new_validated(SEV_INFO, s,
    str_from("a"), str_from("{}"), str_from(""));
    assert(error_code(result) == ERR_FIELD_TOO_LONG,
    "validated rejects long source");
}

fn test_chain_by_agent() {
    var c = chain_new();
    var det = str_from("{}");
    chain_append_with_agent(c, SEV_INFO,
    str_from("s"), str_from("a"),
    det, str_from("agent-x"));
    chain_append(c, SEV_INFO,
    str_from("s"), str_from("a"), det);
    chain_append_with_agent(c, SEV_INFO,
    str_from("s"), str_from("a"),
    det, str_from("agent-x"));
    var results = chain_by_agent(c, str_from("agent-x"));
    assert(vec_len(results) == 2, "chain by_agent");
}

fn test_merkle_large_tree() {
    var c = chain_new();
    var det = str_from("{}");
    var i = 0;
    while (i < 16) {
        chain_append(c, SEV_INFO, str_from("s"),
        str_from("a"), det);
        i = i + 1;
    }
    var tree = merkle_build(chain_entries(c));
    assert(merkle_tree_leaf_count(tree) == 16,
    "merkle 16 leaves");
    i = 0;
    while (i < 16) {
        var mp = merkle_proof(tree, i);
        assert(merkle_verify_proof(mp) == 1,
        "merkle 16 proof");
        i = i + 1;
    }
}

fn test_anchor_receipt() {
    var c = chain_new();
    var det = str_from("{}");
    chain_append(c, SEV_INFO, str_from("s"),
    str_from("a"), det);
    var tree = merkle_build(chain_entries(c));
    var a = anchor_new(tree, c);
    var r = receipt_new(a, str_from("test-be"),
    str_from("{\"tx\":\"0xabc\"}"));
    assert(r != 0, "receipt created");
    assert(str_eq(receipt_backend(r),
    str_from("test-be")) == 1, "receipt backend");
}

fn test_stream_recv_drain() {
    var s = stream_new();
    var sub = stream_subscribe(s, "libro/#");
    var e = entry_new(SEV_INFO, str_from("s"),
    str_from("a"), str_from("{}"), str_from(""));
    stream_publish(s, e);
    assert(stream_pending(sub) == 1, "pending 1");
    var received = stream_recv(sub);
    assert(received != 0, "recv not null");
    assert(stream_pending(sub) == 0, "pending 0");
}

fn test_filestore_multiple_appends() {
    var path = str_from("/tmp/libro_test_fma.jsonl");
    sys_unlink("/tmp/libro_test_fma.jsonl");
    var fs = filestore_open(path);
    var det = str_from("{}");
    var prev = str_from("");
    var i = 0;
    while (i < 10) {
        var e = entry_new(SEV_INFO, str_from("s"),
        str_from("a"), det, prev);
        filestore_append(fs, e);
        prev = entry_hash(e);
        i = i + 1;
    }
    assert(filestore_len(fs) == 10,
    "filestore 10 entries");
    var loaded = filestore_load_all(fs);
    assert(vec_len(loaded) == 10,
    "filestore loaded 10");
    sys_unlink("/tmp/libro_test_fma.jsonl");
}

fn test_compliance_presets() {
    var pci = retention_pci_dss();
    assert(retention_type(pci) == RETAIN_DURATION,
    "pci is duration");
    assert(retention_value(pci) == 365 * 86400,
    "pci is 1 year");
    var hipaa = retention_hipaa();
    assert(retention_value(hipaa) == 6 * 365 * 86400,
    "hipaa is 6 years");
    var sox = retention_sox();
    assert(retention_value(sox) == 7 * 365 * 86400,
    "sox is 7 years");
}

# ================================================================
# PatraStore tests
# ================================================================

fn test_patrastore_open_close() {
    sys_unlink("/tmp/libro_test_ps.patra");
    var ps = patrastore_open(str_from(
    "/tmp/libro_test_ps.patra"));
    assert(ps != 0, "patrastore open");
    assert(patrastore_is_empty(ps) == 1,
    "patrastore empty");
    patrastore_close(ps);
    sys_unlink("/tmp/libro_test_ps.patra");
    sys_unlink("/tmp/libro_test_ps.patra.wal");
}

fn test_patrastore_append_load() {
    sys_unlink("/tmp/libro_test_ps2.patra");
    var ps = patrastore_open(str_from(
    "/tmp/libro_test_ps2.patra"));
    var det = str_from("{}");
    var e1 = entry_new(SEV_INFO, str_from("auth"),
    str_from("login"), det, str_from(""));
    patrastore_append(ps, e1);
    var e2 = entry_new(SEV_WARNING, str_from("audit"),
    str_from("read"), det, entry_hash(e1));
    patrastore_append(ps, e2);
    assert(patrastore_len(ps) == 2,
    "patrastore len 2");
    var loaded = patrastore_load_all(ps);
    var lcount = vec_len(loaded);
    assert(lcount == 2, "patrastore loaded 2");
    if (lcount >= 2) {
        var le1 = vec_get(loaded, 0);
        assert(str_eq(entry_hash(le1),
        entry_hash(e1)) == 1,
        "patrastore hash preserved");
    }
    patrastore_close(ps);
    sys_unlink("/tmp/libro_test_ps2.patra");
    sys_unlink("/tmp/libro_test_ps2.patra.wal");
}

fn test_patrastore_verify() {
    sys_unlink("/tmp/libro_test_ps3.patra");
    var ps = patrastore_open(str_from(
    "/tmp/libro_test_ps3.patra"));
    var det = str_from("{}");
    var prev = str_from("");
    var i = 0;
    while (i < 3) {
        var e = entry_new(SEV_INFO, str_from("s"),
        str_from("a"), det, prev);
        patrastore_append(ps, e);
        prev = entry_hash(e);
        i = i + 1;
    }
    var result = patrastore_load_and_verify(ps);
    assert(vec_len(result) == 3,
    "patrastore verify 3");
    patrastore_close(ps);
    sys_unlink("/tmp/libro_test_ps3.patra");
    sys_unlink("/tmp/libro_test_ps3.patra.wal");
}

fn test_patrastore_query() {
    sys_unlink("/tmp/libro_test_ps4.patra");
    var ps = patrastore_open(str_from(
    "/tmp/libro_test_ps4.patra"));
    var det = str_from("{}");
    var e1 = entry_new(SEV_INFO, str_from("auth"),
    str_from("login"), det, str_from(""));
    patrastore_append(ps, e1);
    var e2 = entry_new(SEV_ERROR, str_from("audit"),
    str_from("fail"), det, entry_hash(e1));
    patrastore_append(ps, e2);
    var q = query_new();
    query_source(q, str_from("audit"));
    var results = patrastore_query(ps, q);
    assert(vec_len(results) == 1,
    "patrastore query filters");
