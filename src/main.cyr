fn test_query_source() {
    var det = str_from("{}");
    var e1 = entry_new(SEV_INFO, str_from("auth"), str_from("login"), det, str_from(""));
    var e2 = entry_new(SEV_INFO, str_from("audit"), str_from("read"), det, entry_hash(e1));

    var entries = vec_new();
    vec_push(entries, e1);
    vec_push(entries, e2);

    var q = query_new();
    query_source(q, str_from("auth"));
    var results = query_apply(q, entries);
    assert(vec_len(results) == 1, "query source filters");
    assert(str_eq(entry_source(vec_get(results, 0)), str_from("auth")) == 1, "query source match");
}

