fn test_review_empty() {
    var c = chain_new();
    var r = chain_review(c);
    assert(review_entry_count(r) == 0, "review empty count");
    assert(integrity_status(review_integrity(r)) == INTEGRITY_EMPTY, "review empty integrity");
}

fn test_review_valid() {
    var c = chain_new();
    var det = str_from("{}");
    chain_append(c, SEV_INFO, str_from("auth"), str_from("login"), det);
    chain_append(c, SEV_ERROR, str_from("audit"), str_from("fail"), det);
    chain_append(c, SEV_INFO, str_from("auth"), str_from("logout"), det);

    var r = chain_review(c);
    assert(review_entry_count(r) == 3, "review count");
    assert(integrity_status(review_integrity(r)) == INTEGRITY_VALID, "review valid integrity");
    assert(review_earliest(r) != 0, "review has earliest");
    assert(review_latest(r) != 0, "review has latest");
    assert(review_head_hash(r) != 0, "review has head_hash");

    # Check source counts
    var sources = review_sources(r);
    assert(map_get(sources, "auth") == 2, "review auth source count");
    assert(map_get(sources, "audit") == 1, "review audit source count");
}

fn test_review_tampered() {
    var c = chain_new();
    var det = str_from("{}");
    chain_append(c, SEV_INFO, str_from("s"), str_from("a"), det);
    chain_append(c, SEV_INFO, str_from("s"), str_from("a"), det);

    # Tamper
    var e1 = vec_get(chain_entries(c), 0);
    store64(e1 + 24, SEV_CRITICAL);

    var r = chain_review(c);
    assert(integrity_status(review_integrity(r)) == INTEGRITY_INVALID, "review detects tamper");
}

