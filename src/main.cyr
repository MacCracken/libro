fn test_chain_rotate() {
    var c = chain_new();
    var det = str_from("{}");

    chain_append(c, SEV_INFO, str_from("s"), str_from("a1"), det);
    chain_append(c, SEV_INFO, str_from("s"), str_from("a2"), det);
    var head_before = chain_head_hash(c);

    var arch = chain_rotate(c);
    assert(chain_len(c) == 0, "chain empty after rotate");
    assert(vec_len(archive_entries(arch)) == 2, "archive has 2 entries");
    assert(chain_prev_hash(c) != 0, "prev_chain_hash set after rotate");

    # New append should link to rotated chain
    chain_append(c, SEV_INFO, str_from("s"), str_from("a3"), det);
    var first = vec_get(chain_entries(c), 0);
    assert(str_eq(entry_prev_hash(first), head_before) == 1, "new entry links to rotated head");
}

fn test_chain_auto_rotate() {
    var c = chain_with_capacity(3);
    var det = str_from("{}");

    chain_append(c, SEV_INFO, str_from("s"), str_from("a1"), det);
    chain_append(c, SEV_INFO, str_from("s"), str_from("a2"), det);
    chain_append(c, SEV_INFO, str_from("s"), str_from("a3"), det);
    assert(chain_len(c) == 3, "chain at capacity");

    # This append should trigger auto-rotate
    chain_append(c, SEV_INFO, str_from("s"), str_from("a4"), det);
    assert(chain_len(c) == 1, "chain has 1 after auto-rotate");
    assert(vec_len(chain_overflow(c)) == 1, "overflow has 1 archive");
}

