fn test_proof_to_json_null_on_zero() {
    var json = proof_to_json(0);
    var expected = str_from("null");
    assert(str_eq(json, expected) == 1, "proof_to_json(0) = null");
}

# Structural test — offset-typo regression guard for the iproof accessors.
# If proof_to_json reads sth / entries / inclusions / anchor from wrong
# offsets, one of these field-presence asserts fails. Reads across all
# four derived-accessor slots on iproof (tree_head@0, inclusions@16,
# entries@24, anchor@32).
fn test_proof_from_json_null() {
    # Top-level "null" parses back to 0.
    var ip = proof_from_json(str_from("null"));
    assert(ip == 0, "proof_from_json(null) → 0");
}

fn test_proof_from_json_empty_string() {
    var ip = proof_from_json(str_from(""));
    assert(ip == 0, "proof_from_json(\"\") → 0");
}

fn test_proof_from_json_malformed() {
    # Malformed input should fail safely, not crash.
    var ip = proof_from_json(str_from("{"));
    assert(ip == 0, "proof_from_json({) → 0");

    var ip2 = proof_from_json(str_from("not-json"));
    assert(ip2 == 0, "proof_from_json(not-json) → 0");

    var ip3 = proof_from_json(str_from("{\"tree_head\":{}}"));
    # Missing root key in tree_head — tree-head parse fails.
    assert(ip3 == 0, "proof_from_json(incomplete tree_head) → 0");
}

fn test_proof_from_json_roundtrip_unsigned() {
    # Build a chain with nested details (exercises the custom details
    # byte-walker rather than flat string parsing), emit JSON, parse
    # back, verify structural equivalence.
    var c = chain_new();
    var det_flat = str_from("{}");
    var det_nested = str_from("{\"agent\":\"web-01\",\"load\":{\"p50\":12,\"p99\":480}}");
    chain_append(c, SEV_INFO, str_from("auth"), str_from("login"), det_flat);
    chain_append(c, SEV_SECURITY, str_from("aegis"),
      str_from("intrusion.detected"), det_nested);
    chain_append(c, SEV_INFO, str_from("ark"), str_from("pkg.install"), det_flat);

    var ip = proof_build_unsigned(c);
    proof_with_all_inclusions(ip);

    var json = proof_to_json(ip);
    assert(str_len(json) > 100, "emitted JSON non-trivial");

    var ip2 = proof_from_json(json);
    assert(ip2 != 0, "proof_from_json returns non-null");

    # Tree head recovered
    var sth1 = iproof_tree_head(ip);
    var sth2 = iproof_tree_head(ip2);
    assert(constant_time_eq_str(sth_root(sth1), sth_root(sth2)) == 1,
      "tree head root round-trips");
    assert(sth_tree_size(sth1) == sth_tree_size(sth2),
      "tree_size round-trips");
    assert(constant_time_eq_str(sth_timestamp(sth1), sth_timestamp(sth2)) == 1,
      "timestamp round-trips");

    # Entries round-trip with hashes preserved
    var e1 = iproof_entries(ip);
    var e2 = iproof_entries(ip2);
    assert(vec_len(e1) == vec_len(e2), "entries count matches");
    assert(vec_len(e2) == 3, "3 entries parsed");

    var i = 0;
    while (i < vec_len(e1)) {
        var a = vec_get(e1, i);
        var b = vec_get(e2, i);
        assert(constant_time_eq_str(entry_hash(a), entry_hash(b)) == 1,
          "entry hash round-trips");
        assert(constant_time_eq_str(entry_source(a), entry_source(b)) == 1,
          "entry source round-trips");
        i += 1;
    }

    # Inclusion count
    var inc1 = iproof_inclusions(ip);
    var inc2 = iproof_inclusions(ip2);
    assert(vec_len(inc1) == vec_len(inc2), "inclusions count matches");
    assert(vec_len(inc2) == 3, "3 inclusion proofs");
}

fn test_proof_from_json_roundtrip_full() {
    # Full round-trip verify against the 2.6.0+ JSON shape. Pre-2.6
    # the inclusion `path` arrays emitted bare hex strings, dropping
    # the side bit and breaking merkle_verify_proof on parsed
    # inclusions. 2.6.0 fixes that: path entries are objects
    # `{"h":<hex>,"s":<0|1>}` and the parser reconstructs proof_nodes
    # with side preserved. Every parsed merkle_proof now verifies.
    var c = chain_new();
    chain_append(c, SEV_INFO, str_from("src"), str_from("act"),
      str_from("{\"v\":1}"));
    chain_append(c, SEV_INFO, str_from("src"), str_from("act"),
      str_from("{\"v\":2}"));
    chain_append(c, SEV_INFO, str_from("src"), str_from("act"),
      str_from("{\"v\":3}"));

    var ip = proof_build_unsigned(c);
    proof_with_all_inclusions(ip);

    var json = proof_to_json(ip);
    var ip2 = proof_from_json(json);
    assert(ip2 != 0, "parsed iproof non-null");

    # Entry chain still verifies (entries round-trip faithfully).
    var err = verify_chain(iproof_entries(ip2), 0);
    assert(err == 0, "parsed entries still chain-verify");

    # Tree rebuilt from parsed entries matches the stored sth.root.
    var rebuilt = merkle_build(iproof_entries(ip2));
    assert(constant_time_eq_str(merkle_tree_root(rebuilt),
        sth_root(iproof_tree_head(ip2))) == 1,
      "rebuilt root matches parsed tree_head.root");

    # 2.6.0: every parsed merkle_proof verifies cleanly.
    var inclusions = iproof_inclusions(ip2);
    var nincl = vec_len(inclusions);
    assert(nincl == 3, "all 3 inclusions parsed");
    var i = 0;
    while (i < nincl) {
        var mp = vec_get(inclusions, i);
        assert(merkle_verify_proof(mp) == 1,
          "parsed merkle_proof verifies (lossless path)");
        i = i + 1;
    }
}

fn test_proof_from_json_legacy_path_accepted() {
    # The pre-2.6 emission form (bare hex strings in `path`) is
    # still parseable — the legacy form lands proof_nodes with
    # SIDE_LEFT default. Verification of the resulting proof
    # would fail (side bit was lost in the emission), but the
    # parser shouldn't crash on the legacy shape: archival proofs
    # written by older libro versions still need to be readable.
    # split across str_cat pieces to stay under the 120-char line cap;
    # the concatenation is byte-identical to the original single literal.
    var lj1 = str_from("{\"tree_head\":{\"root\":\"deadbeef\",\"tree_size\":1,");
    var lj2 = str_from("\"timestamp\":\"2026-01-01T00:00:00Z\",\"signature\":null,");
    var lj3 = str_from("\"verifying_key\":null,\"algorithm\":null},\"entries\":[],");
    var lj4 = str_from("\"inclusions\":[{\"index\":0,\"leaf\":\"abc\",\"root\":\"deadbeef\",");
    var lj5 = str_from("\"path\":[\"aa\",\"bb\"]}]}");
    var legacy = str_cat(str_cat(str_cat(lj1, lj2), str_cat(lj3, lj4)), lj5);
    var ip = proof_from_json(legacy);
    assert(ip != 0, "legacy bare-string path: parser doesn't crash");
    var inclusions = iproof_inclusions(ip);
    assert(vec_len(inclusions) == 1, "legacy path: 1 inclusion parsed");
    var mp = vec_get(inclusions, 0);
    var path = merkle_proof_path(mp);
    assert(vec_len(path) == 2, "legacy path: both nodes parsed");
    # Each node is a proof_node with hash set + side defaulted to LEFT.
    var node0 = vec_get(path, 0);
    assert(proof_node_side(node0) == SIDE_LEFT,
      "legacy path: side defaults to LEFT");
}

fn test_proof_to_json_fields_present() {
    var c = chain_new();
    var det = str_from("{}");
    chain_append(c, SEV_INFO, str_from("s"), str_from("a1"), det);
    chain_append(c, SEV_INFO, str_from("s"), str_from("a2"), det);
    chain_append(c, SEV_INFO, str_from("s"), str_from("a3"), det);

    var ip = proof_build_unsigned(c);
    proof_with_all_inclusions(ip);

    var json = proof_to_json(ip);
    assert(str_contains(json, str_from("\"tree_head\":")) == 1, "json has tree_head");
    assert(str_contains(json, str_from("\"root\":")) == 1, "json has root (via sth_root)");
    assert(str_contains(json, str_from("\"tree_size\":")) == 1, "json has tree_size");
    assert(str_contains(json, str_from("\"entries\":")) == 1, "json has entries");
    assert(str_contains(json, str_from("\"inclusions\":")) == 1, "json has inclusions");
    assert(str_contains(json, str_from("\"anchor\":")) == 1, "json has anchor slot");
    assert(str_len(json) > 100, "json is non-trivial (>100 bytes)");
}

fn test_receipt_create() {
    var c = chain_new();
    chain_append(c, SEV_INFO, str_from("s"), str_from("a"), str_from("{}"));
    var tree = merkle_build(chain_entries(c));
    var a = anchor_new(tree, c);
    var r = receipt_new(a, str_from("test-backend"), str_from("{}"));
    assert(r != 0, "receipt created");
    assert(str_eq(receipt_backend(r), str_from("test-backend")) == 1, "receipt backend");
}

# ================================================================
# Streaming tests
# ================================================================

fn test_stream_publish_subscribe() {
    var s = stream_new();
    var rx = stream_subscribe(s, "libro/#");

    # Create an entry and publish
    var e = entry_new(SEV_INFO, str_from("daimon"), str_from("agent.start"), str_from("{}"), str_from(""));
    stream_publish(s, e);

    assert_eq(stream_published(s), 1, "stream 1 published");
    assert_eq(stream_pending(rx), 1, "stream 1 pending");
    var got = stream_recv(rx);
    assert_eq(got, e, "stream recv matches");
    assert_eq(stream_pending(rx), 0, "stream 0 after recv");
    return 0;
}

fn test_stream_filtered_by_source() {
    var s = stream_new();
    var rx_daimon = stream_subscribe(s, "libro/daimon/#");
    var rx_aegis = stream_subscribe(s, "libro/aegis/#");

    var e1 = entry_new(SEV_INFO, str_from("daimon"), str_from("start"), str_from("{}"), str_from(""));
    var e2 = entry_new(SEV_SECURITY, str_from("aegis"), str_from("alert"), str_from("{}"), str_from(""));
    stream_publish(s, e1);
    stream_publish(s, e2);

    assert_eq(stream_pending(rx_daimon), 1, "daimon got 1");
    assert_eq(stream_pending(rx_aegis), 1, "aegis got 1");
    var d = stream_recv(rx_daimon);
    assert_eq(d, e1, "daimon entry");
    var a = stream_recv(rx_aegis);
    assert_eq(a, e2, "aegis entry");
    return 0;
}

fn test_stream_action_wildcard() {
    var s = stream_new();
    var rx = stream_subscribe(s, "libro/*/alert");

    var e1 = entry_new(SEV_INFO, str_from("daimon"), str_from("start"), str_from("{}"), str_from(""));
    var e2 = entry_new(SEV_SECURITY, str_from("aegis"), str_from("alert"), str_from("{}"), str_from(""));
    stream_publish(s, e1);
    stream_publish(s, e2);

    # Only the alert should be delivered
    assert_eq(stream_pending(rx), 1, "wildcard got 1");
    var got = stream_recv(rx);
    assert_eq(got, e2, "wildcard is alert");
    return 0;
}

fn test_stream_no_match() {
    var s = stream_new();
    var rx = stream_subscribe(s, "libro/aegis/#");

    var e = entry_new(SEV_INFO, str_from("daimon"), str_from("start"), str_from("{}"), str_from(""));
    stream_publish(s, e);

    assert_eq(stream_pending(rx), 0, "no match 0 pending");
    return 0;
}

fn test_stream_custom_prefix() {
    var s = stream_with_prefix("audit/prod");
    var rx = stream_subscribe(s, "audit/prod/#");

    var e = entry_new(SEV_INFO, str_from("daimon"), str_from("start"), str_from("{}"), str_from(""));
    stream_publish(s, e);

    assert_eq(stream_pending(rx), 1, "custom prefix delivered");
    return 0;
}

fn test_stream_multiple_entries() {
    var s = stream_new();
    var rx = stream_subscribe(s, "libro/#");

    var i = 0;
    while (i < 5) {
        var e = entry_new(SEV_INFO, str_from("src"), str_from("evt"), str_from("{}"), str_from(""));
        stream_publish(s, e);
        i += 1;
    }

    assert_eq(stream_published(s), 5, "5 published");
    assert_eq(stream_pending(rx), 5, "5 pending");
    return 0;
}

# ================================================================
# FileStore tests
# ================================================================

fn test_filestore_append_load() {
    var path = str_from("/tmp/libro_test_fs.jsonl");
    # Clean up from prior runs
    sys_unlink("/tmp/libro_test_fs.jsonl");

    var fs = filestore_open(path);
    assert(fs != 0, "filestore open");

    # Append entries
    var det = str_from("{}");
    var e1 = entry_new(SEV_INFO, str_from("src"), str_from("act1"), det, str_from(""));
    filestore_append(fs, e1);
    var e2 = entry_new(SEV_WARNING, str_from("src"), str_from("act2"), det, entry_hash(e1));
    filestore_append(fs, e2);

    # Check file len before loading
    var flen = filestore_len(fs);
    assert(flen == 2, "filestore has 2 lines");

    # Load and check count
    var loaded = filestore_load_all(fs);
    var lcount = vec_len(loaded);
    assert(lcount == 2, "filestore loaded 2 entries");

    if (lcount >= 2) {
        # Verify hashes match
        var le1 = vec_get(loaded, 0);
        var le2 = vec_get(loaded, 1);
        assert(str_eq(entry_hash(le1), entry_hash(e1)) == 1, "filestore hash preserved");
        assert(entry_severity(le2) == SEV_WARNING, "filestore severity preserved");
    }

    sys_unlink("/tmp/libro_test_fs.jsonl");
}

fn test_filestore_verify() {
    var path = str_from("/tmp/libro_test_fsv.jsonl");
    sys_unlink("/tmp/libro_test_fsv.jsonl");

    var fs = filestore_open(path);
    var det = str_from("{}");
    var prev = libro_empty_str();
    var i = 0;
    while (i < 3) {
        var e = entry_new(SEV_INFO, str_from("s"), str_from("a"), det, prev);
        filestore_append(fs, e);
        prev = entry_hash(e);
        i += 1;
    }

    var result = filestore_load_and_verify(fs);
    assert(vec_len(result) == 3, "filestore verify returns 3 entries");

    sys_unlink("/tmp/libro_test_fsv.jsonl");
}

fn test_filestore_query() {
    var path = str_from("/tmp/libro_test_fsq.jsonl");
    sys_unlink("/tmp/libro_test_fsq.jsonl");

    var fs = filestore_open(path);
    var det = str_from("{}");
