fn test_merkle_build() {
    var c = chain_new();
    var det = str_from("{}");
    chain_append(c, SEV_INFO, str_from("s"), str_from("a1"), det);
    chain_append(c, SEV_INFO, str_from("s"), str_from("a2"), det);
    chain_append(c, SEV_INFO, str_from("s"), str_from("a3"), det);
    chain_append(c, SEV_INFO, str_from("s"), str_from("a4"), det);

    var tree = merkle_build(chain_entries(c));
    assert(tree != 0, "merkle build succeeds");
    assert(merkle_tree_leaf_count(tree) == 4, "merkle leaf count");
    assert(str_len(merkle_tree_root(tree)) == 64, "merkle root is 64-char hex");
}

fn test_merkle_single() {
    var c = chain_new();
    chain_append(c, SEV_INFO, str_from("s"), str_from("a"), str_from("{}"));
    var tree = merkle_build(chain_entries(c));
    assert(tree != 0, "merkle single build");
    assert(merkle_tree_leaf_count(tree) == 1, "merkle single leaf");
}

fn test_merkle_inclusion_proof() {
    var c = chain_new();
    var det = str_from("{}");
    var i = 0;
    while (i < 8) {
        chain_append(c, SEV_INFO, str_from("s"), str_from("a"), det);
        i += 1;
    }

    var tree = merkle_build(chain_entries(c));
    i = 0;
    while (i < 8) {
        var mp = merkle_inclusion_proof(tree, i);
        assert(mp != 0, "merkle proof exists");
        assert(merkle_verify_proof(mp) == 1, "merkle proof verifies");
        i += 1;
    }
}

fn test_merkle_proof_out_of_bounds() {
    var c = chain_new();
    chain_append(c, SEV_INFO, str_from("s"), str_from("a"), str_from("{}"));
    var tree = merkle_build(chain_entries(c));
    var mp = merkle_inclusion_proof(tree, 5);
    assert(mp == 0, "merkle proof out of bounds returns null");
}

