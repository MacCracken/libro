fn test_canonical_json_nested_object() {
    var d1 = str_from("{\"a\":{\"x\":1,\"y\":2}}");
    var d2 = str_from("{\"a\":{\"y\":2,\"x\":1}}");
    var e1 = entry_new(SEV_INFO, str_from("s"), str_from("a"), d1, str_from(""));
    var e2 = entry_new(SEV_INFO, str_from("s"), str_from("a"), d2, str_from(""));
    # Timestamps/UUIDs differ — tamper test: replace e2 fields with e1's
    # and re-hash. Easier route: just assert that tampering d2→d1 retains
    # the invariant by comparing canonical forms via a probe entry.
    var probe1 = entry_new(SEV_INFO, str_from("p"), str_from("p"), d1, str_from(""));
    store64(probe1 + 0, 0);  # zero UUID (upper half)
    store64(probe1 + 8, 0);  # zero UUID (lower half)
    store64(probe1 + 16, str_from("2000-01-01T00:00:00Z"));  # pin timestamp
    var h1 = entry_compute_hash(probe1);

    var probe2 = entry_new(SEV_INFO, str_from("p"), str_from("p"), d2, str_from(""));
    store64(probe2 + 0, 0);
    store64(probe2 + 8, 0);
    store64(probe2 + 16, str_from("2000-01-01T00:00:00Z"));
    var h2 = entry_compute_hash(probe2);

    assert(str_eq(h1, h2) == 1, "nested object key-order independence");
}

fn test_canonical_json_array_preserves_order() {
    var d1 = str_from("{\"xs\":[1,2,3]}");
    var d2 = str_from("{\"xs\":[3,2,1]}");
    var probe1 = entry_new(SEV_INFO, str_from("p"), str_from("p"), d1, str_from(""));
    store64(probe1 + 0, 0);
    store64(probe1 + 8, 0);
    store64(probe1 + 16, str_from("2000-01-01T00:00:00Z"));
    var h1 = entry_compute_hash(probe1);

    var probe2 = entry_new(SEV_INFO, str_from("p"), str_from("p"), d2, str_from(""));
    store64(probe2 + 0, 0);
    store64(probe2 + 8, 0);
    store64(probe2 + 16, str_from("2000-01-01T00:00:00Z"));
    var h2 = entry_compute_hash(probe2);

    assert(str_eq(h1, h2) == 0, "array order is significant");
}

fn test_canonical_json_deep_nesting() {
    var d = str_from("{\"a\":{\"b\":{\"c\":{\"d\":[1,true,null,\"s\"]}}}}");
    var e = entry_new(SEV_INFO, str_from("s"), str_from("a"), d, str_from(""));
    assert(entry_verify(e) == 1, "deep nesting verifies");
    assert(str_len(entry_hash(e)) == 64, "deep-nested hash length 64");
}

fn test_canonical_json_mixed_value_types() {
    var d1 = str_from("{\"b\":true,\"n\":42,\"s\":\"hi\",\"z\":null}");
    var d2 = str_from("{\"n\":42,\"z\":null,\"s\":\"hi\",\"b\":true}");
    var probe1 = entry_new(SEV_INFO, str_from("p"), str_from("p"), d1, str_from(""));
    store64(probe1 + 0, 0);
    store64(probe1 + 8, 0);
    store64(probe1 + 16, str_from("2000-01-01T00:00:00Z"));
    var h1 = entry_compute_hash(probe1);

    var probe2 = entry_new(SEV_INFO, str_from("p"), str_from("p"), d2, str_from(""));
    store64(probe2 + 0, 0);
    store64(probe2 + 8, 0);
    store64(probe2 + 16, str_from("2000-01-01T00:00:00Z"));
    var h2 = entry_compute_hash(probe2);

    assert(str_eq(h1, h2) == 1, "mixed-type flat object key-order independence");
}

fn test_canonical_json_whitespace_insensitive() {
    var d1 = str_from("{\"a\":1,\"b\":2}");
    var d2 = str_from("{  \"a\" : 1 ,\n  \"b\" : 2  }");
    var probe1 = entry_new(SEV_INFO, str_from("p"), str_from("p"), d1, str_from(""));
    store64(probe1 + 0, 0);
    store64(probe1 + 8, 0);
    store64(probe1 + 16, str_from("2000-01-01T00:00:00Z"));
    var h1 = entry_compute_hash(probe1);

    var probe2 = entry_new(SEV_INFO, str_from("p"), str_from("p"), d2, str_from(""));
    store64(probe2 + 0, 0);
    store64(probe2 + 8, 0);
    store64(probe2 + 16, str_from("2000-01-01T00:00:00Z"));
    var h2 = entry_compute_hash(probe2);

    assert(str_eq(h1, h2) == 1, "whitespace between tokens does not affect hash");
}

fn test_chain_export_import_roundtrip() {
    var path = str_from("/tmp/libro_test_chain_export.jsonl");
    sys_unlink("/tmp/libro_test_chain_export.jsonl");

    var c = chain_with_capacity(50);
    var det = str_from("{}");
    chain_append(c, SEV_INFO, str_from("src"), str_from("act1"), det);
    chain_append(c, SEV_WARNING, str_from("src"), str_from("act2"), det);
    chain_append(c, SEV_ERROR, str_from("src"), str_from("act3"), det);
    var head = chain_head_hash(c);

    assert(chain_export(c, path) == 0, "chain_export ok");

    var c2 = chain_import(path);
    assert(c2 != 0, "chain_import returned chain");
    assert(chain_len(c2) == 3, "chain_import restored 3 entries");
    assert(chain_max_capacity(c2) == 50, "chain_import restored capacity");
    assert(str_eq(chain_head_hash(c2), head) == 1, "chain_import preserves head hash");
    assert(chain_verify(c2) == 0, "chain_import passes verify");

    sys_unlink("/tmp/libro_test_chain_export.jsonl");
}

