    filestore_append(fs, e1);
    var e2 = entry_new(SEV_ERROR, str_from("audit"), str_from("fail"), det, entry_hash(e1));
    filestore_append(fs, e2);

    var q = query_new();
    query_source(q, str_from("audit"));
