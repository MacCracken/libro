# entry.cyr — AuditEntry, the core data type
# Tamper-proof hash-linked audit entries with UUID, timestamps,
# severity levels, and deterministic hash computation.

# ================================================================
# Severity constants
# ================================================================

enum Severity {
    SEV_DEBUG = 0;
    SEV_INFO = 1;
    SEV_WARNING = 2;
    SEV_ERROR = 3;
    SEV_CRITICAL = 4;
    SEV_SECURITY = 5;
}

fn severity_as_str(sev) {
    if (sev == SEV_DEBUG) { return "Debug"; }
    if (sev == SEV_INFO) { return "Info"; }
    if (sev == SEV_WARNING) { return "Warning"; }
    if (sev == SEV_ERROR) { return "Error"; }
    if (sev == SEV_CRITICAL) { return "Critical"; }
    if (sev == SEV_SECURITY) { return "Security"; }
    return "Unknown";
}

# Length of the severity_as_str() result without a strlen call.
# Entry hashing length-prefixes the severity name on every compute_hash;
# this avoids scanning the constant string once per entry.
fn severity_len(sev) {
    if (sev == SEV_DEBUG) { return 5; }
    if (sev == SEV_INFO) { return 4; }
    if (sev == SEV_WARNING) { return 7; }
    if (sev == SEV_ERROR) { return 5; }
    if (sev == SEV_CRITICAL) { return 8; }
    if (sev == SEV_SECURITY) { return 8; }
    return 7;
}

fn severity_at_or_above(sev, threshold) {
    if (sev >= threshold) { return 1; }
    return 0;
}

# ================================================================
# Validation constants
# ================================================================

var MAX_SOURCE_LEN = 1024;
var MAX_ACTION_LEN = 1024;
var MAX_DETAILS_SIZE = 1048576;

# ================================================================
# AuditEntry — inline 16-byte UUID at offset 0 that derive can't model,
# so `_uuid_hi` / `_uuid_lo` are named just to reserve the first two
# slots. Public `entry_id(e)` returns the pointer (not a load) and stays
# manual. All other accessors come from derive.
#derive(accessors)
struct entry {
    _uuid_hi; _uuid_lo;
    timestamp; severity; source; action; details;
    agent_id; prev_hash; hash; hash_algorithm;
}

fn entry_id(e) { return e; }

# ================================================================
# UUID v4 generation via /dev/urandom
# ================================================================

fn uuid_v4(buf) {
    # Fail-closed on /dev/urandom unavailability: a predictable UUID would
    # make the libro audit chain forgeable. Upstream libro 1.0.3 silently
    # ignored short reads; t-ron's vendored copy aborts instead.
    #ifdef CYRIUS_TARGET_AGNOS
    # agnos has no /dev/urandom — draw 16 bytes from getrandom #45
    # (RDRAND-seeded CSPRNG). Same fail-closed contract as the Linux path.
    var got = syscall(SYS_GETRANDOM, buf, 16, 0);
    if (got != 16) {
        syscall(SYS_WRITE, 2, "libro: getrandom failed (fail-closed)\n", 38);
        syscall(SYS_EXIT, 74);
    }
    #else
    var fd = file_open("/dev/urandom", 0, 0);
    if (fd < 0) {
        syscall(SYS_WRITE, 2, "libro: /dev/urandom unavailable (fail-closed)\n", 46);
        syscall(SYS_EXIT, 74);   # EX_IOERR
    }
    var got = file_read(fd, buf, 16);
    file_close(fd);
    if (got != 16) {
        syscall(SYS_WRITE, 2, "libro: short read from /dev/urandom (fail-closed)\n", 50);
        syscall(SYS_EXIT, 74);
    }
    #endif
    # Version 4: byte 6 high nibble = 0100
    var b6 = load8(buf + 6) & 0xFF;
    store8(buf + 6, (b6 & 0x0F) | 0x40);
    # Variant RFC 4122: byte 8 high bits = 10
    var b8 = load8(buf + 8) & 0xFF;
    store8(buf + 8, (b8 & 0x3F) | 0x80);
    return 0;
}

# Format UUID as 8-4-4-4-12 hex string (36 chars)
# Write one byte of `buf` as two lowercase hex chars at out[pos..pos+2].
fn _uuid_hex_byte(buf, bi, out, pos) {
    var b = load8(buf + bi) & 0xFF;
    var hi = (b >> 4) & 0xF;
    var lo = b & 0xF;
    if (hi < 10) { store8(out + pos, 48 + hi); }
    else { store8(out + pos, 87 + hi); }
    if (lo < 10) { store8(out + pos + 1, 48 + lo); }
    else { store8(out + pos + 1, 87 + lo); }
    return 0;
}

# Single-pass UUID formatter. Writes 36 chars (8-4-4-4-12) + NUL into
# one fresh 37-byte buffer and wraps it once. Replaces the former
# 5× hex_encode_str + str_builder path that allocated ~12 intermediate
# objects per UUID. bench_entry_hash and every export/proof call pays
# this once per entry.
fn uuid_format(buf) {
    var out = alloc(37);
    # bytes 0..3 → out[0..7]
    _uuid_hex_byte(buf, 0, out, 0);
    _uuid_hex_byte(buf, 1, out, 2);
    _uuid_hex_byte(buf, 2, out, 4);
    _uuid_hex_byte(buf, 3, out, 6);
    store8(out + 8, 45);
    # bytes 4..5 → out[9..12]
    _uuid_hex_byte(buf, 4, out, 9);
    _uuid_hex_byte(buf, 5, out, 11);
    store8(out + 13, 45);
    # bytes 6..7 → out[14..17]
    _uuid_hex_byte(buf, 6, out, 14);
    _uuid_hex_byte(buf, 7, out, 16);
    store8(out + 18, 45);
    # bytes 8..9 → out[19..22]
    _uuid_hex_byte(buf, 8, out, 19);
    _uuid_hex_byte(buf, 9, out, 21);
    store8(out + 23, 45);
    # bytes 10..15 → out[24..35]
    _uuid_hex_byte(buf, 10, out, 24);
    _uuid_hex_byte(buf, 11, out, 26);
    _uuid_hex_byte(buf, 12, out, 28);
    _uuid_hex_byte(buf, 13, out, 30);
    _uuid_hex_byte(buf, 14, out, 32);
    _uuid_hex_byte(buf, 15, out, 34);
    store8(out + 36, 0);
    return str_new(out, 36);
}

# ================================================================
# Timestamp — wall-clock via clock_gettime(CLOCK_REALTIME)
# ================================================================

var _ts_buf = 0;

fn get_epoch_secs() {
    #ifdef CYRIUS_TARGET_AGNOS
    # agnos: time_unix #46 returns unix seconds directly in rax (no timespec).
    return syscall(SYS_TIME_UNIX);
    #else
    if (_ts_buf == 0) { _ts_buf = alloc(16); }
    # clock_gettime(CLOCK_REALTIME=0, &timespec)
    syscall(228, 0, _ts_buf);
    return load64(_ts_buf);
    #endif
}

# Format helpers for zero-padded decimals
fn _fmt_02d(buf, n) {
    store8(buf, 48 + n / 10);
    store8(buf + 1, 48 + (n - (n / 10) * 10));
    return 0;
}

fn _fmt_04d(buf, n) {
    store8(buf, 48 + (n / 1000) - (n / 10000) * 10);
    store8(buf + 1, 48 + (n / 100) - (n / 1000) * 10);
    store8(buf + 2, 48 + (n / 10) - (n / 100) * 10);
    store8(buf + 3, 48 + n - (n / 10) * 10);
    return 0;
}

# Civil date from days since epoch (Hinnant algorithm)
# Returns year in _cd_y, month in _cd_m, day in _cd_d
var _cd_y = 0;
var _cd_m = 0;
var _cd_d = 0;

fn civil_from_days(days) {
    var z = days + 719468;
    var era = z / 146097;
    if (z < 0) { era = (z - 146096) / 146097; }
    var doe = z - era * 146097;
    var yoe = (doe - doe / 1461 + doe / 36524 - doe / 146097) / 365;
    var y = yoe + era * 400;
    var doy = doe - (365 * yoe + yoe / 4 - yoe / 100);
    var mp = (5 * doy + 2) / 153;
    _cd_d = doy - (153 * mp + 2) / 5 + 1;
    _cd_m = mp + 3;
    if (mp >= 10) { _cd_m = mp - 9; }
    _cd_y = y;
    if (_cd_m <= 2) { _cd_y = y + 1; }
    return 0;
}

fn timestamp_rfc3339(epoch_secs) {
    var secs_in_day = 86400;
    var days = epoch_secs / secs_in_day;
    var time_of_day = epoch_secs - days * secs_in_day;
    if (time_of_day < 0) {
        time_of_day = time_of_day + secs_in_day;
        days = days - 1;
    }

    civil_from_days(days);

    var hour = time_of_day / 3600;
    var minute = (time_of_day - hour * 3600) / 60;
    var second = time_of_day - hour * 3600 - minute * 60;

    # Format: "YYYY-MM-DDTHH:MM:SSZ" = 20 chars
    var buf = alloc(21);
    _fmt_04d(buf, _cd_y);
    store8(buf + 4, 45);
    _fmt_02d(buf + 5, _cd_m);
    store8(buf + 7, 45);
    _fmt_02d(buf + 8, _cd_d);
    store8(buf + 10, 84);
    _fmt_02d(buf + 11, hour);
    store8(buf + 13, 58);
    _fmt_02d(buf + 14, minute);
    store8(buf + 16, 58);
    _fmt_02d(buf + 17, second);
    store8(buf + 19, 90);
    store8(buf + 20, 0);
    return str_new(buf, 20);
}

# ================================================================
# Canonical JSON hashing (recursive, depth-unlimited)
# ================================================================
# Walks raw JSON bytes and emits a canonical form into the hasher:
#   null, true, false, numbers → emitted verbatim, whitespace stripped
#   strings → emitted as "…" with original escapes preserved verbatim
#   objects → "{"k":v,…}" with keys sorted lexicographically
#   arrays  → "[v,v,…]" in original order (no sort)
#
# 2.0 rewrite: flat-only canonicalizer via lib/json.cyr replaced with
# a direct byte-walker that handles arbitrary nesting. Flat objects
# with all-string values hash identically to the 1.x form; any use of
# numbers, bools, null, arrays, or nested objects as top-level details
# values now hashes differently (1.x emitted all values as
# quoted strings, silently miscoercing non-strings). Consumers that
# stored hashes computed from non-string-only flat JSON in 1.x will
# see a hash break on re-verify — which is correct behaviour and one
# of the reasons this is a 2.0 feature.

# ================================================================
# JSON string decode / minimal re-escape (2.8.12)
# ================================================================
#
# ONE decoder and ONE escaper for the whole library. file_store.cyr's JSONL
# reader and the canonical hasher below both need "turn a quoted JSON string
# into its raw bytes"; having two copies is precisely how a writer and a
# reader drift apart, which is the defect class 2.8.11 spent a release on.
# entry.cyr is third in the include order, so everything downstream can use
# these.

fn _js_hexval(c) {
    if (c >= 48 && c <= 57) { return c - 48; }
    if (c >= 97 && c <= 102) { return c - 87; }
    if (c >= 65 && c <= 70) { return c - 55; }
    return 0 - 1;
}

fn _js_hexchar(v) {
    if (v < 10) { return 48 + v; }
    return 87 + v;
}

# Decode the JSON string starting at data[pos] (which must be '"').
# Returns (Str of raw decoded bytes, position after the closing quote),
# or (0, 0) if malformed.
fn json_str_decode(data, pos, slen) {
    if (pos >= slen || (load8(data + pos) & 0xFF) != 34) { return (0, 0); }
    pos += 1;
    # Size to THIS string's span: one scan to the closing quote. The decoded
    # form is never longer than the encoded form.
    var scan = pos;
    var span = 0 - 1;
    while (scan < slen && span < 0) {
        var sc = load8(data + scan) & 0xFF;
        if (sc == 92) { scan += 2; }
        elif (sc == 34) { span = scan - pos; }
        else { scan += 1; }
    }
    if (span < 0) { return (0, 0); }
    var out = alloc(span + 1);
    var oi = 0;
    while (pos < slen) {
        var c = load8(data + pos) & 0xFF;
        if (c == 34) {
            store8(out + oi, 0);
            return (str_new(out, oi), pos + 1);
        }
        if (c == 92) {
            if (pos + 1 >= slen) { return (0, 0); }
            var e = load8(data + pos + 1) & 0xFF;
            if (e == 34)    { store8(out + oi, 34); oi += 1; pos += 2; }
            elif (e == 92)  { store8(out + oi, 92); oi += 1; pos += 2; }
            elif (e == 47)  { store8(out + oi, 47); oi += 1; pos += 2; }
            elif (e == 110) { store8(out + oi, 10); oi += 1; pos += 2; }
            elif (e == 114) { store8(out + oi, 13); oi += 1; pos += 2; }
            elif (e == 116) { store8(out + oi, 9);  oi += 1; pos += 2; }
            elif (e == 98)  { store8(out + oi, 8);  oi += 1; pos += 2; }
            elif (e == 102) { store8(out + oi, 12); oi += 1; pos += 2; }
            elif (e == 117) {
                if (pos + 5 >= slen) { return (0, 0); }
                var h3 = _js_hexval(load8(data + pos + 2) & 0xFF);
                var h2 = _js_hexval(load8(data + pos + 3) & 0xFF);
                var h1 = _js_hexval(load8(data + pos + 4) & 0xFF);
                var h0 = _js_hexval(load8(data + pos + 5) & 0xFF);
                if (h3 < 0 || h2 < 0 || h1 < 0 || h0 < 0) { return (0, 0); }
                var cp = (h3 << 12) | (h2 << 8) | (h1 << 4) | h0;
                # ⚠ 2.8.12 — SURROGATE PAIRS. A code point above U+FFFF is
                # written in JSON as a high/low surrogate pair
                # (\uD83D\uDE00). Encoding each half separately gives CESU-8,
                # which is NOT valid UTF-8: the decoded bytes differ from what
                # every other JSON reader produces, so the same logical
                # document hashed differently depending on whether its
                # producer escaped non-BMP characters — the exact
                # non-normalization this release set out to remove.
                if (cp >= 55296 && cp < 56320) {
                    # High surrogate: a low surrogate must follow.
                    if (pos + 11 >= slen) { return (0, 0); }
                    if ((load8(data + pos + 6) & 0xFF) != 92) { return (0, 0); }
                    if ((load8(data + pos + 7) & 0xFF) != 117) { return (0, 0); }
                    var g3 = _js_hexval(load8(data + pos + 8) & 0xFF);
                    var g2 = _js_hexval(load8(data + pos + 9) & 0xFF);
                    var g1 = _js_hexval(load8(data + pos + 10) & 0xFF);
                    var g0 = _js_hexval(load8(data + pos + 11) & 0xFF);
                    if (g3 < 0 || g2 < 0 || g1 < 0 || g0 < 0) { return (0, 0); }
                    var lo = (g3 << 12) | (g2 << 8) | (g1 << 4) | g0;
                    if (lo < 56320 || lo >= 57344) { return (0, 0); }
                    cp = 65536 + ((cp - 55296) << 10) + (lo - 56320);
                    store8(out + oi, 240 | (cp >> 18)); oi += 1;
                    store8(out + oi, 128 | ((cp >> 12) & 63)); oi += 1;
                    store8(out + oi, 128 | ((cp >> 6) & 63)); oi += 1;
                    store8(out + oi, 128 | (cp & 63)); oi += 1;
                    pos += 12;
                } elif (cp >= 56320 && cp < 57344) {
                    # A lone low surrogate is not a character.
                    return (0, 0);
                } elif (cp < 128) {
                    store8(out + oi, cp); oi += 1;
                    pos += 6;
                } elif (cp < 2048) {
                    store8(out + oi, 192 | (cp >> 6)); oi += 1;
                    store8(out + oi, 128 | (cp & 63)); oi += 1;
                    pos += 6;
                } else {
                    store8(out + oi, 224 | (cp >> 12)); oi += 1;
                    store8(out + oi, 128 | ((cp >> 6) & 63)); oi += 1;
                    store8(out + oi, 128 | (cp & 63)); oi += 1;
                    pos += 6;
                }
                # ⚠ The advance is per-branch on purpose. A shared `pos += 6`
                # here silently ADDED to the surrogate branch's `pos += 12`,
                # overshooting by six, running past the closing quote and
                # making every surrogate pair fail to decode.
            } else {
                return (0, 0);
            }
        } else {
            store8(out + oi, c);
            oi += 1;
            pos += 1;
        }
    }
    return (0, 0);
}

# Feed `s` to `hasher` as a JSON string literal in RFC 8785 §3.2.2.2 minimal
# escaping: quote, backslash and the five short C0 forms; \u00XX (lowercase
# hex) for any other C0 byte; everything else verbatim.
fn _cjh_emit_json_string(hasher, s) {
    var d = str_data(s);
    var n = str_len(s);
    var quote[1];
    store8(&quote, 34);
    hasher_update(hasher, &quote, 1);
    var i = 0;
    while (i < n) {
        var c = load8(d + i) & 0xFF;
        if (c == 34)      { hasher_update(hasher, "\\\"", 2); }
        elif (c == 92)    { hasher_update(hasher, "\\\\", 2); }
        elif (c == 8)     { hasher_update(hasher, "\\b", 2); }
        elif (c == 12)    { hasher_update(hasher, "\\f", 2); }
        elif (c == 10)    { hasher_update(hasher, "\\n", 2); }
        elif (c == 13)    { hasher_update(hasher, "\\r", 2); }
        elif (c == 9)     { hasher_update(hasher, "\\t", 2); }
        elif (c < 32) {
            var ub[6];
            store8(&ub, 92); store8(&ub + 1, 117);
            store8(&ub + 2, 48); store8(&ub + 3, 48);
            store8(&ub + 4, _js_hexchar((c >> 4) & 0xF));
            store8(&ub + 5, _js_hexchar(c & 0xF));
            hasher_update(hasher, &ub, 6);
        } else {
            var one[1];
            store8(&one, c);
            hasher_update(hasher, &one, 1);
        }
        i += 1;
    }
    hasher_update(hasher, &quote, 1);
    return 0;
}

# ================================================================
# Canonical number form (2.8.12)
# ================================================================
#
# ⚠ BREAKING, and the second half of "canonical" finally meaning what ADR 0007
# always claimed. Through 2.8.11 a number was hashed as its SOURCE BYTES, so
# `1`, `1.0`, `1e0` and `1.00E+00` — one logical value, four ways a JSON
# writer might spell it — produced four different entry hashes. A consumer
# that round-tripped `details` through a library storing all numbers as
# doubles got a different hash for content it considered unchanged.
#
# The normal form is an exact plain decimal: no exponent, no leading zeros, no
# trailing fractional zeros, no "-0". It is computed with DIGIT-STRING
# arithmetic only — no float parsing, no shortest-round-trip formatter — so it
# is exact and deterministic, with none of the accident surface a Ryu/Grisu
# implementation in Cyrius would carry.
#
# ⚠ This deviates from RFC 8785, which mandates ECMAScript Number::toString
# (and would render 1e100 as "1e+100" rather than 101 digits). libro's form is
# exact where JCS's is shortest-round-trip; the two agree on every value whose
# decimal expansion is short, which is every value an audit payload carries.
# The deviation is deliberate and recorded in ADR 0007.
#
# Values too extreme to expand are REJECTED by the validator (see
# CJN_MAX_DIGITS) and take the raw fallback, which is injective — so the
# normal form is always bounded and there is no cliff where two spellings of
# one value straddle a cap.
var CJN_MAX_DIGITS = 1024;

# Parse a number's source text into (negative, digits Str, decimal exponent),
# where value = sign * digits * 10^exponent. Returns (0,0,0) if the exponent
# or digit count is out of range.
fn _cjn_parse(data, start, end) {
    var i = start;
    var neg = 0;
    if (i < end && (load8(data + i) & 0xFF) == 45) { neg = 1; i += 1; }

    var buf = alloc(end - start + 2);
    var n = 0;
    while (i < end) {
        var c = load8(data + i) & 0xFF;
        if (c < 48 || c > 57) { i = end; }
        else { store8(buf + n, c); n += 1; i += 1; }
    }
    # Re-scan: the loop above stops at the first non-digit, recompute position.
    i = start;
    if (neg == 1) { i += 1; }
    while (i < end && (load8(data + i) & 0xFF) >= 48
      && (load8(data + i) & 0xFF) <= 57) { i += 1; }

    var frac = 0;
    if (i < end && (load8(data + i) & 0xFF) == 46) {
        i += 1;
        while (i < end && (load8(data + i) & 0xFF) >= 48
          && (load8(data + i) & 0xFF) <= 57) {
            store8(buf + n, load8(data + i) & 0xFF);
            n += 1; frac += 1; i += 1;
        }
    }

    var exp = 0;
    if (i < end) {
        var ec = load8(data + i) & 0xFF;
        if (ec == 101 || ec == 69) {
            i += 1;
            var es = 1;
            if (i < end) {
                var sc = load8(data + i) & 0xFF;
                if (sc == 45) { es = 0 - 1; i += 1; }
                elif (sc == 43) { i += 1; }
            }
            var ev = 0;
            while (i < end && (load8(data + i) & 0xFF) >= 48
              && (load8(data + i) & 0xFF) <= 57) {
                ev = ev * 10 + ((load8(data + i) & 0xFF) - 48);
                if (ev > 1000000) { return (0, 0, 0); }
                i += 1;
            }
            exp = ev * es;
        }
    }
    if (n == 0) { return (0, 0, 0); }
    return (neg, str_new(buf, n), exp - frac);
}

# Emit the canonical decimal form of the number spanning [start, end).
fn _cjn_emit(hasher, data, start, end) {
    var neg, digits, e2 = _cjn_parse(data, start, end);
    if (digits == 0) {
        # Out of range: hash the source bytes. The validator rejects these
        # before they reach here, so this is belt-and-braces.
        hasher_update(hasher, data + start, end - start);
        return 0;
    }
    var d = str_data(digits);
    var n = str_len(digits);

    # Strip leading zeros, keeping at least one digit.
    var lead = 0;
    while (lead < n - 1 && (load8(d + lead) & 0xFF) == 48) { lead += 1; }
    d = d + lead;
    n = n - lead;

    # All zero -> "0", never "-0" and never "0.000".
    var allzero = 1;
    var z = 0;
    while (z < n) {
        if ((load8(d + z) & 0xFF) != 48) { allzero = 0; }
        z += 1;
    }
    if (allzero == 1) { hasher_update(hasher, "0", 1); return 0; }

    # Trailing zeros in the digit string can be absorbed into the exponent.
    while (n > 1 && (load8(d + n - 1) & 0xFF) == 48 && e2 < 0) {
        n -= 1; e2 += 1;
    }

    # ⚠ Size the buffer to THIS number, not to the cap. Allocating
    # CJN_MAX_DIGITS + 8 unconditionally cost 1,032 bytes of never-reclaimed
    # bump memory for every number in the document — measured at 1.19 MB of
    # bump per hash of a 10 KB details, re-paid on EVERY verify of every
    # entry. A digest is not supposed to allocate a hundred times its input.
    var need = n + 8;
    if (e2 >= 0) { need = n + e2 + 8; }
    else { need = n + (0 - e2) + 8; }
    var out = alloc(need);
    var o = 0;
    if (neg == 1) { store8(out + o, 45); o += 1; }

    if (e2 >= 0) {
        # Integer: digits followed by e2 zeros.
        memcpy(out + o, d, n); o += n;
        var k = 0;
        while (k < e2) { store8(out + o, 48); o += 1; k += 1; }
    } else {
        var k = 0 - e2;
        if (k < n) {
            memcpy(out + o, d, n - k); o += n - k;
            store8(out + o, 46); o += 1;
            memcpy(out + o, d + n - k, k); o += k;
        } else {
            store8(out + o, 48); o += 1;
            store8(out + o, 46); o += 1;
            var pad = k - n;
            var q = 0;
            while (q < pad) { store8(out + o, 48); o += 1; q += 1; }
            memcpy(out + o, d, n); o += n;
        }
        # Strip trailing fractional zeros, then a bare trailing point.
        while (o > 0 && (load8(out + o - 1) & 0xFF) == 48) { o -= 1; }
        if (o > 0 && (load8(out + o - 1) & 0xFF) == 46) { o -= 1; }
    }
    hasher_update(hasher, out, o);
    return 0;
}

# Would this number's canonical form fit in CJN_MAX_DIGITS? Used by the
# validator so an unbounded expansion is rejected up front rather than
# discovered mid-emit.
fn _cjn_in_range(data, start, end) {
    var neg, digits, e2 = _cjn_parse(data, start, end);
    if (digits == 0) { return 0; }
    var n = str_len(digits);
    if (e2 >= 0) {
        if (n + e2 > CJN_MAX_DIGITS) { return 0; }
    } else {
        var k = 0 - e2;
        if (k > CJN_MAX_DIGITS) { return 0; }
        if (n + k > CJN_MAX_DIGITS) { return 0; }
    }
    return 1;
}

# Maximum nesting depth accepted by the canonical-JSON hasher.
#
# 2.8.11. _cjh_emit / _cjh_emit_object / _cjh_emit_array are mutually
# recursive with one native frame per nesting level and had NO bound, so a
# `details` of ~130 KB of `[[[[…` drove the process into its guard page:
# SIGSEGV on append AND on every subsequent verify. `details` is untrusted on
# every ingress (proof import, JSONL reload, PatraStore row), so that was a
# remote crash in a verifier. The validator below enforces the cap BEFORE any
# emit runs, so the emit recursion inherits the same bound.
#
# 128 is far above any real audit payload and far below the ~8 MB default
# stack divided by the measured per-level frame cost.
var CJH_MAX_DEPTH = 128;

fn _cjv_hex4(data, p) {
    var a = _js_hexval(load8(data + p) & 0xFF);
    var b = _js_hexval(load8(data + p + 1) & 0xFF);
    var c = _js_hexval(load8(data + p + 2) & 0xFF);
    var d = _js_hexval(load8(data + p + 3) & 0xFF);
    return (a << 12) | (b << 8) | (c << 4) | d;
}

fn _cjv_is_hex(c) {
    if (c >= 48 && c <= 57) { return 1; }
    if (c >= 97 && c <= 102) { return 1; }
    if (c >= 65 && c <= 70) { return 1; }
    return 0;
}

# Strict RFC 8259 string. Precondition: data[pos] == '"'.
# Returns the position after the closing quote, or -1 if malformed.
fn _cjv_string(data, pos, slen) {
    pos += 1;
    while (pos < slen) {
        var c = load8(data + pos) & 0xFF;
        if (c == 34) { return pos + 1; }
        if (c == 92) {
            if (pos + 1 >= slen) { return 0 - 1; }
            var e = load8(data + pos + 1) & 0xFF;
            if (e == 117) {
                # \uXXXX — four hex digits required.
                if (pos + 5 >= slen) { return 0 - 1; }
                var k = 0;
                while (k < 4) {
                    if (_cjv_is_hex(load8(data + pos + 2 + k) & 0xFF) == 0) {
                        return 0 - 1;
                    }
                    k += 1;
                }
                # ⚠ 2.8.12 — surrogate pairing must be validated HERE, because
                # json_str_decode rejects a lone surrogate. If the validator
                # accepted what the decoder refuses, a document would pass
                # validation and then take the emitter's verbatim fallback —
                # a validator/emitter DISAGREEMENT, which is the one thing the
                # whole validate-then-emit design exists to prevent.
                var cpv = (_cjv_hex4(data, pos + 2) & 0xFFFF);
                if (cpv >= 55296 && cpv < 56320) {
                    if (pos + 11 >= slen) { return 0 - 1; }
                    if ((load8(data + pos + 6) & 0xFF) != 92) { return 0 - 1; }
                    if ((load8(data + pos + 7) & 0xFF) != 117) { return 0 - 1; }
                    var k2 = 0;
                    while (k2 < 4) {
                        if (_cjv_is_hex(load8(data + pos + 8 + k2) & 0xFF) == 0) {
                            return 0 - 1;
                        }
                        k2 += 1;
                    }
                    var lov = (_cjv_hex4(data, pos + 8) & 0xFFFF);
                    if (lov < 56320 || lov >= 57344) { return 0 - 1; }
                    pos += 12;
                } elif (cpv >= 56320 && cpv < 57344) {
                    return 0 - 1;
                } else {
                    pos += 6;
                }
            } elif (e == 34 || e == 92 || e == 47 || e == 98 || e == 102
              || e == 110 || e == 114 || e == 116) {
                pos += 2;
            } else {
                return 0 - 1;
            }
        } elif (c < 32) {
            # Raw control bytes are not permitted inside a JSON string.
            return 0 - 1;
        } else {
            pos += 1;
        }
    }
    return 0 - 1;
}

fn _cjv_digits(data, pos, slen) {
    var start = pos;
    while (pos < slen) {
        var c = load8(data + pos) & 0xFF;
        if (c < 48 || c > 57) { return pos; }
        pos += 1;
    }
    if (pos == start) { return start; }
    return pos;
}

# Strict RFC 8259 number. Returns end position or -1.
fn _cjv_number(data, pos, slen) {
    if (pos < slen && (load8(data + pos) & 0xFF) == 45) { pos += 1; }
    if (pos >= slen) { return 0 - 1; }
    var c = load8(data + pos) & 0xFF;
    if (c == 48) {
        pos += 1;
    } elif (c >= 49 && c <= 57) {
        var after = _cjv_digits(data, pos, slen);
        pos = after;
    } else {
        return 0 - 1;
    }
    if (pos < slen && (load8(data + pos) & 0xFF) == 46) {
        pos += 1;
        var fs = pos;
        pos = _cjv_digits(data, pos, slen);
        if (pos == fs) { return 0 - 1; }
    }
    if (pos < slen) {
        var ec = load8(data + pos) & 0xFF;
        if (ec == 101 || ec == 69) {
            pos += 1;
            if (pos < slen) {
                var sc = load8(data + pos) & 0xFF;
                if (sc == 43 || sc == 45) { pos += 1; }
            }
            var es = pos;
            pos = _cjv_digits(data, pos, slen);
            if (pos == es) { return 0 - 1; }
        }
    }
    return pos;
}

fn _cjv_literal(data, pos, slen, lit, llen) {
    if (pos + llen > slen) { return 0 - 1; }
    var k = 0;
    while (k < llen) {
        if ((load8(data + pos + k) & 0xFF) != (load8(lit + k) & 0xFF)) {
            return 0 - 1;
        }
        k += 1;
    }
    return pos + llen;
}

fn _cjv_object(data, pos, slen, depth) {
    pos += 1;
    pos = _cjh_skip_ws(data, pos, slen);
    if (pos < slen && (load8(data + pos) & 0xFF) == 125) { return pos + 1; }
    var stop = 0;
    while (stop == 0) {
        pos = _cjh_skip_ws(data, pos, slen);
        if (pos >= slen) { return 0 - 1; }
        if ((load8(data + pos) & 0xFF) != 34) { return 0 - 1; }
        pos = _cjv_string(data, pos, slen);
        if (pos < 0) { return 0 - 1; }
        pos = _cjh_skip_ws(data, pos, slen);
        # The colon is MANDATORY. Through 2.8.10 it was optional, so
        # {"a" 1} and {"a":1} hashed identically.
        if (pos >= slen || (load8(data + pos) & 0xFF) != 58) { return 0 - 1; }
        pos += 1;
        pos = _cjv_value(data, pos, slen, depth + 1);
        if (pos < 0) { return 0 - 1; }
        pos = _cjh_skip_ws(data, pos, slen);
        if (pos >= slen) { return 0 - 1; }
        var d = load8(data + pos) & 0xFF;
        if (d == 44) { pos += 1; }
        elif (d == 125) { pos += 1; stop = 1; }
        else { return 0 - 1; }
    }
    return pos;
}

fn _cjv_array(data, pos, slen, depth) {
    pos += 1;
    pos = _cjh_skip_ws(data, pos, slen);
    if (pos < slen && (load8(data + pos) & 0xFF) == 93) { return pos + 1; }
    var stop = 0;
    while (stop == 0) {
        pos = _cjv_value(data, pos, slen, depth + 1);
        if (pos < 0) { return 0 - 1; }
        pos = _cjh_skip_ws(data, pos, slen);
        if (pos >= slen) { return 0 - 1; }
        var d = load8(data + pos) & 0xFF;
        if (d == 44) { pos += 1; }
        elif (d == 93) { pos += 1; stop = 1; }
        else { return 0 - 1; }
    }
    return pos;
}

# Strict validator for one JSON value. Returns end position or -1.
fn _cjv_value(data, pos, slen, depth) {
    if (depth > CJH_MAX_DEPTH) { return 0 - 1; }
    pos = _cjh_skip_ws(data, pos, slen);
    if (pos >= slen) { return 0 - 1; }
    var c = load8(data + pos) & 0xFF;
    if (c == 123) { return _cjv_object(data, pos, slen, depth); }
    if (c == 91)  { return _cjv_array(data, pos, slen, depth); }
    if (c == 34)  { return _cjv_string(data, pos, slen); }
    if (c == 116) { return _cjv_literal(data, pos, slen, "true", 4); }
    if (c == 102) { return _cjv_literal(data, pos, slen, "false", 5); }
    if (c == 110) { return _cjv_literal(data, pos, slen, "null", 4); }
    var nend = _cjv_number(data, pos, slen);
    if (nend < 0) { return 0 - 1; }
    # 2.8.12 — reject a number whose exact decimal expansion would be
    # unbounded (1e100000). Rejecting here rather than truncating in the
    # emitter is what keeps the canonical form total: everything the validator
    # accepts has a bounded normal form, and everything it rejects takes the
    # injective raw fallback. No cliff where two spellings straddle a cap.
    if (_cjn_in_range(data, pos, nend) == 0) { return 0 - 1; }
    return nend;
}

# Is the whole buffer exactly one well-formed JSON value (plus optional
# surrounding whitespace)?
fn canonical_json_is_valid(json_str) {
    var slen = str_len(json_str);
    if (slen == 0) { return 0; }
    var d = str_data(json_str);
    var end = _cjv_value(d, 0, slen, 0);
    if (end < 0) { return 0; }
    end = _cjh_skip_ws(d, end, slen);
    if (end != slen) { return 0; }
    return 1;
}

# Canonical-JSON contribution to a hash preimage.
#
# ⚠ 2.8.11 — THE COLLISION FIX. Through 2.8.10 the emitters were tolerant:
# _cjh_emit_object's `else { pos += 1; }` fallthrough silently dropped any
# byte it did not recognise, the colon was optional, and trailing bytes after
# the top-level value were ignored. Measured on 2.8.10, all five of these
# produced the SAME digest 015abd7f5cc57a2d…:
#
#     {"a":1}        {ZZZZ"a":1}      {"a":1 JUNK}
#     {"a" 1}        {"a":1}XXXXXXX
#
# Those collisions are a forgery primitive, not a cosmetic defect: the
# injected bytes sit INSIDE a stored `details`, so a record could be rewritten
# — {"a":1} to {approved_by_legal"a":1} — with the entry hash, the chain
# linkage, the Merkle root and any tree-head signature all unchanged, and
# verify_chain returning clean. Any junk free of '"', ',' and '}' worked.
#
# The document is now validated STRICTLY first. Well-formed input takes the
# same canonical path as before (identical digest — this half is not a
# format change). Anything else falls back to a 0x00-tagged, length-prefixed
# hash of the raw bytes: distinct from every canonical emission (which never
# begins 0x00) and injective among malformed inputs, so a malformed document
# can no longer collide with anything at all.
fn canonical_json_hash_str(json_str, hasher) {
    # ⚠ 2.8.12 — an ABSENT or EMPTY details no longer hashes as the literal
    # bytes `null`. It used to, and `null` is also a perfectly valid JSON
    # document whose canonical emission is those same four bytes — so
    # details="" and details="null" produced the IDENTICAL preimage. That is a
    # collision between two distinct stored records, which is the exact class
    # 2.8.11 was written to eliminate, sitting in the one branch that took a
    # shortcut past the canonicaliser.
    #
    # Empty is not well-formed JSON, so it now takes the same 0x00-tagged,
    # length-prefixed raw path as any other malformed input: injective, and
    # distinct from every canonical emission.
    if (json_str == 0) {
        _cjh_raw_tag(hasher);
        hash_field(hasher, "", 0);
        return 0;
    }
    var slen = str_len(json_str);
    if (slen == 0) {
        _cjh_raw_tag(hasher);
        hash_field(hasher, "", 0);
        return 0;
    }
    var sdata = str_data(json_str);
    if (canonical_json_is_valid(json_str) == 0) {
        _cjh_raw_tag(hasher);
        hash_field(hasher, sdata, slen);
        return 0;
    }
    _cjh_emit(sdata, 0, slen, hasher);
    return 0;
}

# 2.8.12 — stack, not a process global. Same reasoning as _merkle_tag: a
# shared one-byte staging buffer between a store and a hasher read is a
# cross-thread hazard, and this one decides whether a digest is a canonical
# emission or a raw fallback.
fn _cjh_raw_tag(hasher) {
    var tagbuf[1];
    store8(&tagbuf, 0);
    hasher_update(hasher, &tagbuf, 1);
    return 0;
}

# Lexicographic Str comparison: returns <0, 0, or >0
fn _str_cmp(a, b) {
    var alen = str_len(a);
    var blen = str_len(b);
    var ad = str_data(a);
    var bd = str_data(b);
    var minlen = alen;
    if (blen < minlen) { minlen = blen; }
    var i = 0;
    while (i < minlen) {
        var ca = load8(ad + i) & 0xFF;
        var cb = load8(bd + i) & 0xFF;
        if (ca != cb) { return ca - cb; }
        i += 1;
    }
    return alen - blen;
}

fn _cjh_is_ws(c) {
    if (c == 32 || c == 10 || c == 13 || c == 9) { return 1; }
    return 0;
}

fn _cjh_skip_ws(data, pos, slen) {
    while (pos < slen && _cjh_is_ws(load8(data + pos) & 0xFF) == 1) { pos += 1; }
    return pos;
}

# Skip past a string (incl. surrounding quotes); handles backslash escapes.
# Precondition: data[pos] == '"'. Returns position *after* the closing quote.
fn _cjh_skip_string(data, pos, slen) {
    pos += 1;
    var stop = 0;
    while (pos < slen && stop == 0) {
        var c = load8(data + pos) & 0xFF;
        if (c == 92) {
            pos += 2;
        } elif (c == 34) {
            pos += 1;
            stop = 1;
        } else {
            pos += 1;
        }
    }
    return pos;
}

# Skip past a bracket-balanced span starting at `open` (123='{' or 91='[').
fn _cjh_skip_container(data, pos, slen, open, close) {
    pos += 1;
    var depth = 1;
    while (pos < slen && depth > 0) {
        var c = load8(data + pos) & 0xFF;
        if (c == 34) {
            pos = _cjh_skip_string(data, pos, slen);
        } elif (c == open) {
            depth += 1;
            pos += 1;
        } elif (c == close) {
            depth -= 1;
            pos += 1;
        } else {
            pos += 1;
        }
    }
    return pos;
}

# Skip past a scalar (number / true / false / null) — stops at
# delimiter byte (whitespace, ',', '}', ']').
fn _cjh_skip_scalar(data, pos, slen) {
    while (pos < slen) {
        var c = load8(data + pos) & 0xFF;
        if (c == 44 || c == 125 || c == 93 || _cjh_is_ws(c) == 1) { return pos; }
        pos += 1;
    }
    return pos;
}

fn _cjh_skip_value(data, pos, slen) {
    pos = _cjh_skip_ws(data, pos, slen);
    if (pos >= slen) { return pos; }
    var c = load8(data + pos) & 0xFF;
    if (c == 34)  { return _cjh_skip_string(data, pos, slen); }
    if (c == 123) { return _cjh_skip_container(data, pos, slen, 123, 125); }
    if (c == 91)  { return _cjh_skip_container(data, pos, slen, 91, 93); }
    return _cjh_skip_scalar(data, pos, slen);
}

# Emit any JSON value starting at `pos`. Returns position after the value.
fn _cjh_emit(data, pos, slen, hasher) {
    pos = _cjh_skip_ws(data, pos, slen);
    if (pos >= slen) { return pos; }
    var c = load8(data + pos) & 0xFF;
    if (c == 123) { return _cjh_emit_object(data, pos, slen, hasher); }
    if (c == 91)  { return _cjh_emit_array(data, pos, slen, hasher); }
    if (c == 34)  {
        # 2.8.12 — NORMALIZE. Through 2.8.11 the string's source bytes were
        # hashed verbatim, escapes and all, so "A" and "\u0041" — the same
        # logical value — produced different digests. Decode, then re-emit in
        # minimal escaping, so the digest depends on the VALUE and not on
        # which JSON writer produced it.
        var sv, send = json_str_decode(data, pos, slen);
        if (sv == 0) {
            # The validator ran first, so this is unreachable; fall back to
            # verbatim rather than silently emitting nothing.
            var end = _cjh_skip_string(data, pos, slen);
            hasher_update(hasher, data + pos, end - pos);
            return end;
        }
        _cjh_emit_json_string(hasher, sv);
        return send;
    }
    # Scalar. 2.8.12 — a NUMBER is emitted in canonical decimal form so that
    # 1 / 1.0 / 1e0 / 1.00E+00 agree; true / false / null are single spellings
    # already and go out verbatim.
    var scalar_end = _cjh_skip_scalar(data, pos, slen);
    if (c == 116 || c == 102 || c == 110) {
        hasher_update(hasher, data + pos, scalar_end - pos);
    } else {
        _cjn_emit(hasher, data, pos, scalar_end);
    }
    return scalar_end;
}

# Stable bottom-up merge sort of `idx` by keys[idx[i]] lexicographically.
#
# 2.8.11 — was an insertion sort, i.e. O(n^2) string comparisons over
# ATTACKER-CONTROLLED object keys, re-paid on every entry_compute_hash and so
# on every verify of every entry. Measured on 2.8.10: a single 1 MiB `details`
# of many short keys cost minutes of CPU per hash. Keys arrive from untrusted
# JSON on every ingress path, so the cost was remotely selectable.
#
# Stability (`<= 0` takes the left run) reproduces the insertion sort's
# ordering for equal keys exactly, so duplicate keys keep their document
# order and no well-formed document's digest moves.
fn _cjh_sort_idx(idx, keys, n) {
    if (n < 2) { return 0; }
    var buf = vec_new();
    var i = 0;
    while (i < n) { vec_push(buf, 0); i += 1; }

    var width = 1;
    while (width < n) {
        var lo = 0;
        while (lo < n) {
            var mid = lo + width;
            var hi = lo + width * 2;
            if (mid > n) { mid = n; }
            if (hi > n) { hi = n; }
            var a = lo;
            var b = mid;
            var o = lo;
            while (o < hi) {
                var take_a = 0;
                if (a < mid && b < hi) {
                    if (_str_cmp(vec_get(keys, vec_get(idx, a)),
                        vec_get(keys, vec_get(idx, b))) <= 0) {
                        take_a = 1;
                    }
                } elif (a < mid) {
                    take_a = 1;
                }
                if (take_a == 1) {
                    vec_set(buf, o, vec_get(idx, a));
                    a += 1;
                } else {
                    vec_set(buf, o, vec_get(idx, b));
                    b += 1;
                }
                o += 1;
            }
            lo = hi;
        }
        i = 0;
        while (i < n) { vec_set(idx, i, vec_get(buf, i)); i += 1; }
        width = width * 2;
    }
    return 0;
}

# Emit an object with keys sorted lexicographically. Parallel vecs hold
# each pair's key and its value byte-range in `data` so we can recurse
# into values after sort without materializing an AST.
fn _cjh_emit_object(data, start, slen, hasher) {
    var pos = start + 1;
    var keys = vec_new();
    var val_starts = vec_new();
    var val_ends = vec_new();

    var stop = 0;
    while (pos < slen && stop == 0) {
        pos = _cjh_skip_ws(data, pos, slen);
        if (pos >= slen) { stop = 1; }
        elif ((load8(data + pos) & 0xFF) == 125) { pos += 1; stop = 1; }
        elif ((load8(data + pos) & 0xFF) == 44) { pos += 1; }
        elif ((load8(data + pos) & 0xFF) == 34) {
            # 2.8.12 — keys are DECODED before they are sorted and emitted.
            # Sorting raw source bytes made "\u0041" order differently from
            # "A" and emit differently too, so two encodings of one object
            # produced two digests.
            var k, kend = json_str_decode(data, pos, slen);
            if (k == 0) { return pos; }
            pos = _cjh_skip_ws(data, kend, slen);
            if (pos < slen && (load8(data + pos) & 0xFF) == 58) { pos += 1; }
            pos = _cjh_skip_ws(data, pos, slen);
            var vs = pos;
            pos = _cjh_skip_value(data, pos, slen);
            var ve = pos;
            vec_push(keys, k);
            vec_push(val_starts, vs);
            vec_push(val_ends, ve);
        } else {
            pos += 1;
        }
    }

    var n = vec_len(keys);
    var idx = vec_new();
    var i = 0;
    while (i < n) { vec_push(idx, i); i += 1; }

    _cjh_sort_idx(idx, keys, n);

    hasher_update(hasher, "{", 1);
    i = 0;
    while (i < n) {
        if (i > 0) { hasher_update(hasher, ",", 1); }
        var j2 = vec_get(idx, i);
        var k2 = vec_get(keys, j2);
        _cjh_emit_json_string(hasher, k2);
        hasher_update(hasher, ":", 1);
        _cjh_emit(data, vec_get(val_starts, j2), vec_get(val_ends, j2), hasher);
        i += 1;
    }
    hasher_update(hasher, "}", 1);
    return pos;
}

# Emit an array in original order.
fn _cjh_emit_array(data, start, slen, hasher) {
    var pos = start + 1;
    hasher_update(hasher, "[", 1);
    var count = 0;
    var stop = 0;
    while (pos < slen && stop == 0) {
        pos = _cjh_skip_ws(data, pos, slen);
        if (pos >= slen) { stop = 1; }
        elif ((load8(data + pos) & 0xFF) == 93) { pos += 1; stop = 1; }
        elif ((load8(data + pos) & 0xFF) == 44) { pos += 1; }
        else {
            if (count > 0) { hasher_update(hasher, ",", 1); }
            pos = _cjh_emit(data, pos, slen, hasher);
            count += 1;
        }
    }
    hasher_update(hasher, "]", 1);
    return pos;
}

# Convert Str to null-terminated C string (for json_get lookup)
fn _entry_to_cstr(s) {
    if (s == 0) { return ""; }
    var len = str_len(s);
    var buf = alloc(len + 1);
    memcpy(buf, str_data(s), len);
    store8(buf + len, 0);
    return buf;
}

# ================================================================
# Entry construction
# ================================================================

fn entry_new(severity, source, action, details, prev_hash) {
    var e = fl_alloc(88);
    # The algorithm name is invariant for the life of the entry, so it is set
    # once here and `entry_refill` below deliberately leaves it alone.
    store64(e + 80, str_from(HASH_ALGORITHM));
    return entry_refill(e, severity, source, action, details, prev_hash);
}

# Overwrite an EXISTING entry in place: everything `entry_new` does except the
# 88-byte allocation and the algorithm Str, both of which are invariant across
# appends. 2.9.0.
#
# ⚠ THIS IS NOT A GENERAL-PURPOSE ENTRY MUTATOR. It exists for
# `chain_append_nokeep`, whose contract is that the entry is scratch — a
# streaming chain retains nothing, so the struct is dead the moment
# `_chain_retain` has taken its hash. Calling it on an entry anyone still holds
# rewrites that entry underneath them.
#
# Linkage is byte-identical to `entry_new`'s: `entry_compute_hash` reads only
# the struct's fields, so filling the same struct produces the same hash as
# allocating a fresh one. That is the property kybernet 1.6.12 relied on when it
# made the chain stream at all, and it is what keeps `audit_persist`
# deployments verifying across this change.
fn entry_refill(e, severity, source, action, details, prev_hash) {
    # Generate UUID v4 (writes 16 bytes at e+0)
    uuid_v4(e);

    # Generate timestamp
    var ts = timestamp_rfc3339(get_epoch_secs());
    store64(e + 16, ts);

    store64(e + 24, severity);
    store64(e + 32, source);
    store64(e + 40, action);
    store64(e + 48, details);
    store64(e + 56, 0);
    store64(e + 64, prev_hash);

    # Compute and store hash
    var hash = entry_compute_hash(e);
    store64(e + 72, hash);
    return e;
}

fn entry_with_agent(e, agent_id) {
    store64(e + 56, agent_id);
    var hash = entry_compute_hash(e);
    store64(e + 72, hash);
    return e;
}

# Validated entry construction — checks field lengths
fn entry_new_validated(severity, source, action, details, prev_hash) {
    if (str_len(source) > MAX_SOURCE_LEN) {
        return error_field("source", str_len(source), MAX_SOURCE_LEN);
    }
    if (str_len(action) > MAX_ACTION_LEN) {
        return error_field("action", str_len(action), MAX_ACTION_LEN);
    }
    if (str_len(details) > MAX_DETAILS_SIZE) {
        return error_field("details", str_len(details), MAX_DETAILS_SIZE);
    }
    return entry_new(severity, source, action, details, prev_hash);
}

# ================================================================
# Hash computation — must match Rust field order exactly
# ================================================================
# Order: id(16 raw, no prefix) → timestamp → severity_str →
#         source → action → canonical_json(details) →
#         agent_id → prev_hash (all length-prefixed)

fn entry_compute_hash(e) {
    var hasher = hasher_new();

    # 1. UUID (16 raw bytes, no prefix)
    hasher_update(hasher, e, 16);

    # 2. Timestamp (length-prefixed)
    var ts = load64(e + 16);
    hash_field(hasher, str_data(ts), str_len(ts));

    # 3. Severity string (length-prefixed). severity_len avoids a strlen
    # on the constant cstr that severity_as_str returns.
    var sev_val = load64(e + 24);
    hash_field(hasher, severity_as_str(sev_val), severity_len(sev_val));

    # 4. Source (length-prefixed)
    var src = load64(e + 32);
    hash_field(hasher, str_data(src), str_len(src));

    # 5. Action (length-prefixed)
    var act = load64(e + 40);
    hash_field(hasher, str_data(act), str_len(act));

    # 6. Canonical JSON of details
    var det = load64(e + 48);
    canonical_json_hash_str(det, hasher);

    # 7. Agent ID (empty string if none, length-prefixed)
    var aid = load64(e + 56);
    if (aid == 0) {
        hash_field(hasher, "", 0);
    } else {
        hash_field(hasher, str_data(aid), str_len(aid));
    }

    # 8. Previous hash (length-prefixed)
    var ph = load64(e + 64);
    hash_field(hasher, str_data(ph), str_len(ph));

    # 9. Hash algorithm (length-prefixed). 2.8.11 — was OUTSIDE the preimage
    # through 2.8.10, so `entry_set_hash_algorithm(e, "md5-lol")` mutated a
    # field on a tamper-evident record and `entry_verify` still returned 1.
    # Every serializer round-trips it (export.cyr, file_store.cyr, proof JSON)
    # and _filestore_parse_entry reads it straight off disk, so it was an
    # attacker-writable field. The sibling struct already got this right —
    # anchor_compute_hash step 5 length-prefixes hash_alg (anchoring.cyr:85).
    # ⚠ This CHANGES every entry hash. See CHANGELOG [2.8.11].
    var alg = load64(e + 80);
    if (alg == 0) {
        hash_field(hasher, "", 0);
    } else {
        hash_field(hasher, str_data(alg), str_len(alg));
    }

    return hasher_finalize_hex(hasher);
}

# ================================================================
# Entry verification — recompute hash and compare
# ================================================================

fn entry_verify(e) {
    var computed = entry_compute_hash(e);
    var stored = load64(e + 72);
    return constant_time_eq_str(computed, stored);
}

# Release an entry's 88-byte struct back to the freelist (2.8.4).
#
# For a streaming chain (chain_new_streaming) the caller owns each entry once it
# has been persisted, and this is how it hands it back. Safe to call on any
# entry the chain no longer references; calling it on one still reachable from a
# retaining chain's entries vec is a use-after-free waiting to happen.
#
# Scope, stated plainly: this frees the STRUCT, not the Strs it points at.
# `source` / `action` / `details` are caller-owned and never libro's to release,
# and the ones entry_new mints itself (timestamp, hash, algorithm) come from
# `str_new`, which allocates via the bump allocator — that memory has no free at
# this layer and cannot be reclaimed without an allocator change. So this bounds
# the per-entry struct cost, and a streaming chain bounds the vec; the Str
# residue is a separate, smaller problem recorded in the CHANGELOG.
fn entry_free(e) {
    if (e == 0) { return 0; }
    fl_free(e);
    return 0;
}
