# file_store.cyr — append-only JSON Lines file backend
# Uses flock for concurrent-process safety.
# Each entry is one JSON object per line (JSON Lines format).

# ================================================================
# FileStore — generated accessors:
#   filestore_path, filestore_count (+ setters), filestore_cpath
# `cpath` is the null-terminated cstr cached once at open.
# ================================================================
#derive(accessors)
struct filestore { path; count; cpath; }

fn filestore_open(path) {
    sakshi_info("filestore: open", 15);
    var s = fl_alloc(24);
    store64(s, path);
    store64(s + 8, -1);

    var cpath = _entry_to_cstr(path);
    store64(s + 16, cpath);

    if (file_exists(cpath) == 0) {
        var fd = file_open(cpath, O_WRONLY | O_CREAT, 0x1A4);
        if (fd >= 0) { file_close(fd); }
    }
    return s;
}

# ================================================================
# Append — write entry as JSON line with exclusive lock
# ================================================================

fn filestore_append(s, e) {
    sakshi_debug("filestore: append", 17);
    var cpath = filestore_cpath(s);

    # Build JSON line
    var sb = str_builder_new();
    _filestore_entry_json(sb, e);
    str_builder_add_cstr(sb, "\n");
    var line = str_builder_build(sb);

    # Atomic append with lock
    file_append_locked(cpath, str_data(line), str_len(line));

    # Invalidate count cache
    store64(s + 8, -1);
    return 0;
}

# ================================================================
# Load all — read file, parse JSON Lines, return vec of entries
# ================================================================
# Scratch read buffer — right-sized per call via lseek(fd, 0, SEEK_END),
# so the bump allocator never orphans 64KB-doubling intermediate buffers
# on large files. 2.0 replaced the 1.x doubling scheme; see CHANGELOG.

var _fs_buf = 0;
var _fs_buf_size = 0;

# lseek(fd, 0, SEEK_END) — returns the file's size in bytes, or -1 on error.
# Symbolic SYS_LSEEK (Linux #8 / agnos #58) — a raw syscall(8) is `dup` on agnos.
fn _fs_file_size(fd) {
    return syscall(SYS_LSEEK, fd, 0, 2);
}

# Load every entry, or a libro error object if the file cannot be READ.
#
# ⚠ 2.8.11. filestore_load_all returned an empty vec when the open failed —
# byte-identical to a healthy but empty log. filestore_load_and_verify then
# verified that empty vec, found nothing wrong, and reported SUCCESS. A
# deleted, renamed, or permission-stripped audit log therefore "verified
# clean", which is precisely the outcome an attacker deleting the log wants.
# Use libro_is_error() on the result.
fn filestore_load_all_or_err(s) {
    sakshi_info("filestore: load all", 19);
    var cpath = filestore_cpath(s);
    var fd = file_open(cpath, O_RDONLY, 0);
    if (fd < 0) {
        sakshi_error("filestore: open failed", 22);
        return error_new(LIBRO_ERR_IO, "filestore: cannot open log for reading");
    }

    # Shared lock for reading
    file_lock_shared(fd);

    # Size the read buffer to the file exactly (fall back to 4 KB for empty).
    var fsize = _fs_file_size(fd);
    if (fsize < 0) { fsize = 0; }
    syscall(SYS_LSEEK, fd, 0, 0);  # lseek back to SEEK_SET so file_read starts at 0
    var needed = fsize + 1;
    if (needed < 4096) { needed = 4096; }
    if (needed > _fs_buf_size) {
        _fs_buf = alloc(needed);
        _fs_buf_size = needed;
    }

    var total_read = 0;
    var entries = vec_new();

    var read_done = 0;
    while (read_done == 0) {
        var n = file_read(fd, _fs_buf + total_read, _fs_buf_size - total_read);
        if (n <= 0) {
            read_done = 1;
        } else {
            total_read = total_read + n;
        }
    }

    file_unlock(fd);
    file_close(fd);

    # Parse JSON Lines
    var pos = 0;
    while (pos < total_read) {
        # Find end of line
        var eol = pos;
        while (eol < total_read && (load8(_fs_buf + eol) & 0xFF) != 10) {
            eol += 1;
        }

        var line_len = eol - pos;
        if (line_len > 0) {
            # Clone the line out of the shared `_fs_buf` read buffer before
            # parsing. `_fs_buf` is re-used (and may be reallocated larger)
            # on the next `filestore_load_all` call, so any `Str` that
            # wraps a pointer into it — including the derived
            # `str_new(data + offset, ...)` pointers produced by
            # `json_parse` — would dangle once a second load runs.
            # See docs/audit/2026-04-19-audit.md Finding 3.
            var line_str = str_clone(str_new(_fs_buf + pos, line_len));
            var e = _filestore_parse_entry(line_str);
            if (e != 0) {
                vec_push(entries, e);
            }
        }

        pos = eol + 1;
    }

    store64(s + 8, vec_len(entries));
    return entries;
}

# Legacy shape: always a vec, empty when the log could not be read.
# Retained so existing consumers keep compiling; prefer the _or_err form,
# which can tell "unreadable" from "empty".
fn filestore_load_all(s) {
    var r = filestore_load_all_or_err(s);
    if (libro_is_error(r) == 1) { return vec_new(); }
    return r;
}

# ================================================================
# Len — count entries (loads if cache invalid)
# ================================================================

var _fs_lenbuf = 0;

fn filestore_len(s) {
    var cached = load64(s + 8);
    if (cached != -1) { return cached; }

    # Count lines in file
    var cpath = filestore_cpath(s);
    var fd = file_open(cpath, O_RDONLY, 0);
    if (fd < 0) { return 0; }
    file_lock_shared(fd);

    # 2.8.11 — reuse the module scratch buffer. This was `alloc(4096)` on
    # every call, and alloc() is the bump allocator: never reclaimed. A
    # long-lived consumer polling filestore_len leaked 4 KB per call.
    if (_fs_lenbuf == 0) { _fs_lenbuf = alloc(4096); }
    var buf = _fs_lenbuf;
    var count = 0;
    var n = 1;
    while (n > 0) {
        n = file_read(fd, buf, 4096);
        var i = 0;
        while (i < n) {
            if ((load8(buf + i) & 0xFF) == 10) { count = count + 1; }
            i += 1;
        }
    }

    file_unlock(fd);
    file_close(fd);
    store64(s + 8, count);
    return count;
}

fn filestore_is_empty(s) {
    if (filestore_len(s) == 0) { return 1; }
    return 0;
}

# ================================================================
# Load and verify
# ================================================================

fn filestore_load_and_verify(s) {
    var entries = filestore_load_all_or_err(s);
    # 2.8.11 — propagate an unreadable log instead of verifying an empty vec
    # and reporting success. See filestore_load_all_or_err.
    if (libro_is_error(entries) == 1) { return entries; }
    var err = verify_chain(entries, 0);
    if (err != 0) {
        sakshi_error("filestore: verification failed", 30);
        return err;
    }
    return entries;
}

# ================================================================
# Streaming verification — O(chunk_size) entry-pointer memory
# ================================================================
# Reads the JSONL file in 64KB byte chunks, parsing one line at a time
# and verifying in groups of `chunk_size` entries. Cross-chunk linkage
# is carried via `prev_tail_hash`, so it's equivalent to verify_chain
# over the full file. Returns total verified count on success, or an
# error pointer on failure.
#
# Lines longer than 64KB are not supported (asserts via `assert` on
# buffer-full without newline). Current entry JSON is well under this.

var _fsvs_buf_size = 65536;
var _fsvs_buf = 0;

fn filestore_verify_streamed(s, chunk_size) {
    sakshi_info("filestore: verify streamed", 26);
    if (chunk_size < 1) { chunk_size = 1; }
    if (_fsvs_buf == 0) { _fsvs_buf = alloc(_fsvs_buf_size); }

    var cpath = filestore_cpath(s);
    var fd = file_open(cpath, O_RDONLY, 0);
    # 2.8.11 — returned 0, which is ALSO this function's success value for a
    # valid empty log, so an unreadable file read as "verified, nothing wrong".
    if (fd < 0) {
        return error_new(LIBRO_ERR_IO,
          "filestore: cannot open log for streamed verification");
    }
    file_lock_shared(fd);

    var buf_fill = 0;
    var chunk = vec_new();
    var verified = 0;
    var offset = 0;
    var prev_tail_hash = libro_empty_str();

    var eof = 0;
    while (eof == 0 || buf_fill > 0) {
        if (eof == 0 && buf_fill < _fsvs_buf_size) {
            var n = file_read(fd, _fsvs_buf + buf_fill, _fsvs_buf_size - buf_fill);
            if (n <= 0) { eof = 1; } else { buf_fill = buf_fill + n; }
        }

        var consumed = 0;
        var scan_done = 0;
        while (scan_done == 0) {
            var nl = -1;
            var i = consumed;
            while (i < buf_fill && nl < 0) {
                if ((load8(_fsvs_buf + i) & 0xFF) == 10) { nl = i; }
                i += 1;
            }
            if (nl < 0) {
                scan_done = 1;
            } else {
                var line_len = nl - consumed;
                if (line_len > 0) {
                    var line_str = str_clone(str_new(_fsvs_buf + consumed, line_len));
                    var e = _filestore_parse_entry(line_str);
                    if (e != 0) {
                        vec_push(chunk, e);
                        if (vec_len(chunk) >= chunk_size) {
                            var err = _fsvs_verify_chunk(chunk, offset, prev_tail_hash);
                            if (err != 0) {
                                file_unlock(fd);
                                file_close(fd);
                                return err;
                            }
                            var last = vec_get(chunk, vec_len(chunk) - 1);
                            prev_tail_hash = entry_hash(last);
                            verified = verified + vec_len(chunk);
                            offset = offset + vec_len(chunk);
                            chunk = vec_new();
                        }
                    }
                }
                consumed = nl + 1;
            }
        }

        if (consumed > 0) {
            if (consumed < buf_fill) {
                memcpy(_fsvs_buf, _fsvs_buf + consumed, buf_fill - consumed);
            }
            buf_fill = buf_fill - consumed;
        }

        # Terminal-line handling at EOF. Without this the outer loop
        # spins forever when the file has bytes after the last newline:
        # `eof == 0 || buf_fill > 0` stays true, inner scan finds no
        # newline, `consumed` stays 0, no progress. Inject a synthetic
        # newline so the scan loop treats the residual as a final line
        # on the next iteration, then exits via the usual path.
        # Caught by fuzz_filestore_verify_streamed in 2.0.3.
        if (eof == 1 && consumed == 0 && buf_fill > 0 && buf_fill < _fsvs_buf_size) {
            store8(_fsvs_buf + buf_fill, 10);
            buf_fill = buf_fill + 1;
        }

        if (buf_fill >= _fsvs_buf_size) {
            sakshi_error("filestore: verify streamed — line exceeds 64KB", 47);
            file_unlock(fd);
            file_close(fd);
            # 2.8.11 — was `return 0`, i.e. "verified successfully, zero
            # entries". An over-long line ABORTS the scan with entries left
            # unverified; that must not read as a clean result.
            return error_new(LIBRO_ERR_IO,
              "filestore: record exceeds 64KB, verification aborted");
        }
    }

    file_unlock(fd);
    file_close(fd);

    if (vec_len(chunk) > 0) {
        var err2 = _fsvs_verify_chunk(chunk, offset, prev_tail_hash);
        if (err2 != 0) { return err2; }
        verified = verified + vec_len(chunk);
    }

    return verified;
}

# Verify a chunk's internal linkage and boundary against the prior tail hash.
fn _fsvs_verify_chunk(chunk, offset, prev_tail_hash) {
    var clen = vec_len(chunk);
    if (clen == 0) { return 0; }
    if (offset > 0) {
        var first = vec_get(chunk, 0);
        var fp = entry_prev_hash(first);
        if (constant_time_eq_str(fp, prev_tail_hash) == 0) {
            return error_integrity(offset, prev_tail_hash, fp);
        }
    }
    return verify_chain(chunk, offset);
}

# ================================================================
# Query — load all, apply filter
# ================================================================

fn filestore_query(s, filter) {
    var entries = filestore_load_all(s);
    return query_apply(filter, entries);
}

# ================================================================
# JSON serialization for entries
# ================================================================

# Serialize entry to flat JSON (all values as strings for stdlib json compat).
# Details is stored as an escaped string value, not a nested object.
fn _filestore_entry_json(sb, e) {
    # ⚠ 2.8.12 — EVERY field goes through _sb_json_escape.
    #
    # The 2.8.11 migration escaped source, action, details and agent_id and
    # stopped there, leaving timestamp, prev_hash, hash and hash_algorithm on
    # raw str_builder_add. All four are writable through public setters
    # (entry_set_timestamp, entry_set_hash_algorithm, …) and all four carry
    # whatever a producer put there on an entry parsed from an untrusted
    # proof — so a quote in any of them broke the record on reload, and a
    # crafted value could close its own JSON string and inject a sibling key.
    # Escaping three quarters of the fields is not escaping.
    str_builder_add_cstr(sb, "{\"id\":\"");
    _sb_json_escape(sb, uuid_format(entry_id(e)));
    str_builder_add_cstr(sb, "\",\"timestamp\":\"");
    _sb_json_escape(sb, entry_timestamp(e));
    str_builder_add_cstr(sb, "\",\"severity\":\"");
    str_builder_add_cstr(sb, severity_as_str(entry_severity(e)));
    str_builder_add_cstr(sb, "\",\"source\":\"");
    # 2.8.11 — source and action were written RAW. A '"' in either produced a
    # line the reader could not parse, so the entry was silently dropped on
    # reload (a false integrity violation at best, evidence loss at worst),
    # and a crafted value could inject its own "hash"/"prev_hash" keys.
    _sb_json_escape(sb, entry_source(e));
    str_builder_add_cstr(sb, "\",\"action\":\"");
    _sb_json_escape(sb, entry_action(e));
    str_builder_add_cstr(sb, "\",\"details\":\"");
    # Escape details JSON as a string value (avoids nested object parse issues)
    _sb_json_escape(sb, entry_details(e));
    str_builder_add_cstr(sb, "\",\"agent_id\":\"");
    var aid = entry_agent_id(e);
    if (aid != 0) {
        _sb_json_escape(sb, aid);
    }
    str_builder_add_cstr(sb, "\",\"prev_hash\":\"");
    _sb_json_escape(sb, entry_prev_hash(e));
    str_builder_add_cstr(sb, "\",\"hash\":\"");
    _sb_json_escape(sb, entry_hash(e));
    str_builder_add_cstr(sb, "\",\"hash_algorithm\":\"");
    _sb_json_escape(sb, entry_hash_algorithm(e));
    str_builder_add_cstr(sb, "\"}");
    return 0;
}

# ================================================================
# JSON deserialization — parse a JSON line back to AuditEntry
# ================================================================

# ================================================================
# Flat JSON record reader (2.8.11)
# ================================================================
#
# ⚠ WHY THIS EXISTS instead of bayan's json_parse.
#
# bayan's flat-pair API captures string values VERBATIM — escapes undecoded,
# by design (its own comment says so; the tagged-tree parser is the decoding
# one). libro therefore had to run a second pass, _filestore_unescape, and
# that pass handled only \" \\ and \n. A \t, \r, \b, \f or \uXXXX in any
# field came back still escaped, so the reloaded entry differed from the one
# written and failed verification.
#
# The writer had the matching hole: it emitted raw C0 bytes for everything
# except \n, which is invalid JSON per RFC 8259 §7 and, for a raw CR,
# truncates the record for any reader that strips line endings.
#
# On top of that the flat parser is permissive: it resynchronises through
# malformed input rather than rejecting it, which is how a record with no
# "timestamp" was accepted and stored a NULL Str.
#
# The record shape libro writes is fixed and flat, so a dedicated strict
# reader is a few dozen lines, decodes escapes inline (no second pass to fall
# out of sync with the writer), rejects malformed records outright, and keeps
# the integrity-critical path off a third-party parser's escape semantics.
#
# ⚠ Correction to an earlier draft of this comment, recorded because it was
# wrong in a way worth not repeating: it claimed bayan mis-parsed \" inside a
# string value on BOTH 1.4.2 and 1.5.2. That was measured against 1.4.2 twice
# — the pin under test had been reverted mid-session without being noticed.
# bayan 1.5.1 fixed exactly that defect (see its CHANGELOG), and 1.5.2, which
# cyrius 6.5.34 folds, is correct: it returns `{\"user\":\"bob\"}` verbatim and
# does not lose the following key. The quoted-details round-trip break was
# real for libro 2.8.10 as shipped, because 2.8.10 pinned 6.5.31 (bayan
# 1.4.2) — but it was a dep bug the toolchain bump fixes, not a libro bug,
# and nothing here is a workaround for it.
#
# Returns a vec of alternating [key, value, key, value, …] Strs with escapes
# decoded, or 0 if the line is not a well-formed flat string object.

fn _fsj_is_ws(c) {
    if (c == 32 || c == 9 || c == 10 || c == 13) { return 1; }
    return 0;
}

# Decode one JSON string starting at data[pos] (which must be '"').
# Returns (Str of raw decoded bytes, position after the closing quote),
# or (0, 0) if malformed.
#
# ⚠ 2.8.12 — this DELEGATES to json_str_decode in entry.cyr. It used to be a
# second, independent implementation of the same escape decoding, and the
# canonical hasher grew a third when 2.8.12 started normalizing strings. Three
# copies of one escape table is precisely how a writer and a reader drift
# apart — the defect class 2.8.11 spent a release repairing. One decoder,
# one escaper (_sb_json_escape / _cjh_emit_json_string share the same table).
#
# ⚠ 2.8.11 note kept: it used to hand the end position back through a
# file-scope global `_fsj_pos`, which is a return value in a process-wide
# slot — two threads parsing concurrently overwrote each other's position.
fn _fsj_read_string(data, pos, slen) {
    return json_str_decode(data, pos, slen);
}

# A bare JSON scalar (number / true / false / null), returned as its raw
# text. Entry records are all-strings, but chain_export's header line carries
# `"_libro_chain":1` and `"max_capacity":N` as numbers, so the reader has to
# take both. Strict: the token must be a plausible scalar and must end at a
# structural byte.
fn _fsj_read_scalar(data, pos, slen) {
    var start = pos;
    while (pos < slen) {
        var c = load8(data + pos) & 0xFF;
        if (c == 44 || c == 125 || c == 93 || _fsj_is_ws(c) == 1) {
            if (pos == start) { return (0, 0); }
            # ⚠ COPY, do not view. _fsj_read_string decodes into a fresh
            # buffer, so its Str outlives the line; a bare
            # str_new(data + start, …) here would be a VIEW into the caller's
            # line buffer, and the two readers returning different lifetimes
            # from the same call site is how a dangling Str gets written. No
            # current caller retains a scalar past the line — only the
            # chain_export header uses them, and it converts immediately —
            # but that is a property of today's callers, not of this function.
            # See CLAUDE.md: str_from/str_new wrap, they do not copy.
            var n = pos - start;
            var buf = alloc(n + 1);
            memcpy(buf, data + start, n);
            store8(buf + n, 0);
            return (str_new(buf, n), pos);
        }
        # Permitted scalar bytes: digits, sign, dot, exponent, and the
        # lowercase letters of true/false/null.
        if ((c >= 48 && c <= 57) || c == 45 || c == 43 || c == 46
          || (c >= 97 && c <= 122)) {
            pos += 1;
        } else {
            return (0, 0);
        }
    }
    return (0, 0);
}

# Value KINDS. 2.8.12 — the reader has to tell a quoted "null" from the bare
# JSON literal null, because they mean different things for agent_id and the
# old code could not distinguish them.
var FSJ_STRING = 1;
var FSJ_SCALAR = 2;

fn _fsj_read_value(data, pos, slen) {
    if (pos >= slen) { return (0, 0, 0); }
    if ((load8(data + pos) & 0xFF) == 34) {
        var sv, se = _fsj_read_string(data, pos, slen);
        return (sv, se, FSJ_STRING);
    }
    var cv, ce = _fsj_read_scalar(data, pos, slen);
    return (cv, ce, FSJ_SCALAR);
}

fn _fsj_skip_ws(data, pos, slen) {
    while (pos < slen && _fsj_is_ws(load8(data + pos) & 0xFF) == 1) { pos += 1; }
    return pos;
}

fn _fsj_parse_flat(line) {
    if (line == 0) { return 0; }
    var data = str_data(line);
    var slen = str_len(line);
    var pos = _fsj_skip_ws(data, 0, slen);
    if (pos >= slen || (load8(data + pos) & 0xFF) != 123) { return 0; }
    pos += 1;
    var out = vec_new();
    pos = _fsj_skip_ws(data, pos, slen);
    if (pos < slen && (load8(data + pos) & 0xFF) == 125) { return out; }
    var stop = 0;
    while (stop == 0) {
        pos = _fsj_skip_ws(data, pos, slen);
        var k, kend = _fsj_read_string(data, pos, slen);
        if (k == 0) { return 0; }
        pos = _fsj_skip_ws(data, kend, slen);
        if (pos >= slen || (load8(data + pos) & 0xFF) != 58) { return 0; }
        pos = _fsj_skip_ws(data, pos + 1, slen);
        var v, vend, vkind = _fsj_read_value(data, pos, slen);
        if (v == 0) { return 0; }
        pos = _fsj_skip_ws(data, vend, slen);
        vec_push(out, k);
        vec_push(out, v);
        vec_push(out, vkind);
        if (pos >= slen) { return 0; }
        var d = load8(data + pos) & 0xFF;
        if (d == 44) { pos += 1; }
        elif (d == 125) { pos += 1; stop = 1; }
        else { return 0; }
    }
    # 2.8.12 — REJECT a duplicated key.
    #
    # _fsj_lookup returns the FIRST match, so a record carrying two
    # "source" keys silently resolved to whichever came first. That turns any
    # field-injection bug elsewhere in the pipeline from "produces a corrupt
    # record" into "produces a record that reads as a DIFFERENT, plausible
    # one" — the escaping fixes above close the known injection paths, and
    # this closes the amplifier they fed.
    var a = 0;
    while (a + 2 < vec_len(out)) {
        var b = a + 3;
        while (b + 2 < vec_len(out)) {
            if (str_eq(vec_get(out, a), vec_get(out, b)) == 1) { return 0; }
            b += 3;
        }
        a += 3;
    }
    return out;
}

# Compare a parsed key Str against a literal cstr without materialising a Str
# for the literal. _filestore_parse_entry does ten lookups over a ten-pair
# list, so the naive `str_eq(k, str_from(key))` form built up to a hundred
# throwaway Strs per record.
fn _fsj_key_is(k, cstr) {
    var n = str_len(k);
    var d = str_data(k);
    var i = 0;
    while (i < n) {
        var c = load8(cstr + i) & 0xFF;
        if (c == 0) { return 0; }
        if ((load8(d + i) & 0xFF) != c) { return 0; }
        i += 1;
    }
    if ((load8(cstr + n) & 0xFF) != 0) { return 0; }
    return 1;
}

fn _fsj_lookup(pairs, key) {
    if (pairs == 0) { return 0; }
    var n = vec_len(pairs);
    var i = 0;
    while (i + 2 < n) {
        if (_fsj_key_is(vec_get(pairs, i), key) == 1) {
            return vec_get(pairs, i + 1);
        }
        i += 3;
    }
    return 0;
}

# FSJ_STRING or FSJ_SCALAR for `key`, or 0 if absent.
fn _fsj_lookup_kind(pairs, key) {
    if (pairs == 0) { return 0; }
    var n = vec_len(pairs);
    var i = 0;
    while (i + 2 < n) {
        if (_fsj_key_is(vec_get(pairs, i), key) == 1) {
            return vec_get(pairs, i + 2);
        }
        i += 3;
    }
    return 0;
}

fn _filestore_parse_entry(line) {
    # 2.8.11 — the pair list is a LOCAL. It used to be published to the
    # file-scope global `_fsp_pairs` and then read ten times through
    # _fsp_get(), so two threads parsing concurrently — or any re-entry —
    # assembled a single entry out of two different lines, producing a record
    # that never existed and a false integrity violation. Same class as the
    # 2.8.9 cross-thread prepared-statement crash, and filestore reads are a
    # supported shape from any thread.
    var pairs = _fsj_parse_flat(line);
    if (pairs == 0) { return 0; }
    if (vec_len(pairs) == 0) { return 0; }

    # Extract fields from JSON pairs
    var id_hex = _fsj_lookup(pairs, "id");
    var ts_str = _fsj_lookup(pairs, "timestamp");
    var sev_str = _fsj_lookup(pairs, "severity");
    var source = _fsj_lookup(pairs, "source");
    var action = _fsj_lookup(pairs, "action");
    var details = _fsj_lookup(pairs, "details");
    var agent_id = _fsj_lookup(pairs, "agent_id");
    var prev_hash = _fsj_lookup(pairs, "prev_hash");
    var hash = _fsj_lookup(pairs, "hash");
    var hash_alg = _fsj_lookup(pairs, "hash_algorithm");

    # 2.8.11 — timestamp and prev_hash were NOT checked, so an absent field
    # stored a NULL Str into e+16 / e+64. entry_compute_hash calls
    # str_data()/str_len() on both, so every verify, query and re-serialize of
    # that entry dereferenced address 0 and SIGSEGV'd the process. A record
    # arriving from a proof bundle or a hand-edited log is untrusted input, so
    # this was a remote crash in the verifier. Reject the record instead.
    if (source == 0 || action == 0 || hash == 0) { return 0; }
    if (ts_str == 0 || prev_hash == 0) { return 0; }

    # Build entry from raw fields (no hash recomputation)
    var e = fl_alloc(88);

    # Parse UUID from hex (8-4-4-4-12 format, strip dashes)
    _filestore_parse_uuid(e, id_hex);

    store64(e + 16, ts_str);
    store64(e + 24, _parse_severity(sev_str));
    store64(e + 32, source);
    store64(e + 40, action);
    if (details == 0 || str_len(details) == 0) {
        # 2.8.12 — preserve an EMPTY details instead of rewriting it to "{}".
        # The substitution changed the entry's details between write and
        # read, so every entry stored with an empty details failed
        # verification on reload — a false integrity violation on a log
        # nobody had touched.
        store64(e + 48, str_from(""));
    } else {
        # _fsj_read_string already decoded the escapes; the old
        # _filestore_unescape second pass is gone (it would double-decode).
        store64(e + 48, details);
    }
    if (agent_id != 0 && str_len(agent_id) > 0) {
        # 2.8.11 — this tested `len == 4 && first byte == 'n'`, so EVERY
        # four-character agent_id beginning with n — "node", "nine", "n123" —
        # was read back as absent. The entry then hashed with an empty
        # agent_id and reported a false integrity violation on a chain nobody
        # had touched. Now the whole literal must match.
        # ⚠ An agent genuinely named "null" is still read as absent; libro's
        # own writer emits "" for absent, so this arm exists only for foreign
        # producers.
        # ⚠ 2.8.12 — only the BARE JSON literal `null` means absent. A
        # QUOTED "null" is an agent whose name happens to be that word, and
        # libro's own writer emits agent_id as a quoted string using "" for
        # absent — so the previous string-compare made an agent literally
        # named "null" round-trip to absent through libro's own writer and
        # reader, hash with an empty agent_id, and report a false integrity
        # violation. (2.8.11 fixed the "any 4 chars starting with n" version
        # of this and left the exact-match version behind.)
        if (_fsj_lookup_kind(pairs, "agent_id") == FSJ_SCALAR
          && str_eq(agent_id, str_from("null")) == 1) {
            store64(e + 56, 0);
        } else {
            store64(e + 56, agent_id);
        }
    } else {
        store64(e + 56, 0);
    }
    store64(e + 64, prev_hash);
    store64(e + 72, hash);
    if (hash_alg != 0) {
        store64(e + 80, hash_alg);
    } else {
        store64(e + 80, str_from(HASH_ALGORITHM));
    }

    return e;
}

fn _parse_severity(s) {
    if (s == 0) { return SEV_INFO; }
    var d = str_data(s);
    var first = load8(d) & 0xFF;
    if (first == 68) { return SEV_DEBUG; }
    if (first == 87) { return SEV_WARNING; }
    if (first == 69) { return SEV_ERROR; }
    if (first == 67) { return SEV_CRITICAL; }
    if (first == 83) { return SEV_SECURITY; }
    return SEV_INFO;
}

# Unescape JSON string escapes (\", \\, \n)
fn _filestore_unescape(s) {
    var data = str_data(s);
    var slen = str_len(s);
    var out = alloc(slen + 1);
    var oi = 0;
    var i = 0;
    while (i < slen) {
        var c = load8(data + i) & 0xFF;
        if (c == 92 && i + 1 < slen) {
            var nc = load8(data + i + 1) & 0xFF;
            if (nc == 34) { store8(out + oi, 34); oi = oi + 1; i = i + 2; }
            if (nc == 92) { store8(out + oi, 92); oi = oi + 1; i = i + 2; }
            if (nc == 110) { store8(out + oi, 10); oi = oi + 1; i = i + 2; }
            if (nc != 34 && nc != 92 && nc != 110) {
                store8(out + oi, c); oi = oi + 1; i = i + 1;
            }
        } else {
            store8(out + oi, c);
            oi += 1;
            i += 1;
        }
    }
    store8(out + oi, 0);
    return str_new(out, oi);
}

fn _filestore_parse_uuid(buf, hex_str) {
    # 2.8.11 — zero the field UNCONDITIONALLY. This memset used to run only on
    # the hex_str == 0 path; every other path left whatever bytes fl_alloc(88)
    # handed back for however many of the 16 the id decoded short of. The 16
    # id bytes are the FIRST thing entry_compute_hash feeds, so a short or
    # empty "id" made the entry's hash depend on recycled freelist memory:
    # the same record parsed twice produced two different hashes. Reachable
    # from filestore_load_all, chain_import and proof JSON import.
    memset(buf, 0, 16);
    if (hex_str == 0) { return 0; }
    # UUID format: xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx (36 chars)
    # Strip dashes, decode 32 hex chars to 16 bytes
    var hd = str_data(hex_str);
    var hl = str_len(hex_str);
    var bi = 0;
    var hi = 0;
    while (hi < hl && bi < 16) {
        var c = load8(hd + hi) & 0xFF;
        if (c == 45) {
            hi += 1;
        } else {
            var high = _hex_nibble(c);
            hi += 1;
            if (hi < hl) {
                var low = _hex_nibble(load8(hd + hi) & 0xFF);
                store8(buf + bi, (high << 4) | low);
                bi += 1;
                hi += 1;
            }
        }
    }
    return 0;
}
