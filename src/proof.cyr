# proof.cyr — integrity proof bundle
# Combines signed tree head, Merkle proofs, consistency proofs,
# and anchoring into a single verifiable package.

# ================================================================
# SignedTreeHead — generated accessors:
#   sth_root, sth_tree_size, sth_timestamp,
#   sth_signature, sth_verifying_key, sth_algorithm
# ================================================================
#derive(accessors)
struct sth { root; tree_size; timestamp; signature; verifying_key; algorithm; }

fn sth_new(root, tree_size, sig, vk_hex, alg) {
    return sth_new_at(root, tree_size,
      timestamp_rfc3339(get_epoch_secs()), sig, vk_hex, alg);
}

# Construct with an EXPLICIT timestamp. 2.8.12 — the signature now covers the
# timestamp, so the value has to be fixed before signing rather than stamped
# inside the constructor. proof_from_json also needs it, to rebuild a head
# whose signature verifies against the timestamp it was signed with.
fn sth_new_at(root, tree_size, timestamp, sig, vk_hex, alg) {
    var s = fl_alloc(48);
    store64(s, root);
    store64(s + 8, tree_size);
    store64(s + 16, timestamp);
    store64(s + 24, sig);
    store64(s + 32, vk_hex);
    store64(s + 40, alg);
    return s;
}

# The digest a SignedTreeHead's signature is taken over.
#
# ⚠ 2.8.12 — BREAKING. Through 2.8.11 `sign_tree_head(sk, root)` signed the
# ROOT ALONE, so every other field of the head was unauthenticated:
#
#   * `timestamp` — never checked by any verifier, so a holder of a valid
#     proof could restate WHEN the head was attested and it still verified.
#     For a product whose whole claim is "this is what the log said, then",
#     an unauthenticated time is the wrong field to leave loose.
#   * `tree_size` — cross-checked against the rebuilt tree by
#     _proof_verify_common, so not forgeable in a full bundle verify, but it
#     rested on that one call site rather than on the signature.
#   * `algorithm` — informational; verification dispatches on the caller's
#     verifying key, not on this field.
#
# (`verifying_key` is deliberately NOT in the preimage: the verifier supplies
# its own trusted key to proof_verify_signed and the embedded copy is never
# consulted, so binding it would suggest a trust it does not carry.)
#
# Fields are length-prefixed, so no concatenation is ambiguous.
fn tree_head_digest(root, tree_size, timestamp, alg) {
    var h = hasher_new();
    hash_field(h, str_data(root), str_len(root));
    var szbuf[8];
    store64(&szbuf, tree_size);
    hasher_update(h, &szbuf, 8);
    hash_field(h, str_data(timestamp), str_len(timestamp));
    if (alg == 0) {
        hash_field(h, "", 0);
    } else {
        hash_field(h, str_data(alg), str_len(alg));
    }
    return hasher_finalize_hex(h);
}

# The digest for an already-constructed head.
fn sth_digest(sth) {
    return tree_head_digest(sth_root(sth), sth_tree_size(sth),
      sth_timestamp(sth), sth_algorithm(sth));
}

# ================================================================
# ProofVerification — generated accessors:
#   pv_tree_head_valid, pv_entries_valid, pv_tree_matches,
#   pv_inclusions_valid, pv_consistency_valid, pv_anchor_valid
# ================================================================
#derive(accessors)
struct pv { tree_head_valid; entries_valid; tree_matches; inclusions_valid; consistency_valid; anchor_valid; }

fn pv_new() {
    var p = fl_alloc(48);
    store64(p, 0);
    store64(p + 8, 0);
    store64(p + 16, 0);
    store64(p + 24, 0);
    store64(p + 32, -1);
    store64(p + 40, -1);
    return p;
}

fn pv_is_valid(p) {
    if (load64(p) != 1) { return 0; }
    if (load64(p + 8) != 1) { return 0; }
    if (load64(p + 16) != 1) { return 0; }
    if (load64(p + 24) != 1) { return 0; }
    var cv = load64(p + 32);
    if (cv != -1 && cv != 1) { return 0; }
    var av = load64(p + 40);
    if (av != -1 && av != 1) { return 0; }
    return 1;
}

# ================================================================
# IntegrityProof — generated accessors:
#   iproof_tree_head, iproof_consistency, iproof_inclusions,
#   iproof_entries, iproof_anchor, iproof_tree
# ================================================================
#derive(accessors)
struct iproof { tree_head; consistency; inclusions; entries; anchor; tree; }

# ================================================================
# ProofBuilder — fluent API for constructing proofs
# ================================================================

# Build unsigned proof from chain
fn proof_build_unsigned(chain) {
    sakshi_info("proof: build unsigned", 21);
    var entries = chain_entries(chain);
    var tree = merkle_build(entries);
    if (tree == 0) { return 0; }

    var root = merkle_tree_root(tree);
    var sth = sth_new(root, merkle_tree_leaf_count(tree), str_from(""), str_from(""), 0);

    var ip = fl_alloc(48);
    store64(ip, sth);
    store64(ip + 8, 0);
    store64(ip + 16, vec_new());
    store64(ip + 24, entries);
    store64(ip + 32, 0);
    store64(ip + 40, tree);
    return ip;
}

# Build signed proof from chain
fn proof_build_signed(chain, sk) {
    sakshi_info("proof: build signed", 19);
    var entries = chain_entries(chain);
    var tree = merkle_build(entries);
    if (tree == 0) { return 0; }

    var root = merkle_tree_root(tree);
    var vk_hex = signing_key_verifying_hex(sk);
    var alg_cstr = sig_alg_name(signing_key_algorithm(sk));
    var alg = str_new(alg_cstr, strlen(alg_cstr));
    var tree_size = merkle_tree_leaf_count(tree);
    # 2.8.12 — fix the timestamp first, sign the WHOLE head, then construct.
    var ts = timestamp_rfc3339(get_epoch_secs());
    var sig = sign_tree_head(sk, tree_head_digest(root, tree_size, ts, alg));
    var sth = sth_new_at(root, tree_size, ts, sig, vk_hex, alg);

    var ip = fl_alloc(48);
    store64(ip, sth);
    store64(ip + 8, 0);
    store64(ip + 16, vec_new());
    store64(ip + 24, entries);
    store64(ip + 32, 0);
    store64(ip + 40, tree);
    return ip;
}

# Add consistency proof from old_size
fn proof_with_consistency(ip, old_size) {
    var tree = load64(ip + 40);
    var cp = merkle_consistency_proof(tree, old_size);
    store64(ip + 8, cp);
    return ip;
}

# Add inclusion proof for entry at index
fn proof_with_inclusion(ip, index) {
    var tree = load64(ip + 40);
    var mp = merkle_inclusion_proof(tree, index);
    if (mp != 0) {
        vec_push(load64(ip + 16), mp);
    }
    return ip;
}

# Add all inclusion proofs
fn proof_with_all_inclusions(ip) {
    var tree = load64(ip + 40);
    var lc = merkle_tree_leaf_count(tree);
    var i = 0;
    while (i < lc) {
        proof_with_inclusion(ip, i);
        i += 1;
    }
    return ip;
}

# Attach anchor
fn proof_with_anchor(ip, anchor) {
    store64(ip + 32, anchor);
    return ip;
}

# ================================================================
# Verify unsigned proof
# ================================================================

fn proof_verify_unsigned(ip) {
    return _proof_verify_common(ip, 1);
}

# Verify signed proof
fn proof_verify_signed(ip, vk) {
    var sth = load64(ip);
    # 2.8.12 — verify against the digest of the WHOLE head, not the bare root.
    # See tree_head_digest for what changed and why.
    var th_valid = verify_tree_head(vk, sth_digest(sth), sth_signature(sth));
    return _proof_verify_common(ip, th_valid);
}

# Common verification logic
fn _proof_verify_common(ip, tree_head_valid) {
    var pv = pv_new();
    store64(pv, tree_head_valid);

    var entries = load64(ip + 24);
    var sth = load64(ip);

    # Verify entry chain integrity
    var err = verify_chain(entries, 0);
    if (err == 0) {
        store64(pv + 8, 1);
    }

    # Rebuild tree and check root matches
    var rebuilt = merkle_build(entries);
    if (rebuilt != 0) {
        var rebuilt_root = merkle_tree_root(rebuilt);
        var sth_root_val = sth_root(sth);
        if (constant_time_eq_str(rebuilt_root, sth_root_val) == 1) {
            if (merkle_tree_leaf_count(rebuilt) == sth_tree_size(sth)) {
                store64(pv + 16, 1);
            }
        }
    }

    # Verify all inclusion proofs AGAINST THE SIGNED HEAD'S ROOT.
    #
    # 2.8.11 — this loop used to call merkle_verify_proof(mp), which checks a
    # proof against the root carried inside that same proof. Nothing bound
    # that root to sth_root, so a bundle could carry inclusion proofs for a
    # completely different tree and still report inclusions_valid = 1. The
    # proof was verifying itself.
    var sth_root_expected = sth_root(sth);
    var inclusions = load64(ip + 16);
    var all_inc_valid = 1;
    var ni = vec_len(inclusions);
    var i = 0;
    while (i < ni) {
        var mp = vec_get(inclusions, i);
        if (merkle_verify_proof_against(mp, sth_root_expected) == 0) {
            all_inc_valid = 0;
        }
        i += 1;
    }
    store64(pv + 24, all_inc_valid);

    # Verify consistency proof if present — AGAINST THE SIGNED HEAD'S ROOT.
    # 2.8.12: this called merkle_verify_consistency(cp), which checks the
    # proof against the roots carried inside itself. See
    # merkle_verify_consistency_against.
    var cp = load64(ip + 8);
    if (cp != 0) {
        store64(pv + 32, merkle_verify_consistency_against(cp, sth_root_expected));
    }

    # Verify anchor if present — AND that it anchors THIS tree.
    # 2.8.12: this checked only anchor_verify_integrity, the anchor's own
    # self-hash. An anchor is a statement "tree root R held N entries at time
    # T"; a self-consistent anchor for a DIFFERENT tree passed unchallenged
    # and pv_is_valid reported ANCHOR_VALID. Same self-referential class as
    # the inclusion and consistency proofs.
    var anchor = load64(ip + 32);
    if (anchor != 0) {
        var a_ok = 0;
        if (anchor_verify_integrity(anchor) == 1) {
            a_ok = 1;
            if (constant_time_eq_str(anchor_merkle_root(anchor),
                sth_root_expected) == 0) {
                sakshi_error("proof: anchor is for a different tree", 36);
                a_ok = 0;
            }
            if (anchor_entry_count(anchor) != sth_tree_size(sth)) {
                sakshi_error("proof: anchor entry count disagrees with the head", 47);
                a_ok = 0;
            }
        }
        store64(pv + 40, a_ok);
    }

    return pv;
}
