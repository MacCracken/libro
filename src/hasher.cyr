# hasher.cyr — ChainHasher, length-prefixed hashing, Str wrappers
# Delegates crypto to sigil (SHA-256, hex, constant-time).
# Provides Str-returning wrappers for libro's internal API.

var HASH_ALGORITHM = "sha256";

# An empty Str, returned from a DELIBERATELY UNANNOTATED function.
#
# 2.8.11 — this exists to silence a diagnostic that cannot be satisfied any
# other way from libro's side, without hiding a real defect.
#
# `#derive(accessors)` emits a bare getter — a raw 64-bit load at the field's
# offset — with no declared return type (cyrius lex_pp.cyr
# PP_DERIVE_ACCESSORS_BODY). So at
# `var head = str_from(""); … head = entry_hash(e);` the compiler types `head`
# as Str from the initializer, then sees the accessor call return an
# undeclared value and warns "assigning non-pointer to typed pointer". The
# value IS a Str at runtime — every write to that slot comes from
# entry_compute_hash or a parsed Str — so all 21 sites were diagnostic noise
# on a clean build, which trains people to ignore the warning entirely.
#
# Initializing from an unannotated call leaves the local untyped, which is an
# honest description: these locals hold "a Str, or whatever a derive accessor
# hands back", and cyrius cannot express that today.
#
# ⚠ The real fix is upstream: `#derive(accessors)` should carry the field's
# declared type through to the generated getter. Filed — see
# docs/development/dependency-watch.md. When that lands, revert these sites to
# `str_from("")` and the diagnostic becomes load-bearing again.
fn libro_empty_str() { return str_from(""); }

# ================================================================
# ChainHasher — wraps a SHA-256 context
# ================================================================
# Layout (16 bytes):
#   +0  ctx        SHA-256 context pointer
#   +8  algorithm  C-string pointer

fn hasher_new() {
    var h = fl_alloc(16);
    store64(h, sha256_init());
    store64(h + 8, HASH_ALGORITHM);
    return h;
}

fn hasher_update(h, data, len) {
    sha256_update(load64(h), data, len);
    return 0;
}

fn hasher_finalize_hex(h) {
    var digest = alloc(32);
    sha256_finalize(load64(h), digest);
    return hex_encode_str(digest, 32);
}

# ================================================================
# Str wrappers for sigil's hex functions
# ================================================================
# sigil hex_encode returns C-string; libro uses Str (fat pointer).

fn hex_encode_str(bytes, len) {
    var cstr = hex_encode(bytes, len);
    return str_new(cstr, len * 2);
}

fn hex_decode_str(hex_s) {
    return hex_decode(str_data(hex_s), str_len(hex_s));
}

# ================================================================
# Str wrapper for sigil's constant-time comparison
# ================================================================

fn constant_time_eq_str(a, b) {
    return ct_eq_bytes_lens(str_data(a), str_len(a), str_data(b), str_len(b));
}

# ================================================================
# Length-prefixed field hashing
# ================================================================
# Feeds 8-byte little-endian u64 length, then the raw data.
# On x86_64, store64 is natively LE — matches Rust to_le_bytes().

# 2.8.11 — the length prefix is staged on the STACK, not in a process-global
# 8-byte buffer.
#
# The old `_hf_lebuf` global (an alloc(8)) was shared by every caller in the
# process.
# hash_field is called eight times per entry_compute_hash, and
# entry_compute_hash runs on whatever thread verifies — PatraStore reads from
# a worker thread are a supported shape since 2.8.9, and libro is consumed by
# servers (Agnostic). Two threads hashing concurrently interleave
# the length write with the other's 8-byte hasher_update of that buffer, so an
# entry gets hashed with another entry's field length and its digest comes out
# wrong — silently, as a false integrity violation, with no crash to point at.
# Same class as the 2.8.9 cross-thread prepared-statement crash.
#
# A stack slot is per-thread by construction and no slower.
fn hash_field(h, data, len) {
    var lebuf[8];
    store64(&lebuf, len);
    hasher_update(h, &lebuf, 8);
    if (len > 0) {
        hasher_update(h, data, len);
    }
    return 0;
}
