# signing.cyr — cryptographic signing for audit entries
# Uses HMAC-SHA256 keyed hashing (Ed25519 elliptic curve deferred).
# Same API surface as Rust version's EntrySigner/EntryVerifier traits.

# ================================================================
# Signature algorithm constants
# ================================================================

enum SigAlgorithm {
    SIG_HMAC_SHA256 = 0;
    SIG_ED25519 = 1;
    SIG_ML_DSA_65 = 2;
    SIG_ED25519_ML_DSA_65 = 3;
}

fn sig_algorithm_name(alg) {
    if (alg == SIG_HMAC_SHA256) { return "hmac-sha256"; }
    if (alg == SIG_ED25519) { return "ed25519"; }
    if (alg == SIG_ML_DSA_65) { return "ml-dsa-65"; }
    if (alg == SIG_ED25519_ML_DSA_65) { return "ed25519+ml-dsa-65"; }
    return "unknown";
}

# ================================================================
# SigningKey layout (40 bytes)
# ================================================================
#   +0   key_bytes    pointer to 32-byte secret key
#   +8   pub_bytes    pointer to 32-byte "public key" (SHA-256 of secret)
#   +16  algorithm    i64 SIG_* constant
#   +24  key_id       Str pointer (0 = none)
#   +32  zeroized     i64 (1 if key material has been cleared)

fn signing_key_generate() {
    var sk = fl_alloc(40);
    var key = alloc(32);
    # Read 32 random bytes from /dev/urandom
    var fd = file_open("/dev/urandom", 0, 0);
    file_read(fd, key, 32);
    file_close(fd);
    store64(sk, key);
    # Derive "public key" = SHA-256(secret_key)
    var pub_key = alloc(32);
    sha256(key, 32, pub_key);
    store64(sk + 8, pub_key);
    store64(sk + 16, SIG_HMAC_SHA256);
    store64(sk + 24, 0);
    store64(sk + 32, 0);
    return sk;
}

fn signing_key_from_bytes(bytes) {
    var sk = fl_alloc(40);
    var key = alloc(32);
    memcpy(key, bytes, 32);
    store64(sk, key);
    var pub_key = alloc(32);
    sha256(key, 32, pub_key);
    store64(sk + 8, pub_key);
    store64(sk + 16, SIG_HMAC_SHA256);
    store64(sk + 24, 0);
    store64(sk + 32, 0);
    return sk;
}

fn signing_key_bytes(sk) { return load64(sk); }
fn signing_key_pub_bytes(sk) { return load64(sk + 8); }
fn signing_key_algorithm(sk) { return load64(sk + 16); }

fn signing_key_set_key_id(sk, key_id) {
    store64(sk + 24, key_id);
    return sk;
}

fn signing_key_key_id(sk) { return load64(sk + 24); }

# Zeroize key material
fn signing_key_zeroize(sk) {
    if (load64(sk + 32) == 1) { return 0; }
    var key = load64(sk);
    memset(key, 0, 32);
    store64(sk + 32, 1);
    return 0;
}

# Get verifying (public) key as hex Str
fn signing_key_verifying_hex(sk) {
    return hex_encode(load64(sk + 8), 32);
}

# ================================================================
# VerifyingKey layout (16 bytes)
# ================================================================
#   +0  pub_bytes   pointer to 32-byte key
#   +8  algorithm   i64

fn verifying_key_from_bytes(bytes) {
    var vk = fl_alloc(16);
    var pub_key = alloc(32);
    memcpy(pub_key, bytes, 32);
    store64(vk, pub_key);
    store64(vk + 8, SIG_HMAC_SHA256);
    return vk;
}

fn verifying_key_from_signing(sk) {
    # For HMAC-SHA256, the verifier needs the secret key (symmetric)
    return verifying_key_from_bytes(load64(sk));
}

fn verifying_key_bytes(vk) { return load64(vk); }
fn verifying_key_algorithm(vk) { return load64(vk + 8); }

fn verifying_key_to_hex(vk) {
    return hex_encode(load64(vk), 32);
}

# ================================================================
# HMAC-SHA256 signing
# ================================================================
# sign(key, message) = SHA-256(key || message)
# This is a simplified HMAC. Full HMAC uses ipad/opad.

fn _hmac_sha256_sign(key_bytes, msg, msg_len) {
    var ctx = sha256_init();
    sha256_update(ctx, key_bytes, 32);
    sha256_update(ctx, msg, msg_len);
    var sig = alloc(32);
    sha256_finalize(ctx, sig);
    fl_free(ctx);
    return sig;
}

fn _hmac_sha256_verify(key_bytes, msg, msg_len, sig_bytes) {
    var expected = _hmac_sha256_sign(key_bytes, msg, msg_len);
    return constant_time_eq(expected, 32, sig_bytes, 32);
}

# ================================================================
# Sign bytes — returns raw signature buffer (32 bytes)
# ================================================================

fn sign_bytes(sk, msg, msg_len) {
    return _hmac_sha256_sign(load64(sk), msg, msg_len);
}

# Verify bytes — returns 1 if valid
fn verify_bytes(vk, msg, msg_len, sig_bytes) {
    # For HMAC-SHA256 verification, we need the secret key.
    # Since pub_key = SHA-256(secret_key), we can't reverse it.
    # Instead, the verifier must have been given the same key material.
    # In practice, this means verification uses the same key derivation.
    # This is a known limitation of symmetric signing — Ed25519 fixes this.
    #
    # For now, verify_bytes works only when the verifying key IS the
    # signing key's public bytes and the signature was made with HMAC.
    # We verify by checking the signature matches SHA-256(signing_key || msg).
    # But we don't have the signing key... so we store it in the vk.
    #
    # WORKAROUND: VerifyingKey for HMAC stores the secret key bytes.
    return _hmac_sha256_verify(load64(vk), msg, msg_len, sig_bytes);
}

# ================================================================
# EntrySignature layout (40 bytes)
# ================================================================
#   +0   entry_hash     Str pointer
#   +8   signature      Str pointer (hex-encoded)
#   +16  verifying_key  Str pointer (hex-encoded)
#   +24  key_id         Str pointer (0 = none)
#   +32  algorithm      Str pointer (0 = default)

fn entry_sig_new(entry_hash, signature, verifying_key, key_id, algorithm) {
    var es = fl_alloc(40);
    store64(es, entry_hash);
    store64(es + 8, signature);
    store64(es + 16, verifying_key);
    store64(es + 24, key_id);
    store64(es + 32, algorithm);
    return es;
}

fn entry_sig_hash(es) { return load64(es); }
fn entry_sig_signature(es) { return load64(es + 8); }
fn entry_sig_verifying_key(es) { return load64(es + 16); }
fn entry_sig_key_id(es) { return load64(es + 24); }
fn entry_sig_algorithm(es) { return load64(es + 32); }

# ================================================================
# Sign an entry — returns EntrySignature
# ================================================================

fn sign_entry(sk, e) {
    var ehash = entry_hash(e);
    var sig_raw = sign_bytes(sk, str_data(ehash), str_len(ehash));
    var sig_hex = hex_encode(sig_raw, 32);
    var vk_hex = signing_key_verifying_hex(sk);
    var kid = signing_key_key_id(sk);
    var alg = str_from(sig_algorithm_name(signing_key_algorithm(sk)));
    return entry_sig_new(ehash, sig_hex, vk_hex, kid, alg);
}

fn sign_entry_with_key_id(sk, e, key_id) {
    var es = sign_entry(sk, e);
    store64(es + 24, key_id);
    return es;
}

# ================================================================
# Verify entry signature
# ================================================================
# Returns 1 if valid, 0 if invalid.

fn verify_entry_signature(vk, e, es) {
    # Check entry hash matches
    var ehash = entry_hash(e);
    var sig_ehash = entry_sig_hash(es);
    if (constant_time_eq_str(ehash, sig_ehash) == 0) { return 0; }

    # Decode signature from hex
    var sig_hex = entry_sig_signature(es);
    var sig_bytes = hex_decode(sig_hex);

    # Verify
    return verify_bytes(vk, str_data(sig_ehash), str_len(sig_ehash), sig_bytes);
}

# ================================================================
# Sign tree head (for IntegrityProof)
# ================================================================

fn sign_tree_head(sk, root_hash) {
    var sig_raw = sign_bytes(sk, str_data(root_hash), str_len(root_hash));
    return hex_encode(sig_raw, 32);
}

fn verify_tree_head(vk, root_hash, sig_hex) {
    var sig_bytes = hex_decode(sig_hex);
    return verify_bytes(vk, str_data(root_hash), str_len(root_hash), sig_bytes);
}
