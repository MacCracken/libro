# error.cyr — libro error types
# Error codes and structured error objects for libro operations.

enum LibroErr {
    ERR_NONE = 0;
    ERR_INTEGRITY = 1;
    ERR_STORE = 2;
    ERR_IO = 3;
    ERR_JSON = 4;
    ERR_FIELD_TOO_LONG = 5;
    ERR_TIMESTAMP = 6;
    ERR_ANCHORING = 7;
    ERR_DER = 8;
}

# Error — generated accessors:
#   error_code, error_msg, error_field_name, error_index,
#   error_expected, error_actual (+ setters)
#derive(accessors)
struct error { code; msg; field_name; index; expected; actual; }

fn error_new(code, msg) {
    var e = fl_alloc(48);
    store64(e, code);
    store64(e + 8, msg);
    store64(e + 16, 0);
    store64(e + 24, 0);
    store64(e + 32, 0);
    store64(e + 40, 0);
    return e;
}

fn error_integrity(index, expected, actual) {
    var e = fl_alloc(48);
    store64(e, ERR_INTEGRITY);
    store64(e + 8, "integrity violation");
    store64(e + 16, 0);
    store64(e + 24, index);
    store64(e + 32, expected);
    store64(e + 40, actual);
    return e;
}

fn error_field(field, len, max_val) {
    var e = fl_alloc(48);
    store64(e, ERR_FIELD_TOO_LONG);
    store64(e + 8, "field too long");
    store64(e + 16, field);
    store64(e + 24, len);
    store64(e + 32, max_val);
    store64(e + 40, 0);
    return e;
}

