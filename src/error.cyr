# error.cyr — libro error types
# Error codes and structured error objects for libro operations.

enum LibroErr {
    LIBRO_ERR_NONE = 0;
    LIBRO_ERR_INTEGRITY = 1;
    LIBRO_ERR_STORE = 2;
    LIBRO_ERR_IO = 3;
    LIBRO_ERR_JSON = 4;
    LIBRO_ERR_FIELD_TOO_LONG = 5;
    LIBRO_ERR_TIMESTAMP = 6;
    LIBRO_ERR_ANCHORING = 7;
    LIBRO_ERR_DER = 8;
}

# Discriminator magic, 2.8.11. "LBROERR!" little-endian.
#
# ⚠ WHY THIS EXISTS. libro's pervasive convention is "return the value on
# success, an error struct pointer on failure". Both are non-zero pointers, so
# the natural `if (r != 0)` check reads a FAILURE as a success. That is not a
# theoretical hazard — every one of these shipped it:
#
#   patrastore_load_and_verify   entries vec  | error ptr
#   filestore_load_and_verify    entries vec  | error ptr
#   entry_new_validated          entry ptr    | error ptr (whose fields then
#                                              read as a max-severity entry)
#   memstore_verify_streamed     count        | error ptr
#
# For an integrity library, "an integrity violation is indistinguishable from
# success" is the worst available failure mode. Every error constructor now
# stamps this magic at offset 0 so libro_is_error() can answer the question,
# and the whole class becomes checkable rather than documented-around.
var LIBRO_ERR_MAGIC = 0x214C42524F455252;

# Error — generated accessors:
#   error_magic, error_code, error_msg, error_field_name, error_index,
#   error_expected, error_actual (+ setters)
#derive(accessors)
struct error { magic; code; msg; field_name; index; expected; actual; }

# Is `p` one of libro's error objects?
#
# Safe on any pointer to at least 8 readable bytes, which every libro struct
# and every stdlib vec satisfies. A false positive needs a non-error object
# whose first 8 bytes happen to equal the magic — for an entry that is the
# first half of a random UUID, i.e. 2^-64.
fn libro_is_error(p) {
    if (p == 0) { return 0; }
    # ⚠ 2.8.12 — REJECT non-pointers BEFORE dereferencing.
    #
    # 2.8.11 introduced this predicate and then documented it as the way to
    # check APIs that return "a count on success, an error pointer on
    # failure" — filestore_verify_streamed and memstore_verify_streamed both
    # do. So the documented usage,
    #     if (libro_is_error(filestore_verify_streamed(s, 10)) == 1) …
    # passed a SMALL INTEGER (the count of entries verified) to load64 and
    # segfaulted on a successful verify of a few entries. The predicate whose
    # job is to make a dangerous API safe was itself the crash.
    #
    # Measured on this platform: every libro struct comes from fl_alloc/alloc
    # in a mapped arena at ~1.4e14 and is 8-byte aligned. A count, an index,
    # a severity or an errno-style negative can be neither.
    if (p < 65536) { return 0; }
    if ((p & 7) != 0) { return 0; }
    if (load64(p) == LIBRO_ERR_MAGIC) { return 1; }
    return 0;
}

# Inverse helper reading the way call sites want to: "did this succeed?"
# "Did this succeed?" — the inverse, for pointer-returning APIs.
#
# ⚠ For count-returning APIs (filestore_verify_streamed,
# memstore_verify_streamed) use `libro_is_error(r) == 0` instead: a legitimate
# count of 0 is a SUCCESS, and libro_is_ok(0) is false by design because a null
# pointer is not a valid result for the APIs this is meant for.
fn libro_is_ok(p) {
    if (p == 0) { return 0; }
    if (libro_is_error(p) == 1) { return 0; }
    return 1;
}

fn error_new(code, msg) {
    var e = fl_alloc(56);
    store64(e, LIBRO_ERR_MAGIC);
    store64(e + 8, code);
    store64(e + 16, msg);
    store64(e + 24, 0);
    store64(e + 32, 0);
    store64(e + 40, 0);
    store64(e + 48, 0);
    return e;
}

fn error_integrity(index, expected, actual) {
    var e = fl_alloc(56);
    store64(e, LIBRO_ERR_MAGIC);
    store64(e + 8, LIBRO_ERR_INTEGRITY);
    store64(e + 16, "integrity violation");
    store64(e + 24, 0);
    store64(e + 32, index);
    store64(e + 40, expected);
    store64(e + 48, actual);
    return e;
}

fn error_field(field, len, max_val) {
    var e = fl_alloc(56);
    store64(e, LIBRO_ERR_MAGIC);
    store64(e + 8, LIBRO_ERR_FIELD_TOO_LONG);
    store64(e + 16, "field too long");
    store64(e + 24, field);
    store64(e + 32, len);
    store64(e + 40, max_val);
    store64(e + 48, 0);
    return e;
}
