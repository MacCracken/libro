# export.cyr — export audit entries as JSON Lines or CSV
# Writes to a file descriptor (fd).

# Append a single byte to a str_builder. Inlined variant of
# str_builder_add_cstr for the hot per-character path in escape loops —
# skips strlen + memcpy + the 2-byte scratch alloc that a cstr route
# would pay per character.
fn _sb_add_byte(sb, c) {
    _sb_grow(sb, 1);
    var buf = load64(sb);
    var len = load64(sb + 8);
    store8(buf + len, c);
    store64(sb + 8, len + 1);
    return 0;
}

# ================================================================
# JSON Lines export — one JSON object per line
# ================================================================

fn export_jsonl(entries, fd) {
    var n = vec_len(entries);
    var i = 0;
    while (i < n) {
        var e = vec_get(entries, i);
        _export_entry_json(e, fd);
        file_write(fd, "\n", 1);
        i += 1;
    }
    return 0;
}

# Write a single entry as a JSON object
fn _export_entry_json(e, fd) {
    var sb = str_builder_new();
    str_builder_add_cstr(sb, "{\"id\":\"");
    _sb_json_escape(sb, uuid_format(entry_id(e)));
    str_builder_add_cstr(sb, "\",\"timestamp\":\"");
    _sb_json_escape(sb, entry_timestamp(e));
    str_builder_add_cstr(sb, "\",\"severity\":\"");
    str_builder_add_cstr(sb, severity_as_str(entry_severity(e)));
    str_builder_add_cstr(sb, "\",\"source\":\"");
    _sb_json_escape(sb, entry_source(e));
    str_builder_add_cstr(sb, "\",\"action\":\"");
    _sb_json_escape(sb, entry_action(e));
    str_builder_add_cstr(sb, "\",\"details\":");
    # 2.8.11 — `details` is emitted as an escaped STRING, matching
    # _filestore_entry_json. It used to go out RAW into the JSON value
    # position: a details containing a newline split one entry across several
    # lines of the JSONL export, a details that was not valid JSON produced an
    # unparseable line, and attacker-controlled details could inject sibling
    # keys — its own "hash" or "prev_hash" — into the exported record.
    str_builder_add_cstr(sb, "\"");
    _sb_json_escape(sb, entry_details(e));
    str_builder_add_cstr(sb, "\"");
    str_builder_add_cstr(sb, ",\"agent_id\":");
    var aid = entry_agent_id(e);
    if (aid == 0) {
        str_builder_add_cstr(sb, "null");
    } else {
        str_builder_add_cstr(sb, "\"");
        _sb_json_escape(sb, aid);
        str_builder_add_cstr(sb, "\"");
    }
    str_builder_add_cstr(sb, ",\"prev_hash\":\"");
    _sb_json_escape(sb, entry_prev_hash(e));
    str_builder_add_cstr(sb, "\",\"hash\":\"");
    _sb_json_escape(sb, entry_hash(e));
    str_builder_add_cstr(sb, "\",\"hash_algorithm\":\"");
    _sb_json_escape(sb, entry_hash_algorithm(e));
    str_builder_add_cstr(sb, "\"}");

    var s = str_builder_build(sb);
    file_write(fd, str_data(s), str_len(s));
    return 0;
}

# Escape a Str for JSON (handle quotes and backslashes)
# Percent-encode the bytes that carry structural meaning in a delimited sink:
# the delimiter itself, the escape character, and every C0 byte (a newline
# forges a record, a NUL truncates one). Reversible and unambiguous, and it
# needs no agreement with a JSON escape table.
#
# 2.8.12 — used by the streaming topic builder and the kernel-audit line
# writer, both of which concatenated caller data into a delimited string with
# no escaping at all.
fn _sb_pct_encode(sb, s, delim) {
    if (s == 0) { return 0; }
    var d = str_data(s);
    var n = str_len(s);
    var i = 0;
    while (i < n) {
        var c = load8(d + i) & 0xFF;
        if (c == 37 || c == delim || c < 32) {
            _sb_add_byte(sb, 37);
            _sb_add_byte(sb, _sb_hex_nibble_char((c >> 4) & 0xF));
            _sb_add_byte(sb, _sb_hex_nibble_char(c & 0xF));
        } else {
            _sb_add_byte(sb, c);
        }
        i += 1;
    }
    return 0;
}

fn _sb_pct_encode_cstr(sb, cstr, delim) {
    if (cstr == 0) { return 0; }
    return _sb_pct_encode(sb, str_new(cstr, strlen(cstr)), delim);
}

fn _sb_hex_nibble_char(v) {
    if (v < 10) { return 48 + v; }
    return 87 + v;
}

# RFC 8259 §7 string escaping.
#
# 2.8.11 — this handled only '"', '\' and '\n'. Every other byte below 0x20
# went through VERBATIM, which is invalid JSON, and a raw 0x0A had already
# been special-cased precisely because it splits a JSONL record in half. A
# tab or a CR in `source`/`action`/`details` therefore produced a line no
# conformant reader accepts, and a CR specifically truncates the record for
# any reader that strips line endings. Now every C0 byte is escaped: the four
# remaining shorthands, and \u00XX for the rest.
fn _sb_json_escape(sb, s) {
    if (s == 0) { return 0; }
    var data = str_data(s);
    var slen = str_len(s);
    var i = 0;
    while (i < slen) {
        # Bulk-copy the run of bytes that need no escaping. 2.8.12 routed
        # EVERY entry field through here (2.8.11 escaped four of ten), and a
        # byte-at-a-time loop over a 64-char hex digest costs 64 builder calls
        # where one copy would do — measured as export_csv_100 +109% before
        # this. Hashes, timestamps and UUIDs contain nothing to escape, so the
        # run is normally the whole field.
        var run = i;
        var stop = 0;
        while (run < slen && stop == 0) {
            var rc = load8(data + run) & 0xFF;
            if (rc == 34 || rc == 92 || rc < 32) { stop = 1; }
            else { run += 1; }
        }
        if (run > i) {
            str_builder_add(sb, str_new(data + i, run - i));
            i = run;
        }
        if (i >= slen) { return 0; }

        var c = load8(data + i) & 0xFF;
        if (c == 34)      { str_builder_add_cstr(sb, "\\\""); }
        elif (c == 92)    { str_builder_add_cstr(sb, "\\\\"); }
        elif (c == 10)    { str_builder_add_cstr(sb, "\\n"); }
        elif (c == 13)    { str_builder_add_cstr(sb, "\\r"); }
        elif (c == 9)     { str_builder_add_cstr(sb, "\\t"); }
        elif (c == 8)     { str_builder_add_cstr(sb, "\\b"); }
        elif (c == 12)    { str_builder_add_cstr(sb, "\\f"); }
        else {
            str_builder_add_cstr(sb, "\\u00");
            _sb_add_byte(sb, _sb_hex_nibble_char((c >> 4) & 0xF));
            _sb_add_byte(sb, _sb_hex_nibble_char(c & 0xF));
        }
        i += 1;
    }
    return 0;
}

# ================================================================
# CSV export — header + one row per entry
# ================================================================

var _csv_header = "id,timestamp,severity,source,action,details,agent_id,prev_hash,hash\n";

fn export_csv(entries, fd) {
    file_write(fd, _csv_header, strlen(_csv_header));

    var n = vec_len(entries);
    var i = 0;
    while (i < n) {
        var e = vec_get(entries, i);
        _export_entry_csv(e, fd);
        i += 1;
    }
    return 0;
}

fn _export_entry_csv(e, fd) {
    var sb = str_builder_new();

    # id
    _sb_json_escape(sb, uuid_format(entry_id(e)));
    str_builder_add_cstr(sb, ",");

    # timestamp
    _sb_json_escape(sb, entry_timestamp(e));
    str_builder_add_cstr(sb, ",");

    # severity
    str_builder_add_cstr(sb, severity_as_str(entry_severity(e)));
    str_builder_add_cstr(sb, ",");

    # source (escaped)
    _sb_csv_field(sb, entry_source(e));
    str_builder_add_cstr(sb, ",");

    # action (escaped)
    _sb_csv_field(sb, entry_action(e));
    str_builder_add_cstr(sb, ",");

    # details (escaped)
    _sb_csv_field(sb, entry_details(e));
    str_builder_add_cstr(sb, ",");

    # agent_id (escaped, empty if none)
    var aid = entry_agent_id(e);
    if (aid == 0) {
        # empty field
    } else {
        _sb_csv_field(sb, aid);
    }
    str_builder_add_cstr(sb, ",");

    # prev_hash
    _sb_json_escape(sb, entry_prev_hash(e));
    str_builder_add_cstr(sb, ",");

    # hash
    _sb_json_escape(sb, entry_hash(e));
    str_builder_add_cstr(sb, "\n");

    var s = str_builder_build(sb);
    file_write(fd, str_data(s), str_len(s));
    return 0;
}

# CSV field escaping: wrap in quotes if field contains comma, quote, or newline.
# Double all internal quotes. Single scan to decide quoting; on the escape path,
# one pre-grown buffer + direct byte writes (no per-char fn calls).
fn _sb_csv_field(sb, s) {
    var data = str_data(s);
    var slen = str_len(s);

    var needs_quote = 0;
    var i = 0;
    while (i < slen) {
        var c = load8(data + i) & 0xFF;
        if (c == 44 || c == 34 || c == 10) { needs_quote = 1; i = slen; }
        i += 1;
    }

    if (needs_quote == 0) {
        str_builder_add(sb, s);
        return 0;
    }

    # Worst case: every byte is a quote → doubled. +2 for surrounding quotes.
    _sb_grow(sb, slen * 2 + 2);
    var buf = load64(sb);
    var out = load64(sb + 8);
    store8(buf + out, 34);
    out += 1;
    i = 0;
    while (i < slen) {
        var c = load8(data + i) & 0xFF;
        store8(buf + out, c);
        out += 1;
        if (c == 34) {
            store8(buf + out, 34);
            out += 1;
        }
        i += 1;
    }
    store8(buf + out, 34);
    out += 1;
    store64(sb + 8, out);
    return 0;
}
