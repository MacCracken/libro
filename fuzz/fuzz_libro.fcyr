# fuzz_libro.fcyr — fuzz harnesses for libro
# Feeds random/malformed data into parsers and verifiers.
# Catches crashes, not correctness (assert on no-crash).
#
# Run: cyrius build fuzz/fuzz_libro.fcyr build/fuzz_libro
#      ./build/fuzz_libro [iterations]

# ================================================================
# Standard library
# ================================================================
include "lib/assert.cyr"
include "lib/alloc.cyr"
include "lib/vec.cyr"
include "lib/str.cyr"
include "lib/syscalls.cyr"
include "lib/io.cyr"
include "lib/freelist.cyr"
include "lib/hashmap.cyr"
include "lib/json.cyr"
include "lib/sakshi.cyr"
include "lib/bigint.cyr"
include "lib/chrono.cyr"
include "lib/sigil.cyr"

# ================================================================
# Libro modules
# ================================================================
include "src/error.cyr"
include "src/hasher.cyr"
include "src/entry.cyr"
include "src/verify.cyr"
include "src/query.cyr"
include "src/retention.cyr"
include "src/chain.cyr"
include "src/store.cyr"
include "src/export.cyr"
include "src/review.cyr"
include "src/merkle.cyr"
include "src/signing.cyr"
include "src/anchoring.cyr"
include "src/timestamping.cyr"
include "src/proof.cyr"
include "src/kernel_audit.cyr"
include "src/file_store.cyr"
include "src/streaming.cyr"

# ================================================================
# Random data generation
# ================================================================

var _fuzz_buf = 0;
var _fuzz_fd = 0;

fn fuzz_init() {
    _fuzz_buf = alloc(4096);
    _fuzz_fd = file_open("/dev/urandom", 0, 0);
    return 0;
}

fn fuzz_bytes(len) {
    if (len > 4096) { len = 4096; }
    file_read(_fuzz_fd, _fuzz_buf, len);
    return _fuzz_buf;
}

fn fuzz_str(max_len) {
    var len = load8(fuzz_bytes(1)) & 0xFF;
    if (len > max_len) { len = max_len; }
    var data = fuzz_bytes(len);
    return str_new(data, len);
}

# ================================================================
# Fuzz: SHA-256 with random input
# ================================================================
# Should never crash regardless of input.

fn fuzz_sha256(iterations) {
    var digest = alloc(32);
    var i = 0;
    while (i < iterations) {
        var len = (load8(fuzz_bytes(1)) & 0xFF) + 1;
        var data = fuzz_bytes(len);
        sha256(data, len, digest);
        i = i + 1;
    }
    return 0;
}

# ================================================================
# Fuzz: hex decode with random/malformed input
# ================================================================
# Should handle odd lengths, non-hex chars gracefully.

fn fuzz_hex_decode(iterations) {
    var i = 0;
    while (i < iterations) {
        var s = fuzz_str(128);
        var slen = str_len(s);
        if (slen > 1) {
            # Make even length
            var elen = (slen / 2) * 2;
            hex_decode(str_data(s), elen);
        }
        i = i + 1;
    }
    return 0;
}

# ================================================================
# Fuzz: DER TLV parsing with random bytes
# ================================================================
# Should not crash on malformed DER input.

fn fuzz_der_parse(iterations) {
    var i = 0;
    while (i < iterations) {
        var len = (load8(fuzz_bytes(1)) & 0x3F) + 2;
        var data = fuzz_bytes(len);
        # Set first byte to SEQUENCE tag sometimes
        if ((load8(data) & 1) == 0) {
            store8(data, 0x30);
        }
        _der_parse_tlv(data, len);
        i = i + 1;
    }
    return 0;
}

# ================================================================
# Fuzz: entry creation with random fields
# ================================================================
# Should handle any string content without crash.

fn fuzz_entry_create(iterations) {
    var i = 0;
    var prev = str_from("");
    while (i < iterations) {
        var sev = load8(fuzz_bytes(1)) & 0x7;
        if (sev > 5) { sev = 0; }
        var src = fuzz_str(64);
        var act = fuzz_str(64);
        var det = str_from("{}");
        var e = entry_new(sev, src, act, det, prev);
        entry_verify(e);
        prev = entry_hash(e);
        i = i + 1;
    }
    return 0;
}

# ================================================================
# Fuzz: chain operations with random patterns
# ================================================================

fn fuzz_chain_ops(iterations) {
    var c = chain_new();
    var i = 0;
    while (i < iterations) {
        var op = load8(fuzz_bytes(1)) & 0x3;
        if (op == 0) {
            chain_append(c, SEV_INFO, fuzz_str(16),
                fuzz_str(16), str_from("{}"));
        }
        if (op == 1) {
            chain_verify(c);
        }
        if (op == 2) {
            if (chain_len(c) > 5) {
                chain_rotate(c);
            }
        }
        if (op == 3) {
            var q = query_new();
            query_source(q, fuzz_str(16));
            chain_query(c, q);
        }
        i = i + 1;
    }
    return 0;
}

# ================================================================
# Fuzz: signature verification with random data
# ================================================================
# Should reject garbage signatures without crashing.

fn fuzz_sig_verify(iterations) {
    var sk = signing_key_generate();
    var vk = verifying_key_from_signing(sk);
    var e = entry_new(SEV_INFO, str_from("s"),
        str_from("a"), str_from("{}"), str_from(""));
    var good_sig = sign_entry(sk, e);

    var i = 0;
    while (i < iterations) {
        # Create a fake signature with random bytes
        var fake_sig_data = fuzz_bytes(64);
        var fake_hex = hex_encode_str(fake_sig_data, 64);
        var fake = entry_sig_new(
            entry_hash(e), fake_hex,
            signing_key_verifying_hex(sk),
            0, str_from("ed25519"));
        # Should return 0 (invalid), not crash
        verify_entry_signature(vk, e, fake);
        i = i + 1;
    }
    return 0;
}

# ================================================================
# Fuzz: JSON parsing with random strings
# ================================================================

fn fuzz_json_parse(iterations) {
    var i = 0;
    while (i < iterations) {
        var s = fuzz_str(256);
        json_parse(s);
        i = i + 1;
    }
    return 0;
}

# ================================================================
# Fuzz: topic matching with random patterns
# ================================================================

fn fuzz_topic_match(iterations) {
    var s = stream_new();
    var i = 0;
    while (i < iterations) {
        var pat = fuzz_str(32);
        var pd = str_data(pat);
        # Null-terminate for C-string compat
        var cstr = alloc(str_len(pat) + 1);
        memcpy(cstr, pd, str_len(pat));
        store8(cstr + str_len(pat), 0);
        stream_subscribe(s, cstr);
        var e = entry_new(SEV_INFO, fuzz_str(8),
            fuzz_str(8), str_from("{}"), str_from(""));
        stream_publish(s, e);
        i = i + 1;
    }
    return 0;
}

# ================================================================
# Main — run all fuzz targets
# ================================================================

fn main() {
    alloc_init();
    fl_init();
    ed25519_init();
    fuzz_init();

    var iters = 1000;

    println("=== libro fuzz harnesses ===");

    println("  fuzz_sha256...");
    fuzz_sha256(iters);
    println("  OK");

    println("  fuzz_hex_decode...");
    fuzz_hex_decode(iters);
    println("  OK");

    println("  fuzz_der_parse...");
    fuzz_der_parse(iters);
    println("  OK");

    println("  fuzz_entry_create...");
    fuzz_entry_create(iters / 10);
    println("  OK");

    println("  fuzz_chain_ops...");
    fuzz_chain_ops(iters / 5);
    println("  OK");

    println("  fuzz_sig_verify...");
    fuzz_sig_verify(iters / 10);
    println("  OK");

    println("  fuzz_json_parse...");
    fuzz_json_parse(iters);
    println("  OK");

    println("  fuzz_topic_match...");
    fuzz_topic_match(iters / 5);
    println("  OK");

    println("");
    println("All fuzz harnesses passed (no crashes)");
    return 0;
}

var r = main();
syscall(60, r);
