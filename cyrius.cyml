[package]
name = "libro"
version = "${file:VERSION}"
description = "libro — cryptographic audit chain (tamper-proof SHA-256 hash-linked event logging and verification)"
license = "GPL-3.0-only"
language = "cyrius"
cyrius = "6.2.11"
repository = "https://github.com/MacCracken/libro"

[build]
entry = "src/main.cyr"
output = "libro"

# Library distribution. Order mirrors the include order in src/main.cyr —
# critical for Cyrius's single-pass forward-reference resolution.
# `cyrius distlib` reads this section to produce dist/libro.cyr.
# Kept under [lib] (not [build]) so benches and standalone repros under
# tests/ don't pull all 20 modules into their compilation unit via the
# manifest — they `include` explicitly.
[lib]
modules = [
    "src/error.cyr",
    "src/hasher.cyr",
    "src/entry.cyr",
    "src/verify.cyr",
    "src/query.cyr",
    "src/retention.cyr",
    "src/chain.cyr",
    "src/store.cyr",
    "src/export.cyr",
    "src/review.cyr",
    "src/merkle.cyr",
    "src/signing.cyr",
    "src/anchoring.cyr",
    "src/timestamping.cyr",
    "src/proof.cyr",
    "src/kernel_audit.cyr",
    "src/file_store.cyr",
    "src/chain_io.cyr",
    "src/patra_store.cyr",
    "src/streaming.cyr",
    "src/proof_json.cyr",
    # NOTE — src/tpm_anchor.cyr is intentionally NOT bundled here.
    # It's `include`d from main.cyr behind `#ifdef LIBRO_TPM` and
    # depends on agnosys's tpm_seal/tpm_unseal. cyrius distlib strips
    # #ifdef markers, so bundling it would force TPM symbols into the
    # default dist bundle. Consumers wanting TPM build from source
    # with `-D LIBRO_TPM` or vendor src/tpm_anchor.cyr directly.
]

# ── Dependencies ─────────────────────────────────────────────────
# Cyrius-stdlib modules copied into lib/ by `cyrius deps`. libro
# includes them directly via `include "lib/<name>.cyr"`; the list here
# mirrors the top of src/main.cyr so the manifest stays load-bearing.
[deps]
stdlib = [
    "assert",
    "alloc",
    "vec",
    "str",
    "string",
    "fmt",
    "syscalls",
    "io",
    "fs",
    "freelist",
    "hashmap",
    "bayan",
    "slice",
    "tagged",
    "process",
    "sakshi",
    "chrono",
    "ct",
    "keccak",
    "thread",
    "thread_local",
    "bench",
    "fnptr",
    "random",
    "test",
]

# External first-party deps. `cyrius deps` resolves these into lib/
# from the pinned tags. lib/ is gitignored — the contract is the tag
# pin here, not the bytes on disk.

[deps.sigil]
git = "https://github.com/MacCracken/sigil.git"
tag = "3.9.0"
modules = ["dist/sigil.cyr"]

[deps.patra]
git = "https://github.com/MacCracken/patra.git"
tag = "1.11.2"
modules = ["dist/patra.cyr"]

# [deps.agnosys] dropped at the agnosys → agnodrm decomposition (2026-06-19).
# libro's only agnosys surface was the TPM primitives (tpm_seal / tpm_unseal /
# tpm_detect) used by src/tpm_anchor.cyr; the agnosys → agnodrm decomposition
# moved the trust stack into sigil, which promoted it to first-class in
# dist/sigil.cyr at 3.9.0. So tpm now resolves from [deps.sigil] above (bumped
# 3.7.14 → 3.9.0) and the separate agnosys pin is gone. libro's tpm_anchor.cyr
# is unchanged — same symbol names, now sourced from sigil.
