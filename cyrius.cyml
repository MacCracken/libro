[package]
name = "libro"
version = "${file:VERSION}"
description = "libro — cryptographic audit chain (tamper-proof SHA-256 hash-linked event logging and verification)"
license = "GPL-3.0-only"
language = "cyrius"
cyrius = "6.4.62"
repository = "https://github.com/MacCracken/libro"

[build]
entry = "src/main.cyr"
output = "libro"

# Library distribution. Order mirrors the include order in src/main.cyr —
# critical for Cyrius's single-pass forward-reference resolution.
# `cyrius distlib` reads this section to produce dist/libro.cyr.
# Kept under [lib] (not [build]) so benches and standalone repros under
# tests/ don't pull all 20 modules into their compilation unit via the
# manifest — they `include` explicitly.
[lib]
modules = [
    "src/error.cyr",
    "src/hasher.cyr",
    "src/entry.cyr",
    "src/verify.cyr",
    "src/query.cyr",
    "src/retention.cyr",
    "src/chain.cyr",
    "src/store.cyr",
    "src/export.cyr",
    "src/review.cyr",
    "src/merkle.cyr",
    "src/signing.cyr",
    "src/anchoring.cyr",
    "src/timestamping.cyr",
    "src/proof.cyr",
    "src/kernel_audit.cyr",
    "src/file_store.cyr",
    "src/chain_io.cyr",
    "src/patra_store.cyr",
    "src/streaming.cyr",
    "src/proof_json.cyr",
    # NOTE — src/tpm_anchor.cyr is intentionally NOT bundled here.
    # It's `include`d from main.cyr behind `#ifdef LIBRO_TPM` and
    # depends on agnosys's tpm_seal/tpm_unseal. cyrius distlib strips
    # #ifdef markers, so bundling it would force TPM symbols into the
    # default dist bundle. Consumers wanting TPM build from source
    # with `-D LIBRO_TPM` or vendor src/tpm_anchor.cyr directly.
]

# ── Dependencies ─────────────────────────────────────────────────
# Cyrius-stdlib modules copied into lib/ by `cyrius deps`. libro
# includes them directly via `include "lib/<name>.cyr"`; the list here
# mirrors the top of src/main.cyr so the manifest stays load-bearing.
[deps]
stdlib = [
    "assert",
    "alloc",
    "vec",
    "str",
    "string",
    "fmt",
    "syscalls",
    "io",
    "fs",
    "freelist",
    "hashmap",
    "bayan",
    "slice",
    "tagged",
    "process",
    "sakshi",
    "chrono",
    "ct",
    "keccak",
    "thread",
    "thread_local",
    "atomic",
    "sync",
    "bench",
    "fnptr",
    "random",
    "test",
]

# External first-party deps. `cyrius deps` resolves these into lib/
# from the pinned tags. lib/ is gitignored — the contract is the tag
# pin here, not the bytes on disk.

# libro pulls a THIN sigil surface, not the monolithic dist/sigil.cyr. The full
# bundle inlines the x509/RSA/authenticode path, whose bignum tables carry a
# ~13 MB static (.bss) footprint that libro never uses — it balloons build/libro
# from ~1 MB to ~14 MB. libro's actual sigil surface is sha256 + ed25519 + ML-DSA
# (+ hybrid) + hex, so we resolve only the capability sub-bundles that cover it:
#   dist/sigil-mldsa.cyr — ed25519 + ML-DSA + hybrid + sha512 + crypto_scratch
#   src/sha_ni.cyr + src/sha256.cyr — SHA-256 (mldsa carries sha512, not sha256;
#       sha_ni precedes sha256 so sha256's #ifndef-guarded sha_ni include self-skips)
#   src/hex.cyr — standalone hex encode/decode (no bignum/x509 deps)
#   dist/sigil-tpm.cyr — only compiled into the -D LIBRO_TPM build (tpm_anchor.cyr)
# Result: build/libro .bss drops ~13 MB → ~75 KB. See CHANGELOG [2.8.0].
# Feature gating (cyrius ≥ 6.3.1 `optional` + `[features]`): the TPM trust
# surface is default-OFF. cyrius auto-includes every active [deps.*] module into
# the compilation unit, so sigil-tpm (only used by src/tpm_anchor.cyr behind
# -D LIBRO_TPM) must NOT sit in the always-on [deps.sigil] — it would land its
# code + tpm2 rodata in every default binary. Instead it's an OPTIONAL dep
# activated by the `tpm` feature (see [deps.sigil_tpm] + [features] below).
[features]
default = []
tpm = ["sigil_tpm"]

[deps.sigil]
git = "https://github.com/MacCracken/sigil.git"
path = "../sigil"
tag = "3.11.1"
modules = [
    "dist/sigil-mldsa.cyr",
    "src/sha_ni.cyr",
    "src/sha256.cyr",
    "src/hex.cyr",
]

# TPM trust API (tpm_seal / tpm_unseal / tpm_detect) — OPTIONAL, activated only
# by the `tpm` feature for the -D LIBRO_TPM build (src/tpm_anchor.cyr). Same
# sigil repo/tag; skipped entirely (no clone, no module copy, no auto-include)
# when the feature is off, so default builds stay thin and tpm-free.
[deps.sigil_tpm]
git = "https://github.com/MacCracken/sigil.git"
path = "../sigil"
tag = "3.11.1"
modules = ["dist/sigil-tpm.cyr"]
optional = true

[deps.patra]
git = "https://github.com/MacCracken/patra.git"
path = "../patra"
tag = "1.12.9"
modules = ["dist/patra.cyr"]

# [deps.agnosys] dropped at the agnosys → agnodrm decomposition (2026-06-19).
# libro's only agnosys surface was the TPM primitives (tpm_seal / tpm_unseal /
# tpm_detect) used by src/tpm_anchor.cyr; the agnosys → agnodrm decomposition
# moved the trust stack into sigil, which promoted it to first-class in
# dist/sigil.cyr at 3.9.0. So tpm now resolves from [deps.sigil] above (bumped
# 3.7.14 → 3.9.0) and the separate agnosys pin is gone. libro's tpm_anchor.cyr
# is unchanged — same symbol names, now sourced from sigil.
