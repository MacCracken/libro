[package]
name = "libro"
version = "${file:VERSION}"
description = "libro — cryptographic audit chain (tamper-proof SHA-256 hash-linked event logging and verification)"
license = "GPL-3.0-only"
language = "cyrius"
cyrius = "6.7.9"
repository = "https://github.com/MacCracken/libro"

[build]
entry = "src/main.cyr"
output = "libro"

# Modules `cyrius distlib` bundles into dist/libro.cyr. Order matches the
# include order in src/main.cyr (single-pass forward-reference resolution).
# Kept under [lib], not [build], so benches and tests/ repros that `include`
# explicitly do not pull every module through the manifest.
#
# src/tpm_anchor.cyr is deliberately absent: main.cyr includes it behind
# `#ifdef LIBRO_TPM`, and distlib strips #ifdef markers, so bundling it would
# force TPM symbols into the default bundle. TPM consumers build from source
# with `-D LIBRO_TPM` or vendor the file directly.
[lib]
modules = [
    "src/error.cyr",
    "src/hasher.cyr",
    "src/entry.cyr",
    "src/verify.cyr",
    "src/query.cyr",
    "src/retention.cyr",
    "src/chain.cyr",
    "src/store.cyr",
    "src/export.cyr",
    "src/review.cyr",
    "src/merkle.cyr",
    "src/signing.cyr",
    "src/anchoring.cyr",
    "src/timestamping.cyr",
    "src/proof.cyr",
    "src/kernel_audit.cyr",
    "src/file_store.cyr",
    "src/chain_io.cyr",
    "src/patra_store.cyr",
    "src/streaming.cyr",
    "src/proof_json.cyr",
]

# Stdlib modules `cyrius deps` copies into lib/. Mirrors the includes at the
# top of src/main.cyr plus what the benches, fuzz and tests/ harnesses include.
[deps]
stdlib = [
    "assert",
    "alloc",
    "vec",
    "str",
    "string",
    "fmt",
    "syscalls",
    "io",
    "fs",
    "freelist",
    "hashmap",
    "bayan",
    "slice",
    "tagged",
    "process",
    "sakshi",
    "chrono",
    "ct",
    "keccak",
    "thread",
    "thread_local",
    "atomic",
    "sync",
    "bench",
    "fnptr",
    "random",
    "test",
]

# No `path` line is committed on the git deps below: it is a per-machine dev
# override. A default resolve ignores it and builds the tag (printing a hint);
# `CYRIUS_LOCAL=<dep>` (or `=1`) builds the sibling checkout into
# build/local-deps/lib/ and leaves lib/ and cyrius.lock untouched. A
# sibling-free reproduction is the release gate: a tag that does not exist
# yet passes every local gate and fails CI.

# The TPM trust surface is default-off. Every active `deps.*` module is
# auto-included into every build, so sigil-tpm lives in an optional dep that
# only the `tpm` feature activates.
[features]
default = []
tpm = ["sigil_tpm"]

# Thin sigil surface, NOT the monolithic dist/sigil.cyr and NOT a `sigil`
# entry in `[deps].stdlib`. Both are the monolith, which inlines the x509 /
# RSA bignum banks: ~10 MB of static data libro never calls. Only the
# capability sub-bundles libro uses are listed:
#   dist/sigil-mldsa.cyr    ed25519 + ML-DSA + hybrid + sha512 + crypto_scratch
#   src/sha_ni.cyr          hardware SHA-256 dispatch (must precede sha256 so
#                           sha256's guarded sha_ni include self-skips)
#   src/sha256.cyr          SHA-256 (mldsa carries sha512, not sha256)
#   src/hex.cyr             standalone hex encode/decode
[deps.sigil]
git = "https://github.com/MacCracken/sigil.git"
tag = "3.13.12"
modules = [
    "dist/sigil-mldsa.cyr",
    "src/sha_ni.cyr",
    "src/sha256.cyr",
    "src/hex.cyr",
]

# TPM trust API (tpm_seal / tpm_unseal / tpm_detect) for src/tpm_anchor.cyr.
# Resolved and auto-included only under `--features tpm`. Same repo as
# `deps.sigil`; the two tags move in lockstep, or two versions of one library
# share a compilation unit and the last definition silently wins.
[deps.sigil_tpm]
git = "https://github.com/MacCracken/sigil.git"
tag = "3.13.12"
modules = ["dist/sigil-tpm.cyr"]
optional = true

# patra stays a git dep rather than a `[deps].stdlib` fold entry: bote
# consumes dist/libro.cyr (which calls patra_* and defines none of it) and
# declares no patra of its own, so it can only resolve patra transitively
# through this block.
[deps.patra]
git = "https://github.com/MacCracken/patra.git"
tag = "1.16.0"
modules = ["dist/patra.cyr"]
