# libro_core.bcyr — core crypto/chain/merkle/signing benchmarks.
# Split from libro.bcyr in 1.2.0: single-file bench exceeded cc5 5.4.2's
# 16384 fixup-table cap. Paired with libro_io.bcyr.
#
# Run: cyrius build benches/libro_core.bcyr build/libro_bench_core
#      ./build/libro_bench_core

include "lib/assert.cyr"
include "lib/alloc.cyr"
include "lib/freelist.cyr"
include "lib/str.cyr"
include "lib/string.cyr"
include "lib/vec.cyr"
include "lib/hashmap.cyr"
include "lib/syscalls.cyr"
include "lib/io.cyr"
include "lib/fs.cyr"
include "lib/fmt.cyr"
include "lib/bayan.cyr"
include "lib/fnptr.cyr"
include "lib/bench.cyr"
include "lib/sakshi.cyr"
include "lib/chrono.cyr"
include "lib/tagged.cyr"
include "lib/process.cyr"
include "lib/ct.cyr"
include "lib/keccak.cyr"
include "lib/thread.cyr"
# thread_local MUST precede sigil — sigil 3.6.0+ crypto_scratch banks
# per-thread arrays over TLS; omit it and the binary links but SIGILLs
# at first crypto use (exit 132). See CLAUDE.md BIG NOTE.
include "lib/thread_local.cyr"
include "lib/random.cyr"
# Thin sigil surface (mirrors src/main.cyr / cyrius.cyml [deps.sigil]) —
# not the monolithic lib/sigil.cyr (its x509/RSA path carries ~13 MB .bss).
include "lib/sigil-mldsa.cyr"
include "lib/sigil_sha_ni.cyr"
include "lib/sigil_sha256.cyr"
include "lib/sigil_hex.cyr"

include "src/error.cyr"
include "src/hasher.cyr"
include "src/entry.cyr"
include "src/verify.cyr"
include "src/query.cyr"
include "src/retention.cyr"
include "src/chain.cyr"
include "src/store.cyr"
include "src/merkle.cyr"
include "src/signing.cyr"
include "src/anchoring.cyr"
include "src/proof.cyr"

include "benches/bench_history.cyr"

var _b_chain = 0;
var _b_det = 0;
var _b_entries = 0;
var _b_tree = 0;
var _b_sk = 0;
var _b_vk = 0;
var _b_sig = 0;
var _b_sk_pq = 0;
var _b_vk_pq = 0;
var _b_sig_pq = 0;
var _b_sk_hy = 0;
var _b_vk_hy = 0;
var _b_sig_hy = 0;
var _b_pq_entry = 0;

fn bench_chain_append(ignored) {
    var c = chain_new();
    var i = 0;
    while (i < 100) {
        chain_append(c, SEV_INFO, str_from("bench-src"), str_from("bench-act"), _b_det);
        i += 1;
    }
    return 0;
}

fn bench_chain_verify(ignored) {
    verify_chain(_b_entries, 0);
    return 0;
}

var _b_batch_sev = 0;
var _b_batch_src = 0;
var _b_batch_act = 0;
var _b_batch_det = 0;

fn bench_chain_append_batch(ignored) {
    var c = chain_new();
    chain_append_batch(c, _b_batch_sev, _b_batch_src, _b_batch_act, _b_batch_det);
    return 0;
}

fn bench_entry_hash(ignored) {
    var e = vec_get(_b_entries, 0);
    entry_compute_hash(e);
    return 0;
}

fn bench_merkle_build(ignored) {
    merkle_build(_b_entries);
    return 0;
}

fn bench_merkle_proof(ignored) {
    merkle_inclusion_proof(_b_tree, 0);
    return 0;
}

fn bench_merkle_verify(ignored) {
    var mp = merkle_inclusion_proof(_b_tree, 0);
    merkle_verify_proof(mp);
    return 0;
}

fn bench_merkle_consistency(ignored) {
    merkle_consistency_proof(_b_tree, 50);
    return 0;
}

fn bench_sign_entry(ignored) {
    var e = vec_get(_b_entries, 0);
    sign_entry(_b_sk, e);
    return 0;
}

fn bench_verify_sig(ignored) {
    var e = vec_get(_b_entries, 0);
    verify_entry_signature(_b_vk, e, _b_sig);
    return 0;
}

# ML-DSA-65 signing path. Bench iteration counts are dropped to keep
# the total run time under the libro_core bench-binary budget.
#
# The ML-DSA and hybrid benches sign one fixed (key, message) pair,
# `_b_pq_entry` under keys rebuilt from a fixed seed in main(). sigil
# signs deterministically (FIPS 204, rnd = 0^32), and the rejection loop
# runs a number of attempts set by that pair alone. Over 200 random pairs
# it was 1 to 25 attempts, about 0.7 ms each, so a fresh random key and
# entry per run moved the average 2x between runs with no code change.
# The pinned pair takes 5 attempts; FIPS 204 expects 5.1 for ML-DSA-65.
fn bench_mldsa_sign_entry(ignored) {
    sign_entry(_b_sk_pq, _b_pq_entry);
    return 0;
}

fn bench_mldsa_verify_sig(ignored) {
    verify_entry_signature(_b_vk_pq, _b_pq_entry, _b_sig_pq);
    return 0;
}

# Hybrid signing path. Cost is roughly Ed25519 + ML-DSA-65 added
# (both primitives run, AND-mode); slightly higher than the sum
# because of the extra hex_encode + struct allocation overhead. Its
# ML-DSA slot shares the seed above, so it runs the same 5 attempts.
fn bench_hybrid_sign_entry(ignored) {
    sign_entry(_b_sk_hy, _b_pq_entry);
    return 0;
}

fn bench_hybrid_verify_sig(ignored) {
    verify_entry_signature(_b_vk_hy, _b_pq_entry, _b_sig_hy);
    return 0;
}

# Rebuild the ML-DSA-65 key material in `sk`'s slot (2 for hybrid) from
# `seed`, writing into the buffers the generator already sized.
fn _b_pin_mldsa(sk, seed, slot) {
    if (slot == 2) {
        mldsa65_keypair_from_seed(seed, signing_key_pub_bytes_2(sk), signing_key_bytes_2(sk));
        memcpy(signing_key_seed_2(sk), seed, 32);
        return 0;
    }
    mldsa65_keypair_from_seed(seed, signing_key_pub_bytes(sk), signing_key_bytes(sk));
    memcpy(signing_key_seed(sk), seed, 32);
    return 0;
}

fn bench_query_filter(ignored) {
    var q = query_new();
    query_source(q, str_from("bench-src"));
    query_min_severity(q, SEV_WARNING);
    query_apply(q, _b_entries);
    return 0;
}

fn bench_sha256_64b(ignored) {
    var msg = "abcdefghijklmnopqrstuvwxyz0123456789ABCDEFGHIJKLMNOPQRSTUVWXYZ!!";
    var digest = alloc(32);
    sha256(msg, 64, digest);
    return 0;
}

fn bench_proof_unsigned(ignored) {
    proof_build_unsigned(_b_chain);
    return 0;
}

fn bench_hex_encode(ignored) {
    var digest = alloc(32);
    sha256("benchdata", 9, digest);
    hex_encode(digest, 32);
    return 0;
}

fn main() {
    alloc_init();
    fl_init();
    ed25519_init();

    println("=== libro benchmarks — core ===");

    _b_det = str_from("{}");
    _b_chain = chain_new();
    var i = 0;
    while (i < 100) {
        chain_append(_b_chain, SEV_INFO, str_from("bench-src"), str_from("bench-act"), _b_det);
        i += 1;
    }
    _b_entries = chain_entries(_b_chain);
    _b_tree = merkle_build(_b_entries);
    _b_sk = signing_key_generate();
    _b_vk = verifying_key_from_signing(_b_sk);
    _b_sig = sign_entry(_b_sk, vec_get(_b_entries, 0));
    # Fixed (key, message) for the ML-DSA and hybrid benches — see
    # bench_mldsa_sign_entry.
    var pq_seed = alloc(32);
    memset(pq_seed, 7, 32);
    _b_pq_entry = entry_new(SEV_INFO, str_from("bench-src"), str_from("bench-act"), _b_det,
        entry_hash(vec_get(_b_entries, 0)));
    entry_set_hash(_b_pq_entry,
        str_from("0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef"));
    _b_sk_pq = signing_key_generate_mldsa();
    _b_pin_mldsa(_b_sk_pq, pq_seed, 1);
    _b_vk_pq = verifying_key_from_signing(_b_sk_pq);
    _b_sig_pq = sign_entry(_b_sk_pq, _b_pq_entry);
    _b_sk_hy = signing_key_generate_hybrid();
    _b_pin_mldsa(_b_sk_hy, pq_seed, 2);
    _b_vk_hy = verifying_key_from_signing(_b_sk_hy);
    _b_sig_hy = sign_entry(_b_sk_hy, _b_pq_entry);
    if (verify_entry_signature(_b_vk_pq, _b_pq_entry, _b_sig_pq) != 1
        || verify_entry_signature(_b_vk_hy, _b_pq_entry, _b_sig_hy) != 1) {
        println("bench setup: pinned ML-DSA key does not verify");
        return 1;
    }

    _b_batch_sev = vec_new();
    _b_batch_src = vec_new();
    _b_batch_act = vec_new();
    _b_batch_det = vec_new();
    i = 0;
    while (i < 100) {
        vec_push(_b_batch_sev, SEV_INFO);
        vec_push(_b_batch_src, str_from("bench-src"));
        vec_push(_b_batch_act, str_from("bench-act"));
        vec_push(_b_batch_det, _b_det);
        i += 1;
    }

    var benches = vec_new();

    var b1 = bench_new("sha256_64b");
    bench_run(b1, &bench_sha256_64b, 10000);
    vec_push(benches, b1);

    var b2 = bench_new("entry_hash");
    bench_run(b2, &bench_entry_hash, 1000);
    vec_push(benches, b2);

    var b3 = bench_new("chain_append_100");
    bench_run(b3, &bench_chain_append, 10);
    vec_push(benches, b3);

    var b3b = bench_new("chain_append_batch_100");
    bench_run(b3b, &bench_chain_append_batch, 10);
    vec_push(benches, b3b);

    var b4 = bench_new("chain_verify_100");
    bench_run(b4, &bench_chain_verify, 100);
    vec_push(benches, b4);

    var b5 = bench_new("merkle_build_100");
    bench_run(b5, &bench_merkle_build, 100);
    vec_push(benches, b5);

    var b6 = bench_new("merkle_proof");
    bench_run(b6, &bench_merkle_proof, 1000);
    vec_push(benches, b6);

    var b7 = bench_new("merkle_verify");
    bench_run(b7, &bench_merkle_verify, 1000);
    vec_push(benches, b7);

    var b8 = bench_new("merkle_consistency");
    bench_run(b8, &bench_merkle_consistency, 100);
    vec_push(benches, b8);

    var b9 = bench_new("sign_entry");
    bench_run(b9, &bench_sign_entry, 1000);
    vec_push(benches, b9);

    var b10 = bench_new("verify_sig");
    bench_run(b10, &bench_verify_sig, 1000);
    vec_push(benches, b10);

    # ML-DSA-65 (NIST FIPS 204) — iter counts kept low because per-op
    # cost is O(ms): about 6 ms sign (the pinned 5-attempt pair) and
    # 2 ms verify here. 100 iters keeps each bench under a second.
    var b10p = bench_new("mldsa65_sign_entry");
    bench_run(b10p, &bench_mldsa_sign_entry, 100);
    vec_push(benches, b10p);

    var b10v = bench_new("mldsa65_verify_sig");
    bench_run(b10v, &bench_mldsa_verify_sig, 100);
    vec_push(benches, b10v);

    var b10hs = bench_new("hybrid_sign_entry");
    bench_run(b10hs, &bench_hybrid_sign_entry, 100);
    vec_push(benches, b10hs);

    var b10hv = bench_new("hybrid_verify_sig");
    bench_run(b10hv, &bench_hybrid_verify_sig, 100);
    vec_push(benches, b10hv);

    var b11 = bench_new("query_filter_100");
    bench_run(b11, &bench_query_filter, 1000);
    vec_push(benches, b11);

    var b12 = bench_new("proof_unsigned_100");
    bench_run(b12, &bench_proof_unsigned, 10);
    vec_push(benches, b12);

    var b13 = bench_new("hex_encode_32b");
    bench_run(b13, &bench_hex_encode, 10000);
    vec_push(benches, b13);

    println("");
    bench_report_all(benches);
    bench_history_write("libro_core", benches);
    return 0;
}

var r = main();
sys_exit(r);
