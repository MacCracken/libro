# libro_proof.bcyr — proof-build benchmarks (unsigned + signed).
#
# Third bench binary. Adds dedicated coverage for the proof-building
# path, which was deferred in 2.0.2 because neither existing bench
# binary had headroom for the extra modules under cc5 5.4.2's 16384
# fixup-table cap.
#
# NOTE — the originally planned `proof_to_json_*_25` benches are
# NOT shipped here. Every attempt to measure `proof_to_json(ip)`
# inside a bench_run loop triggered what looks like stack corruption
# or a similar control-flow hijack: main() was observed to re-enter
# repeatedly (25+ Hz), emitting the banner over and over with no
# real progress. The same `proof_to_json` call works correctly in
# the test suite (test_proof_to_json_unsigned / _null_on_zero /
# _fields_present all pass in src/main.cyr, 350 tests green).
# Narrowed to a bench-context interaction with proof_json.cyr; root
# cause not yet isolated. Filed as a follow-up — see
# docs/development/roadmap.md "Open — unblocked".
#
# Run: cyrius build benches/libro_proof.bcyr build/libro_bench_proof
#      ./build/libro_bench_proof

include "lib/assert.cyr"
include "lib/alloc.cyr"
include "lib/vec.cyr"
include "lib/str.cyr"
include "lib/fmt.cyr"
include "lib/syscalls.cyr"
include "lib/io.cyr"
include "lib/freelist.cyr"
include "lib/hashmap.cyr"
include "lib/json.cyr"
include "lib/fnptr.cyr"
include "lib/bench.cyr"
include "lib/sakshi.cyr"
include "lib/bigint.cyr"
include "lib/chrono.cyr"
include "lib/sigil.cyr"

include "src/error.cyr"
include "src/hasher.cyr"
include "src/entry.cyr"
include "src/verify.cyr"
include "src/query.cyr"
include "src/retention.cyr"
include "src/chain.cyr"
include "src/merkle.cyr"
include "src/signing.cyr"
include "src/anchoring.cyr"
include "src/proof.cyr"

include "benches/bench_history.cyr"

var _b_chain = 0;
var _b_det = 0;
var _b_sk = 0;

fn bench_proof_build_unsigned(ignored) {
    var ip = proof_build_unsigned(_b_chain);
    proof_with_all_inclusions(ip);
    return 0;
}

fn bench_proof_build_signed(ignored) {
    var ip = proof_build_signed(_b_chain, _b_sk);
    proof_with_all_inclusions(ip);
    return 0;
}

fn main() {
    alloc_init();
    fl_init();
    ed25519_init();

    println("=== libro benchmarks — proof ===");

    _b_det = str_from("{}");
    _b_chain = chain_new();
    # 25 entries — smaller than libro_core's 100 because proof_with_all_inclusions
    # allocates a full merkle proof per entry via the bump allocator and the
    # benches below iterate that on every run. 25 entries × 3 iterations keeps
    # heap pressure bounded while still stressing the O(N log N) build path.
    var i = 0;
    while (i < 25) {
        chain_append(_b_chain, SEV_INFO, str_from("bench-src"),
            str_from("bench-act"), _b_det);
        i += 1;
    }
    _b_sk = signing_key_generate();

    var benches = vec_new();

    var b1 = bench_new("proof_build_unsigned_25");
    bench_run(b1, &bench_proof_build_unsigned, 3);
    vec_push(benches, b1);

    var b2 = bench_new("proof_build_signed_25");
    bench_run(b2, &bench_proof_build_signed, 3);
    vec_push(benches, b2);

    println("");
    bench_report_all(benches);
    bench_history_write("libro_proof", benches);
    return 0;
}

var r = main();
syscall(60, r);
