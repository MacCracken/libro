# libro_proof.bcyr — proof-path benchmarks (build unsigned/signed + to_json).
#
# Third bench binary. Adds dedicated coverage for the proof-building
# path, which was deferred in 2.0.2 because neither existing bench
# binary had headroom for the extra modules under cc5 5.4.2's 16384
# fixup-table cap.
#
# proof_to_json bench — RESOLVED, shipped in 2.7.2.
# For years a `proof_to_json(ip)` call inside a bench_run loop triggered a
# control-flow hijack here (the same call always passed in the test suite —
# test_proof_to_json_unsigned / _null_on_zero / _fields_present in
# src/main.cyr). Re-tested against each toolchain bump; gone as of cyrius
# 6.1.23. The bench now ships with proof_json.cyr (+ its store/export/
# file_store closure) included and runs clean.
#
# Re-test history:
# - 2.0.5 / cyrius 5.4.7 — main() re-enters ~25 Hz, banner spams.
# - 2.1.1 / cyrius 5.10.34 — SIGILL on first bench iteration after
#   proof_build + proof_to_json complete once. Different symptom,
#   same class of bug. Stack trace (no symbols, DCE build):
#     #0 0x4a8155 → #1 0x4ac1f4 → #2 0x4ac983 → #3 0x499805
#     #4 0x42199b → #5 0x4acb7e → #6 0x4b1bda
#   Bench addition was attempted in 2.1.1 development; reverted
#   pending root-cause work.
# - 2.7.2 / cyrius 6.1.23 — RESOLVED. proof_to_json benches cleanly
#   (no hijack, no SIGILL); bench shipped.
#
# Run: cyrius build benches/libro_proof.bcyr build/libro_bench_proof
#      ./build/libro_bench_proof

include "lib/assert.cyr"
include "lib/alloc.cyr"
include "lib/freelist.cyr"
include "lib/str.cyr"
include "lib/string.cyr"
include "lib/vec.cyr"
include "lib/hashmap.cyr"
include "lib/syscalls.cyr"
include "lib/io.cyr"
include "lib/fs.cyr"
include "lib/fmt.cyr"
include "lib/bayan.cyr"
include "lib/fnptr.cyr"
include "lib/bench.cyr"
include "lib/sakshi.cyr"
include "lib/chrono.cyr"
include "lib/tagged.cyr"
include "lib/process.cyr"
include "lib/ct.cyr"
include "lib/keccak.cyr"
include "lib/thread.cyr"
# thread_local MUST precede sigil — sigil 3.6.0+ crypto_scratch banks
# per-thread arrays over TLS; omit it and the binary links but SIGILLs
# at first crypto use (exit 132). See CLAUDE.md BIG NOTE.
include "lib/thread_local.cyr"
include "lib/agnosys.cyr"
include "lib/random.cyr"
include "lib/sigil.cyr"

include "src/error.cyr"
include "src/hasher.cyr"
include "src/entry.cyr"
include "src/verify.cyr"
include "src/query.cyr"
include "src/retention.cyr"
include "src/chain.cyr"
include "src/store.cyr"
include "src/export.cyr"
include "src/merkle.cyr"
include "src/signing.cyr"
include "src/anchoring.cyr"
include "src/proof.cyr"
include "src/file_store.cyr"
include "src/proof_json.cyr"

include "benches/bench_history.cyr"

var _b_chain = 0;
var _b_det = 0;
var _b_sk = 0;
var _b_ip = 0;

fn bench_proof_build_unsigned(ignored) {
    var ip = proof_build_unsigned(_b_chain);
    proof_with_all_inclusions(ip);
    return 0;
}

fn bench_proof_build_signed(ignored) {
    var ip = proof_build_signed(_b_chain, _b_sk);
    proof_with_all_inclusions(ip);
    return 0;
}

# Serialize a pre-built, fully-inclusioned proof to canonical JSON.
# _b_ip is built once in main() so the bench measures only proof_to_json.
fn bench_proof_to_json(ignored) {
    proof_to_json(_b_ip);
    return 0;
}

fn main() {
    alloc_init();
    fl_init();
    ed25519_init();

    println("=== libro benchmarks — proof ===");

    _b_det = str_from("{}");
    _b_chain = chain_new();
    # 25 entries — smaller than libro_core's 100 because proof_with_all_inclusions
    # allocates a full merkle proof per entry via the bump allocator and the
    # benches below iterate that on every run. 25 entries × 3 iterations keeps
    # heap pressure bounded while still stressing the O(N log N) build path.
    var i = 0;
    while (i < 25) {
        chain_append(_b_chain, SEV_INFO, str_from("bench-src"),
            str_from("bench-act"), _b_det);
        i += 1;
    }
    _b_sk = signing_key_generate();

    var benches = vec_new();

    var b1 = bench_new("proof_build_unsigned_25");
    bench_run(b1, &bench_proof_build_unsigned, 3);
    vec_push(benches, b1);

    var b2 = bench_new("proof_build_signed_25");
    bench_run(b2, &bench_proof_build_signed, 3);
    vec_push(benches, b2);

    # Build the proof once (unsigned + all inclusions), then bench only
    # the JSON serialization path.
    _b_ip = proof_build_unsigned(_b_chain);
    proof_with_all_inclusions(_b_ip);
    var b3 = bench_new("proof_to_json_25");
    bench_run(b3, &bench_proof_to_json, 3);
    vec_push(benches, b3);

    println("");
    bench_report_all(benches);
    bench_history_write("libro_proof", benches);
    return 0;
}

var r = main();
syscall(60, r);
