# patra.cyr — PatraStore isolated test suite
# Run separately from main suite. Some test patterns trigger a layout-dependent
# codegen bug (SIGSEGV) when combined — adding/removing functions shifts binary
# layout past a threshold that causes a specific jump to misfire.
# Core coverage here; full suite pending codegen investigation.

include "lib/assert.cyr"
include "lib/alloc.cyr"
include "lib/string.cyr"
include "lib/freelist.cyr"
include "lib/str.cyr"
include "lib/vec.cyr"
include "lib/hashmap.cyr"
include "lib/fmt.cyr"
include "lib/syscalls.cyr"
include "lib/io.cyr"
include "lib/fnptr.cyr"
include "lib/tagged.cyr"
include "lib/sakshi.cyr"
include "lib/chrono.cyr"
include "lib/bayan.cyr"
include "lib/thread_local.cyr"  # must precede sigil (crypto_scratch TLS) — else SIGILL
# Thin sigil surface (mirrors src/main.cyr / cyrius.cyml [deps.sigil]) —
# not the monolithic lib/sigil.cyr (its x509/RSA path carries ~13 MB .bss).
include "lib/sigil-mldsa.cyr"
include "lib/sigil_sha_ni.cyr"
include "lib/sigil_sha256.cyr"
include "lib/sigil_hex.cyr"
include "lib/patra.cyr"

include "src/error.cyr"
include "src/hasher.cyr"
include "src/entry.cyr"
include "src/verify.cyr"
include "src/query.cyr"
include "src/retention.cyr"
include "src/chain.cyr"
include "src/store.cyr"
include "src/export.cyr"
include "src/review.cyr"
include "src/merkle.cyr"
include "src/signing.cyr"
include "src/anchoring.cyr"
include "src/timestamping.cyr"
include "src/proof.cyr"
include "src/kernel_audit.cyr"
include "src/file_store.cyr"
include "src/patra_store.cyr"
include "src/streaming.cyr"

fn test_ps_open() {
    sys_unlink("/tmp/libro_test_ps.patra");
    var ps = patrastore_open(str_from("/tmp/libro_test_ps.patra"));
    assert(ps != 0, "ps open");
    assert(patrastore_is_empty(ps) == 1, "ps empty");
    patrastore_close(ps);
    sys_unlink("/tmp/libro_test_ps.patra");
}

fn test_ps_append() {
    sys_unlink("/tmp/libro_test_ps2.patra");
    var ps = patrastore_open(str_from("/tmp/libro_test_ps2.patra"));
    var det = str_from("{}");
    var e1 = entry_new(SEV_INFO, str_from("auth"), str_from("login"), det, str_from(""));
    patrastore_append(ps, e1);
    assert(patrastore_len(ps) == 1, "ps len 1");
    var e2 = entry_new(SEV_WARNING, str_from("audit"), str_from("read"), det, entry_hash(e1));
    patrastore_append(ps, e2);
    assert(patrastore_len(ps) == 2, "ps len 2");
    var loaded = patrastore_load_all(ps);
    assert(vec_len(loaded) == 2, "ps loaded 2");
    patrastore_close(ps);
    sys_unlink("/tmp/libro_test_ps2.patra");
}

# Regression: an entry whose service/action/detail fields contain single quotes
# must persist. The old raw string-interpolated patrastore_append built malformed
# SQL (PATRA_ERR_SYNTAX) and SILENTLY DROPPED such an entry — the argonaut P1
# corruption. The bound INSERT (patra prepared statement) stores every byte
# verbatim, so the record lands and the chain reloads intact.
fn test_ps_quote() {
    sys_unlink("/tmp/libro_test_psq.patra");
    var ps = patrastore_open(str_from("/tmp/libro_test_psq.patra"));
    var e = entry_new(SEV_INFO, str_from("it's-daemon"), str_from("re'start"),
                      str_from("detail 'quotes' + O'Brien; DROP TABLE audit_entries--"),
                      str_from(""));
    assert(patrastore_append(ps, e) == PATRA_OK, "ps append quoted ok");
    assert(patrastore_len(ps) == 1, "ps quoted len 1 (was dropped pre-fix)");
    var loaded = patrastore_load_all(ps);
    assert(vec_len(loaded) == 1, "ps quoted reloaded 1");
    patrastore_close(ps);
    sys_unlink("/tmp/libro_test_psq.patra");
}

fn main() {
    alloc_init();
    fl_init();
    ed25519_init();
    patra_init();

    test_group("PatraStore");
    test_ps_open();
    test_ps_append();
    test_ps_quote();

    return assert_summary();
}

var exit_code = main();
syscall(60, exit_code);
