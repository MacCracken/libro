# patra_uninit.cyr — a process that never calls patra_init() (2.10.8)
#
# Through 2.10.7 `patrastore_open` here died with SIGSEGV inside `patra_open`,
# printing nothing past its "patrastore: open" trace line: the page slab reads
# a thread-local slot with no TLS block installed, and the page-cache registry
# locks a mutex only patra_init creates. The suite cannot reproduce that,
# because its main() runs patra_init first. This repro skips patra_init on
# purpose, so it is the real case.
#
# Expected: open returns 0, a store call on the 0 handle returns an error
# rather than faulting, "patra_uninit: OK" is printed, exit 0.
#
# Build and run (CI does this):
#   CYRIUS_DCE=1 cyrius build tests/patra_uninit.cyr build/patra_uninit
#   ./build/patra_uninit

include "lib/assert.cyr"
include "lib/alloc.cyr"
include "lib/vec.cyr"
include "lib/str.cyr"
include "lib/syscalls.cyr"
include "lib/io.cyr"
include "lib/freelist.cyr"
include "lib/hashmap.cyr"
include "lib/bayan.cyr"
include "lib/sakshi.cyr"
include "lib/chrono.cyr"
include "lib/thread_local.cyr"  # must precede sigil (crypto_scratch TLS) — else SIGILL
# Thin sigil surface (mirrors src/main.cyr / cyrius.cyml deps.sigil).
include "lib/sigil-mldsa.cyr"
include "lib/sigil_sha_ni.cyr"
include "lib/sigil_sha256.cyr"
include "lib/sigil_hex.cyr"
include "lib/patra.cyr"

include "src/error.cyr"
include "src/hasher.cyr"
include "src/entry.cyr"
include "src/verify.cyr"
include "src/query.cyr"
include "src/retention.cyr"
include "src/chain.cyr"
include "src/store.cyr"
include "src/export.cyr"
include "src/review.cyr"
include "src/merkle.cyr"
include "src/signing.cyr"
include "src/anchoring.cyr"
include "src/timestamping.cyr"
include "src/proof.cyr"
include "src/kernel_audit.cyr"
include "src/file_store.cyr"
include "src/patra_store.cyr"

fn main() {
    alloc_init();
    fl_init();
    # No patra_init() — that is the point.

    var p = "/tmp/libro_patra_uninit.patra";
    sys_unlink(p);
    var ps = patrastore_open(str_from(p));
    if (ps != 0) {
        println("patra_uninit: FAIL — open without patra_init returned a handle");
        return 1;
    }
    if (file_exists(p) != 0) {
        println("patra_uninit: FAIL — the refused open still created the file");
        sys_unlink(p);
        return 1;
    }
    if (patrastore_len(ps) != 0) {
        println("patra_uninit: FAIL — len on the 0 handle");
        return 1;
    }
    println("patra_uninit: OK");
    return 0;
}

var r = main();
sys_exit(r);
